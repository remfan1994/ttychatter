.TH TTYCHATTER.PYTHON 1 "November 2026" "ttychatter.python 3.19-web-limits" "User Commands"
.SH NAME
ttychatter.python \- Bash plus Python helper OpenRouter terminal chat client
.SH SYNOPSIS
.B ttychatter.python
.RI [ options ]
.br
.B ttychatter.python
.RI input.txt
.br
.B ttychatter.python
.RI input.txt
output.log
.br
.B ttychatter.python
.BR --prompt " TEXT"
.RB [ --output
.IR FILE ]
.br
.B ttychatter.python
.BR --input " FILE"
.RB [ --output
.IR FILE ]
.br
.B ttychatter.python
.BR --rename-session " SESSION TITLE"
.br
.B ttychatter.python
.BR --turns " SESSION"
.br
.B ttychatter.python
.BR --branch " SESSION TURN"
.br
.B ttychatter.python
.BR --edit-turn " SESSION TURN"
.br
