# ------------------------------------------------------------
# MAINTAINER COMMENTARY: class AICursesApp
# Main ncurses application object. It owns UI state, transcript state, input state, and
# navigation. Keep external API/config/storage helpers outside when possible so the future C
# implementation can mirror the architecture.
# ------------------------------------------------------------

def ensure_session_id(path: Path) -> str:
    """Read or append an opaque ID while holding the session's advisory lock."""
    path.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_RDWR | os.O_CREAT | getattr(os, 'O_NOFOLLOW', 0)
    with os.fdopen(os.open(path, flags, 0o600), 'r+', encoding='utf-8', errors='replace') as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        text = fh.read()
        match = re.search(r'^\[\d\d:\d\d:\d\d\] system: session-id: ([a-f0-9]{32})$', text, re.M)
        if match:
            return match.group(1)
        identifier = uuid.uuid4().hex
        if not text:
            fh.write(PRECHAT_LINE + '\n')
        elif not text.endswith('\n'):
            fh.write('\n')
        fh.write(f'[{now_time()}] system: session-id: {identifier}\n')
        fh.flush()
        return identifier


def rename_session_file(path: Path, title: str) -> Path:
    """Keep identity and contents; reserve a new filename without clobbering."""
    title = clean_session_title(title)
    if not title:
        raise ValueError('Session name cannot be empty.')
    if path.is_symlink() or not path.is_file():
        raise ValueError('Session must be a regular log file, not a symbolic link.')
    identifier = ensure_session_id(path)
    previous_title = session_title_from_file(path)
    aliases = [path.stem]
    if previous_title and previous_title not in {title, path.stem}:
        aliases.append(previous_title)
    def update_title(target: Path) -> None:
        write_session_title_metadata(target, title)
        for alias in aliases:
            append_log(target, 'system', 'session-alias: ' + alias, now_time())
    stem = sanitize_session_name(title)[:80].rstrip('._-') or 'session'
    stem += '--' + identifier[:12]
    for index in range(10000):
        tail = f'-{index:03d}' if index else ''
        target = path.with_name(stem + tail + '.log')
        if target == path:
            update_title(path)
            return path
        try:
            os.link(path, target, follow_symlinks=False)
        except FileExistsError:
            continue
        try:
            update_title(target)
            path.unlink()
        except Exception:
            target.unlink()
            raise
        return target
    raise OSError('Too many colliding session filenames.')


def terminal_cell_width(char: str) -> int:
    if unicodedata.combining(char):
        return 0
    return 2 if unicodedata.east_asian_width(char) in {'W', 'F'} else 1


def clip_terminal_text(text: str, width: int) -> str:
    result = []
    used = 0
    for char in text.expandtabs(4):
        if ord(char) < 32 or ord(char) == 127:
            char = ' '
        cells = terminal_cell_width(char)
        if used + cells > width:
            break
        result.append(char)
        used += cells
    return ''.join(result)


def openrouter_payload(cfg: Config, model_id: str, prompt_text: str,
                       attachments: List[PendingAttachment], stream: bool = False) -> dict:
    payload = {'model': normalize_model_id(model_id),
               'messages': [{'role': 'user', 'content': build_openrouter_user_content(
                   prompt_text, attachments, cfg.max_attachment_bytes)}]}
    if cfg.request_session_id:
        payload['session_id'] = cfg.request_session_id
    if stream:
        payload['stream'] = True
        payload['stream_options'] = {'include_usage': True}
    if cfg.web_search:
        if cfg.web_search_mode == 'plugin':
            plugin = {'id': 'web'}
            if cfg.web_search_max_results > 0:
                plugin['max_results'] = min(25, cfg.web_search_max_results)
            payload['plugins'] = [plugin]
        else:
            params = {'engine': cfg.web_search_engine}
            if cfg.web_search_max_results > 0:
                maximum = 20 if cfg.web_search_engine == 'perplexity' else 25
                params['max_results'] = min(maximum, cfg.web_search_max_results)
            payload['tools'] = [{'type': 'openrouter:web_search', 'parameters': params}]
            # OpenRouter documents max_tool_calls as the server-tool search budget.
            # Zero means ttychatter deliberately omits the cap rather than sending 0.
            if cfg.web_search_max_uses > 0:
                payload['max_tool_calls'] = min(25, cfg.web_search_max_uses)
    return payload


def response_metadata(obj: dict, metadata: dict) -> Optional[str]:
    """Collect provider metadata without treating API errors as assistant text."""
    if not isinstance(obj, dict):
        return 'OpenRouter response was not an object.'
    for key in ('id', 'model', 'provider', 'usage'):
        if obj.get(key) is not None:
            metadata[key] = obj[key]
    containers = [obj]
    choices = obj.get('choices') or []
    for choice in choices:
        if not isinstance(choice, dict):
            continue
        if choice.get('finish_reason'):
            metadata['finish_reason'] = choice['finish_reason']
        containers.append(choice)
        for key in ('message', 'delta'):
            if isinstance(choice.get(key), dict):
                containers.append(choice[key])
    error = None
    for container in containers:
        if container.get('error'):
            detail = container['error']
            if isinstance(detail, dict):
                error = str(detail.get('message') or detail.get('code') or detail)
                metadata['error'] = detail
            else:
                error = str(detail)
                metadata['error'] = error
        for key in ('annotations', 'reasoning_details'):
            values = container.get(key)
            if isinstance(values, list):
                saved = metadata.setdefault(key, [])
                for value in values:
                    if value not in saved:
                        saved.append(value)
    return error


def citation_text(metadata: dict) -> str:
    rows = []
    seen = set()
    for item in metadata.get('annotations', []) or []:
        if not isinstance(item, dict) or item.get('type') != 'url_citation':
            continue
        citation = item.get('url_citation') or item
        if not isinstance(citation, dict):
            continue
        url = str(citation.get('url') or '').strip()
        if any(ord(char) < 32 for char in url):
            continue
        try:
            parsed = urllib.parse.urlsplit(url)
        except ValueError:
            continue
        if parsed.scheme not in {'http', 'https'} or not parsed.netloc or url in seen:
            continue
        seen.add(url)
        title = clean_session_title(str(citation.get('title') or url))
        rows.append(f'[{len(rows)+1}] {title}\n    {url}')
    return '\n\nSources:\n' + '\n'.join(rows) if rows else ''


class ScreenNavigation(Exception):
    def __init__(self, action: str):
        self.action = action


class AICursesApp:
    TRANSCRIPT_REPLAY_LIMIT = 80

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def __init__
    # Maintainer note for __init__: this routine is part of the long-term public behavior of the
    # program. When changing it, check callers, documentation, config compatibility, session-log
    # compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def __init__(self, cfg: Config, session_name: str, session_path: Path):
        self.cfg = cfg
        self.session_name = session_name
        self.session_path = session_path
        self.session_title = session_title_from_file(session_path)
        self.input_visible = True
        self._dispatching = False
        self._active_screen = None
        self._cursor_screen = None
        self._named_after_reply = False
        self._session_drafts = {}
        self.last_reply = ''
        self.attachment_dir = cfg.effective_attachment_dir
        self.username = os.environ.get("USER") or os.environ.get("LOGNAME") or "user"

        self.context_buffer: List[str] = []
        self.transcript: List[TranscriptItem] = []
        self.transcript_scroll = 0
        self.pending_attachments: List[PendingAttachment] = []

        # Model-selector filters use metadata from the model list, not probe
        # requests. They are initialized from config, then can be adjusted in
        # the F2 model-filter menu for the current run.
        self.model_filter = ModelFilter(
            require_token_limits=cfg.model_filter_require_tokens,
            hide_preview_or_experimental=cfg.model_filter_hide_preview,
            min_input_tokens=cfg.model_min_input_tokens,
            min_output_tokens=cfg.model_min_output_tokens,
            sort_mode=cfg.model_sort_order if cfg.model_sort_order in {"api", "model", "input-desc", "output-desc"} else "api",
        )

        self.input_lines: List[str] = [""]
        self.cursor_row = 0
        self.cursor_col = 0
        self.input_scroll = 0

        self.layout: dict[str, int] = {}
        self.last_input_segments: List[InputSegment] = []
        self.command_hotspots: List[Tuple[int, int, int, str]] = []
        self.command_click_targets: List[Tuple[int, int, int, str]] = []

        self.status = self.default_status()
        self.should_quit = False
        self.startup_notice_active = False
        self.first_user_message_sent = False
        self._request_active = False
        self._request_thread = None
        self._request_events = queue.Queue()
        self._request_cancel = threading.Event()
        self._request_state = None

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def default_status
    # Maintainer note for default_status: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def default_status(self) -> str:
        return 'Ready'

    def send_key_label(self) -> str:
        """Return the user-facing label for the configured send action.

        SEND_INPUT is a config value, so the UI must not hard-code "Enter" or
        "Ctrl+G" in visible instructions.  Users who deliberately select
        Ctrl+G should see Ctrl+G; users who select Enter should see Enter.  This
        helper exists so the header, command bar, hotkey bar, placeholder text,
        help pages, and future ports use one vocabulary.
        """
        value = (self.cfg.send_input or "enter").lower()
        if value == "ctrl_g":
            return "Ctrl+G"
        if value == "ctrl_enter":
            return "Ctrl+Enter"
        return "Enter"

    # ------------------------------------------------------------------
    # Context memory
    # ------------------------------------------------------------------

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def load_session_into_ui
    # Maintainer note for load_session_into_ui: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def load_session_into_ui(self) -> None:
        entries = load_log_entries(self.session_path)
        visible = [entry for entry in entries if not (entry.speaker == 'system' and
            entry.text.startswith(('session-id:', 'session-title:', 'session-alias:', 'openrouter-response:',
                                   'CONTEXT_SNAPSHOT_JSON ', 'CONTEXT_BEGIN', 'CONTEXT_END',
                                   '===== TTYCHATTER CONTEXT ')))]
        if not visible:
            self.maybe_show_startup_notice()
        for entry in visible[-self.TRANSCRIPT_REPLAY_LIMIT:]:
            self.transcript.append(TranscriptItem(entry.speaker, entry.text, entry.timestamp))
        snapshot = latest_context_snapshot(entries)
        if snapshot is not None:
            self.context_buffer = snapshot
        else:
            self.context_buffer = [('Assistant: ' if entry.speaker in {'AI', 'OpenRouter', 'Assistant'} else 'User: ') + entry.text
                for entry in entries if is_conversation_entry(entry)]
        self.trim_context_buffer()
        replies = [entry.text for entry in visible if entry.speaker in {'AI', 'OpenRouter', 'Assistant'}]
        self.last_reply = replies[-1] if replies else ''
        self.status = 'Loaded: ' + (self.session_title or self.session_name)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def reset_to_session
    # Maintainer note for reset_to_session: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def reset_to_session(self, session_name: str, session_path: Path) -> None:
        if self._request_active:
            self.status = 'A response is still in flight; finish or close it before switching sessions.'
            return
        if self.cfg.request_session_id:
            self._session_drafts[self.cfg.request_session_id] = (list(self.input_lines), self.cursor_row,
                self.cursor_col, list(self.pending_attachments))
        self.session_name, self.session_path = session_name, session_path
        self.cfg.request_session_id = ensure_session_id(session_path)
        self.session_title = session_title_from_file(session_path)
        draft = self._session_drafts.get(self.cfg.request_session_id, ([''], 0, 0, []))
        self.input_lines, self.cursor_row, self.cursor_col, self.pending_attachments = draft
        self.input_scroll = 0
        self.transcript, self.context_buffer = [], []
        self.transcript_scroll = 0
        self.startup_notice_active = False
        self.first_user_message_sent = False
        self._named_after_reply = False
        self.load_session_into_ui()
        self.prompt_session_title(reminder=True)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def trim_context_buffer
    # Maintainer note for trim_context_buffer: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def trim_context_buffer(self) -> None:
        max_entries = self.cfg.context_turns * 2
        if len(self.context_buffer) > max_entries:
            self.context_buffer = self.context_buffer[-max_entries:]

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def build_context
    # Maintainer note for build_context: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def build_context(self) -> str:
        return "\n".join(self.context_buffer)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def save_context_snapshot
    # Maintainer note for save_context_snapshot: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def save_context_snapshot(self) -> None:
        append_context_snapshot(self.session_path, self.context_buffer)

    # ------------------------------------------------------------------
    # Curses drawing and style helpers
    # ------------------------------------------------------------------

    def normal_attr(self) -> int:
        """Return ordinary foreground text attributes for the current theme.

        Keeping even "normal" in a helper matters because future ports and
        theme work need a single semantic vocabulary: normal user-visible text,
        dim metadata, reverse selections, and warning emphasis.  Calling
        curses.A_NORMAL directly throughout the program would make it harder
        for a maintainer to change the visual language consistently.
        """
        return curses.A_NORMAL

    def warning_attr(self) -> int:
        """Return an attention-drawing style for security warnings.

        API-key storage is one of the few places where ttychatter can affect a
        user's real-world security posture.  Plaintext warnings should therefore
        be visible even in monochrome terminals.  We use bold rather than color
        because color pairs are terminal-dependent and the program must remain
        usable on low-feature terminals.
        """
        return curses.A_BOLD

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def dim_attr
    # Maintainer note for dim_attr: this routine is part of the long-term public behavior of the
    # program. When changing it, check callers, documentation, config compatibility, session-log
    # compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def dim_attr(self) -> int:
        return curses.A_NORMAL

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def reverse_attr
    # Main selection/header style.  Reverse video is the most portable way to
    # make something look selected in a text terminal because it does not depend
    # on a particular color palette.  High-contrast mode adds bold so selected
    # rows remain clear even on dim displays.
    # ------------------------------------------------------------
    def reverse_attr(self) -> int:
        return curses.A_REVERSE

    def reverse_dim_attr(self) -> int:
        return curses.A_REVERSE

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def attr_header
    # Maintainer note for attr_header: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def attr_header(self) -> int:
        # Compatibility helper for menus that use header-style reverse video.
        return self.reverse_attr()

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def attr_dim
    # Maintainer note for attr_dim: this routine is part of the long-term public behavior of the
    # program. When changing it, check callers, documentation, config compatibility, session-log
    # compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def attr_dim(self) -> int:
        # Compatibility helper for menus that use dim/grey metadata styling.
        return self.dim_attr()

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def transcript_attr_for
    # Maintainer note for transcript_attr_for: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def transcript_attr_for(self, speaker: str) -> int:
        return curses.A_NORMAL

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def maybe_show_startup_notice
    # Maintainer note for maybe_show_startup_notice: this routine is part of the long-term
    # public behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def maybe_show_startup_notice(self) -> None:
        if not self.cfg.startup_notice:
            return
        self.startup_notice_active = True
        self.transcript.append(TranscriptItem("remfan1994", PROJECT_NOTICE, now_time()))
        self.transcript.append(TranscriptItem("system", "Message list window: the notice above disappears when you start chatting, and messages to and from the AI will appear here. Press Ctrl+G or Enter according to SEND_INPUT to send.", now_time()))

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def remove_startup_notice
    # Maintainer note for remove_startup_notice: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def remove_startup_notice(self) -> None:
        if not self.startup_notice_active:
            return
        self.transcript = [
            item for item in self.transcript
            if not ((item.speaker == "remfan1994" and item.text == PROJECT_NOTICE) or (item.speaker == "system" and item.text.startswith("Message list window:")))
        ]
        self.startup_notice_active = False

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def safe_addstr
    #
    # This is the small drawing primitive that almost every screen uses.  It
    # deserves more explanation than a normal wrapper because terminal drawing
    # bugs are among the hardest defects for future maintainers to reproduce.
    #
    # Curses draws by absolute cell coordinates: y is the row, x is the column,
    # both starting at zero.  On many terminals, writing to the final cell of
    # the final row can trigger an implicit scroll or raise curses.error.  The
    # earliest ttychatter builds avoided that by never writing the final column
    # anywhere.  That prevented bottom-right crashes, but it also made users
    # with large fonts / low resolutions see every line clipped by one visible
    # character.  The current compromise reserves the last cell ONLY on the
    # bottom row.  Everywhere else, the full line width is usable.
    #
    # If a porter rewrites the UI for another toolkit, this function is the
    # place to preserve the "do not explode at the terminal edge" rule without
    # globally stealing a column from all text.
    # ------------------------------------------------------------
    def safe_addstr(self, y: int, x: int, text: str, max_width: Optional[int] = None, attr: int = 0) -> None:
        height, width = self.stdscr.getmaxyx()
        if y < 0 or y >= height or x < 0 or x >= width:
            return
        limit = width - x - (1 if y == height - 1 else 0)
        if max_width is not None:
            limit = min(limit, max_width)
        if limit < 1:
            return
        try:
            self.stdscr.addstr(y, x, clip_terminal_text(text, limit), attr)
        except curses.error:
            pass

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def transcript_display_lines
    # Maintainer note for transcript_display_lines: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def transcript_display_lines(self, width: int) -> List[Tuple[str, int]]:
        lines = []
        for item in self.transcript:
            key = (width, item.speaker, item.timestamp, item.text)
            if getattr(item, '_wrap_key', None) != key:
                prefix = f'[{item.timestamp}] {item.speaker}: '
                item._wrap_lines = [(text, self.transcript_attr_for(item.speaker))
                                    for text in wrap_for_width(prefix + item.text, width)] + [('', 0)]
                item._wrap_key = key
            lines.extend(item._wrap_lines)
        return lines

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def model_label
    # Maintainer note for model_label: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def model_label(self) -> str:
        if self.cfg.model:
            return self.cfg.model
        return f"{FALLBACK_MODEL} (fallback)"

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def draw_header
    # Maintainer note for draw_header: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def draw_header(self, width: int) -> None:
        title = self.session_title or 'UNNAMED - name from Esc menu'
        prefix = 'DEMO | ' if self.cfg.demo_mode else ''
        text = prefix + title
        extra = f' | {self.cfg.effective_model} | web:{"on" if self.cfg.web_search else "off"}'
        if self.pending_attachments:
            extra += f' | files:{len(self.pending_attachments)}'
        self.safe_addstr(0, 0, text + extra, width, curses.A_BOLD)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def draw_transcript
    # Maintainer note for draw_transcript: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def draw_transcript(self, start_y: int, height: int, width: int) -> None:
        lines = self.transcript_display_lines(width)
        previous = getattr(self, '_drawn_transcript_size', None)
        if getattr(self, '_streaming', False) and self.transcript_scroll > 0 and previous and previous[0] == width:
            self.transcript_scroll += max(0, len(lines) - previous[1])
        self._drawn_transcript_size = (width, len(lines))
        max_scroll = max(0, len(lines) - height)
        self.transcript_scroll = min(self.transcript_scroll, max_scroll)
        start = max(0, len(lines) - height - self.transcript_scroll)
        visible = lines[start : start + height]
        for offset in range(height):
            if offset < len(visible):
                text, attr = visible[offset]
                self.safe_addstr(start_y + offset, 0, text, width, attr)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def input_segments
    # Maintainer note for input_segments: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def input_segments(self, width: int) -> Tuple[List[InputSegment], int, int]:
        available = max(1, width - 2)
        segments = []
        for row, line in enumerate(self.input_lines):
            start, used, absolute = 0, 0, 0
            chunks, columns = [], [0]
            for index, char in enumerate(line):
                cells = 4 - absolute % 4 if char == '\t' else terminal_cell_width(char)
                if used and used + cells > available:
                    marker = '> ' if row == 0 and start == 0 else '  '
                    segments.append(InputSegment(marker + ''.join(chunks), row, start, available, index, columns))
                    start, used, chunks, columns = index, 0, [], [0]
                shown = ' ' * cells if char == '\t' else char
                chunks.append(shown)
                used += cells
                absolute += cells
                columns.append(used)
            marker = '> ' if row == 0 and start == 0 else '  '
            segments.append(InputSegment(marker + ''.join(chunks), row, start, available, len(line), columns))
            if row == self.cursor_row and self.cursor_col == len(line) and used >= available:
                segments.append(InputSegment('  ', row, len(line), available, len(line), [0]))
        cursor_index, cursor_x = 0, 2
        for index, segment in enumerate(segments):
            if segment.logical_row == self.cursor_row and segment.start <= self.cursor_col <= segment.end:
                offset = self.cursor_col - segment.start
                cursor_index = index
                cursor_x = 2 + segment.caret_cells[offset]
                if self.cursor_col < segment.end:
                    break
        return segments, cursor_index, cursor_x

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def command_bar_items
    #
    # This list is the main-screen command strip.  It deliberately mixes
    # function-key screens and a few direct control-key actions because the user
    # should not need to remember that attachments live behind F7.  The visible
    # bar is especially important on laptop terminals with no backlit keyboard:
    # it is the user's map of the interface.
    #
    # draw_command_bar() may hide some of these labels on narrow screens, but
    # the full list remains the authoritative clickable inventory for ordinary
    # terminal sizes.  If a maintainer changes the names or actions here, update
    # handle_key(), dispatch_command_action(), the help menu, and the man page.
    # ------------------------------------------------------------


    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def draw_command_bar
    # Maintainer note for draw_command_bar: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------


    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def draw_input
    # Maintainer note for draw_input: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def draw_input(self, label_y: int, input_y: int, width: int) -> None:
        self.safe_addstr(label_y, 0, f'Draft | {self.send_key_label()} send | F11 read', width, curses.A_BOLD)
        segments, cursor_visual_index, cursor_x = self.input_segments(width)
        self.last_input_segments = segments
        input_h = self.layout['input_h']
        self.input_scroll = min(self.input_scroll, cursor_visual_index)
        if cursor_visual_index >= self.input_scroll + input_h:
            self.input_scroll = cursor_visual_index - input_h + 1
        self.input_scroll = max(0, min(self.input_scroll, max(0, len(segments) - input_h)))
        visible = segments[self.input_scroll:self.input_scroll + input_h]
        for offset, segment in enumerate(visible):
            self.safe_addstr(input_y + offset, 0, segment.display, width)
        if not self.current_input():
            self.safe_addstr(input_y, 2, self.cfg.input_placeholder, width - 2)
        y = input_y + cursor_visual_index - self.input_scroll
        x = min(cursor_x, width - 1)
        self._cursor_screen = (y, x)
        # A cell marker also works when the terminal's own cursor has poor contrast.
        char = self.input_lines[self.cursor_row][self.cursor_col:self.cursor_col+1]
        if not char and not self.current_input() and self.cfg.input_placeholder:
            char = self.cfg.input_placeholder[:1]
        char = char or ' '
        if char == '\t' or unicodedata.combining(char):
            char = ' '
        self.safe_addstr(y, x, char, max(1, width - x), curses.A_REVERSE)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def draw_status
    # Maintainer note for draw_status: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def draw_status(self, y: int, width: int) -> None:
        position = f'L{self.cursor_row+1} C{self.cursor_col+1}' if self.input_visible else 'READ'
        position += f' W:{"on" if self.cfg.web_search else "off"}'
        if self._request_active:
            position += ' AI:busy'
        left = 'Esc Menu | F11 Draft' if not self.input_visible else 'Esc Menu | F11 Read'
        room = width - len(position) - 2
        if room > len(left) + 5:
            left += ' | ' + self.status
        self.safe_addstr(y, 0, left, room)
        self.safe_addstr(y, max(0, width-len(position)-1), position, len(position))

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def draw
    # Maintainer note for draw: this routine is part of the long-term public behavior of the
    # program. When changing it, check callers, documentation, config compatibility, session-log
    # compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def draw(self) -> None:
        self.stdscr.erase()
        height, width = self.stdscr.getmaxyx()
        self.command_click_targets = []
        self._cursor_screen = None
        if height < 5 or width < 20:
            self.layout = {}
            self.safe_addstr(0, 0, 'Resize terminal', width)
            self.safe_addstr(1, 0, 'Esc menu F10 quit', width)
            self.stdscr.refresh()
            return
        input_h = min(self.cfg.input_height, max(1, height - 5)) if self.input_visible else 0
        label_h = 1 if input_h else 0
        transcript_h = height - 2 - label_h - input_h
        input_label_y = 1 + transcript_h
        input_y = input_label_y + label_h
        self.layout = {'width': width, 'height': height, 'transcript_y': 1,
                       'transcript_h': transcript_h, 'input_label_y': input_label_y,
                       'input_y': input_y, 'input_h': input_h, 'status_y': height - 1}
        self.draw_header(width)
        self.draw_transcript(1, transcript_h, width)
        if self.input_visible:
            self.draw_input(input_label_y, input_y, width)
        self.draw_status(height - 1, width)
        # All text must be drawn before moving the hardware cursor.
        try:
            curses.curs_set(1 if self.input_visible else 0)
            if self._cursor_screen:
                self.stdscr.move(*self._cursor_screen)
        except curses.error:
            pass
        self.stdscr.refresh()

    # ------------------------------------------------------------------
    # Mouse handling
    # ------------------------------------------------------------------

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def mouse_wheel_delta
    # Maintainer note for mouse_wheel_delta: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def mouse_wheel_delta(self, state: int) -> int:
        if state & getattr(curses, "BUTTON4_PRESSED", 0):
            return 1
        if state & getattr(curses, "BUTTON5_PRESSED", 0):
            return -1
        return 0

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def mouse_button1
    # Maintainer note for mouse_button1: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def mouse_button1(self, state: int) -> bool:
        masks = [
            getattr(curses, "BUTTON1_PRESSED", 0),
            getattr(curses, "BUTTON1_CLICKED", 0),
            getattr(curses, "BUTTON1_DOUBLE_CLICKED", 0),
            getattr(curses, "BUTTON1_TRIPLE_CLICKED", 0),
        ]
        return any(state & mask for mask in masks)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def mouse_button1_double
    # Maintainer note for mouse_button1_double: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def mouse_button1_double(self, state: int) -> bool:
        return bool(state & getattr(curses, "BUTTON1_DOUBLE_CLICKED", 0))

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def handle_mouse
    # Maintainer note for handle_mouse: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def handle_mouse(self) -> None:
        try:
            _mouse_id, x, y, _z, state = curses.getmouse()
        except curses.error:
            return
        delta = self.mouse_wheel_delta(state)
        if delta:
            if delta > 0:
                self.transcript_scroll += MOUSE_SCROLL_LINES
            else:
                self.transcript_scroll = max(0, self.transcript_scroll - MOUSE_SCROLL_LINES)
            self.status = "mousewheel: transcript scroll"
            return
        if not self.layout:
            return
        if self.mouse_button1(state):
            for target_y, start, end, action in self.command_click_targets:
                if y == target_y and start <= x < end:
                    self.dispatch_command_action(action)
                    return

            input_y = self.layout.get("input_y", -1)
            input_h = self.layout.get("input_h", 0)
            if input_y <= y < input_y + input_h:
                self.place_cursor_from_mouse(x, y - input_y)
                self.status = "mouse: input cursor placed"

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def place_cursor_from_mouse
    # Maintainer note for place_cursor_from_mouse: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def place_cursor_from_mouse(self, x: int, visible_row: int) -> None:
        index = self.input_scroll + visible_row
        if index < 0 or index >= len(self.last_input_segments):
            return
        segment = self.last_input_segments[index]
        line = self.input_lines[segment.logical_row]
        clicked_col = max(0, x - 2)
        offset = max((index for index, cell in enumerate(segment.caret_cells) if cell <= clicked_col), default=0)
        logical_col = min(len(line), segment.start + offset)
        self.cursor_row = segment.logical_row
        self.cursor_col = logical_col

    # ------------------------------------------------------------------
    # Generic modals and external editor
    # ------------------------------------------------------------------

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def show_message
    # Maintainer note for show_message: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def show_message(self, title: str, lines: List[str]) -> None:
        """Show a resolution-safe full-screen scrollable page.

        The earlier modal version could clip long text on small terminals.
        This page owns the whole screen, wraps all lines, and supports
        PgUp/PgDn, mousewheel, q/Esc, and any key to leave when content fits.
        """
        scroll = 0
        while True:
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            body_h = max(1, height - 4)
            wrapped: List[str] = []
            for line in lines:
                if line == "":
                    wrapped.append("")
                else:
                    wrapped.extend(wrap_for_width(line, max(10, width)))

            max_scroll = max(0, len(wrapped) - body_h)
            scroll = max(0, min(scroll, max_scroll))

            self.safe_addstr(0, 0, title, width, self.reverse_attr())
            self.safe_addstr(1, 0, "_" * width, width, self.dim_attr())

            visible = wrapped[scroll:scroll + body_h]
            for idx, line in enumerate(visible):
                self.safe_addstr(2 + idx, 0, line, width)

            footer = "q/Esc=return | PgUp/PgDn/wheel=scroll"
            if max_scroll == 0:
                footer = "q/Esc/any key=return"
            self.safe_addstr(height - 1, 0, footer, width, self.reverse_attr())
            self.stdscr.refresh()

            ch = self.ui_getch()
            if self.handle_global_hotkey(ch):
                return
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, _y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    scroll = max(0, scroll - MOUSE_SCROLL_LINES)
                    continue
                if delta < 0:
                    scroll = min(max_scroll, scroll + MOUSE_SCROLL_LINES)
                    continue
                return
            if ch in (27, ord("q"), ord("Q")):
                return
            if ch == curses.KEY_UP:
                scroll = max(0, scroll - 1)
                continue
            if ch == curses.KEY_DOWN:
                scroll = min(max_scroll, scroll + 1)
                continue
            if ch == curses.KEY_HOME:
                scroll = 0
                continue
            if ch == curses.KEY_END:
                scroll = max_scroll
                continue
            if ch == curses.KEY_PPAGE:
                scroll = max(0, scroll - body_h)
                continue
            if ch == curses.KEY_NPAGE:
                scroll = min(max_scroll, scroll + body_h)
                continue
            if max_scroll == 0:
                return

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def ask_yes_no
    # Maintainer note for ask_yes_no: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def ask_yes_no(self, title: str, message: str, default: bool = False) -> bool:
        while True:
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            self.safe_addstr(0, 0, title, width, curses.A_BOLD)
            for index, line in enumerate(wrap_for_width(message, max(1, width))):
                self.safe_addstr(2 + index, 0, line, width)
            self.safe_addstr(height-1, 0, 'Y=yes N=no Enter=no Esc=no' if not default else 'Y=yes N=no Enter=yes Esc=no', width)
            try:
                curses.curs_set(0)
            except curses.error:
                pass
            self.stdscr.refresh()
            ch = self.ui_getch()
            if title == 'CLOSE SESSION' and ch in (curses.KEY_F10, 17):
                continue
            if self.handle_global_hotkey(ch):
                return False
            if ch in (ord('y'), ord('Y')):
                return True
            if ch in (ord('n'), ord('N'), 27):
                return False
            if ch in (10, 13, curses.KEY_ENTER):
                return default

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def text_input_modal
    # Maintainer note for text_input_modal: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def text_input_modal(self, title: str, prompt: str, initial: str = '', secret: bool = False) -> Optional[str]:
        value, cursor = initial, len(initial)
        while True:
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            self.safe_addstr(0, 0, title, width, curses.A_BOLD)
            for index, line in enumerate(wrap_for_width(prompt, max(1, width))[:max(1, height-4)]):
                self.safe_addstr(1+index, 0, line, width)
            field_y = max(1, height-3)
            field_w = max(1, width-3)
            start = max(0, cursor-field_w+1)
            masked = '*' * len(value) if secret else value
            shown = masked[start:start+field_w]
            self.safe_addstr(field_y, 0, '> ' + shown, width)
            cursor_x = min(width-2, 2 + cursor-start)
            self.safe_addstr(field_y, cursor_x, (masked[cursor:cursor+1] or ' '), 1, curses.A_REVERSE)
            self.safe_addstr(height-1, 0, f'Enter=save Esc=cancel | C{cursor+1}', width)
            try:
                curses.curs_set(1)
                self.stdscr.move(field_y, cursor_x)
            except curses.error:
                pass
            self.stdscr.refresh()
            ch = self.ui_getch()
            if self.handle_global_hotkey(ch):
                return None
            if ch in (10, 13, curses.KEY_ENTER):
                return value.strip()
            if ch == 27:
                return None
            if ch in (curses.KEY_BACKSPACE, 127, 8) and cursor:
                value = value[:cursor-1] + value[cursor:]
                cursor -= 1
            elif ch == curses.KEY_DC:
                value = value[:cursor] + value[cursor+1:]
            elif ch == curses.KEY_LEFT:
                cursor = max(0, cursor-1)
            elif ch == curses.KEY_RIGHT:
                cursor = min(len(value), cursor+1)
            elif ch == curses.KEY_HOME:
                cursor = 0
            elif ch == curses.KEY_END:
                cursor = len(value)
            elif ch == 21:
                value, cursor = '', 0
            elif 32 <= ch <= 126:
                value = value[:cursor] + chr(ch) + value[cursor:]
                cursor += 1

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def api_key_entry_modal
    #
    # This is intentionally not just a generic text field.  API-key storage is
    # a security-sensitive choice, so the UI must show the storage mode at the
    # exact moment the user pastes the key.  Earlier builds hid GPG support in
    # the options menu while the API-key dialog still talked only about
    # plaintext storage.  That was misleading: the place where the user decides
    # what happens to the secret is the API-key entry screen itself.
    #
    # The checkbox is a visual ncurses approximation of a GUI tick box.  Space
    # toggles it when GPG is available; if GPG is missing, the line explicitly
    # says "gpg not found" and cannot be enabled.  The returned boolean means
    # "encrypt this key using external gpg before saving."  If the user leaves
    # the checkbox off, the caller may still offer plaintext saving, but the
    # plaintext warning must appear only for that plaintext path.
    # ------------------------------------------------------------
    def api_key_entry_modal(self) -> Tuple[Optional[str], bool]:
        value = ""
        cursor = 0
        use_gpg = False
        gpg_available = shutil.which("gpg") is not None

        while True:
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            box_w = min(width - 4, 88)
            box_h = 13
            top = max(0, (height - box_h) // 2)
            left = max(0, (width - box_w) // 2)
            field_w = box_w - 6
            masked = "*" * max(0, len(value) - 4) + value[-4:]
            shown = masked[max(0, cursor - field_w + 1):][:field_w]

            self.safe_addstr(top, left, "+" + "-" * (box_w - 2) + "+", attr=self.reverse_attr())
            self.safe_addstr(top + 1, left, "|" + "API KEY".center(box_w - 2) + "|", attr=self.reverse_attr())
            self.safe_addstr(top + 2, left, "+" + "-" * (box_w - 2) + "+", attr=self.reverse_attr())
            self.safe_addstr(top + 3, left + 2, "Paste OpenRouter API key. Enter=accept. Esc=cancel.", box_w - 4)
            self.safe_addstr(top + 5, left + 2, " " * field_w, field_w, self.reverse_attr())
            self.safe_addstr(top + 5, left + 2, shown, field_w, self.reverse_attr())

            if gpg_available:
                checkbox = "[x] encrypt with gpg" if use_gpg else "[ ] encrypt with gpg"
                attr = self.reverse_dim_attr() if use_gpg else self.dim_attr()
            else:
                checkbox = "[ ] encrypt with gpg (gpg not found)"
                attr = self.dim_attr()
            self.safe_addstr(top + 7, left + 2, checkbox, box_w - 4, attr)

            if use_gpg:
                hint = f"GPG file: {self.cfg.effective_api_key_gpg_file}"
            elif gpg_available:
                hint = "Space toggles GPG encryption. If left unticked, plaintext saving will warn you."
            else:
                hint = "Install gpg to enable encrypted API-key storage."
            self.safe_addstr(top + 8, left + 2, hint, box_w - 4, self.dim_attr())
            self.safe_addstr(top + 10, left + 2, "Space=toggle GPG | Enter=accept | Esc=cancel | Backspace=edit", box_w - 4, self.dim_attr())
            self.safe_addstr(top + 12, left, "+" + "-" * (box_w - 2) + "+", attr=self.reverse_attr())
            self.stdscr.refresh()

            ch = self.ui_getch()
            if self.handle_global_hotkey(ch):
                return None, False
            if ch in (10, 13, curses.KEY_ENTER):
                return value.strip() or None, use_gpg
            if ch == 27:
                return None, False
            if ch == 32:
                if gpg_available:
                    use_gpg = not use_gpg
                continue
            if ch in (curses.KEY_BACKSPACE, 127, 8):
                if cursor > 0:
                    value = value[: cursor - 1] + value[cursor:]
                    cursor -= 1
            elif ch == curses.KEY_DC:
                if cursor < len(value):
                    value = value[:cursor] + value[cursor + 1:]
            elif ch == curses.KEY_LEFT:
                cursor = max(0, cursor - 1)
            elif ch == curses.KEY_RIGHT:
                cursor = min(len(value), cursor + 1)
            elif ch == curses.KEY_HOME:
                cursor = 0
            elif ch == curses.KEY_END:
                cursor = len(value)
            elif 32 <= ch <= 126:
                value = value[:cursor] + chr(ch) + value[cursor:]
                cursor += 1

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def run_external_editor
    # Maintainer note for run_external_editor: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def run_external_editor(self, initial_text: str, suffix: str = ".txt") -> Optional[str]:
        editor = self.cfg.effective_editor
        fd, path_str = tempfile.mkstemp(prefix="ttychatter.ncurses-", suffix=suffix)
        path = Path(path_str)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                fh.write(initial_text)
            curses.def_prog_mode()
            curses.endwin()
            try:
                code = subprocess.call(shlex.split(editor) + [str(path)])
                if code != 0:
                    self.status = f'Editor exited with status {code}; draft preserved'
                    return None
            finally:
                curses.reset_prog_mode()
                self.stdscr.keypad(True)
            return path.read_text(encoding="utf-8", errors="replace")
        except Exception as exc:
            self.status = f"editor error: {exc}"
            return None
        finally:
            try:
                path.unlink()
            except OSError:
                pass

