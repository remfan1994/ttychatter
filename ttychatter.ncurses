import threading
import textwrap
import time
import unicodedata
import uuid
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path
from typing import Callable, Dict, List, Optional, Tuple

VERSION = "0.17.0"
PROGRAM = "ttychatter.ncurses"
FALLBACK_MODEL = "openrouter/auto"
DEFAULT_MODEL_TEST_PROMPT = "Please reply with one short sentence confirming this model is available for text generation."
DEFAULT_GITHUB_URL = "https://github.com/remfan1994/ttychatter"
PROJECT_NOTICE = "Everyone is encouraged to get the cruelty-free vegetarian alternatives and remember the bloodguilt curse from the Bible... http://bloodguiltcurse.net"
PRECHAT_LINE = PROJECT_NOTICE
STREAM_INTERRUPT_MARKER = "[assistant stream interrupted by user]"
INPUT_PLACEHOLDER_DEFAULT = "Type here..."
MOUSE_SCROLL_LINES = 3
MAX_INLINE_ATTACHMENT_BYTES = 20 * 1024 * 1024
def xdg_home(env_name: str, fallback: Path) -> Path:
    raw = os.environ.get(env_name, "").strip()
    return Path(raw).expanduser() if raw else fallback


DEFAULT_CONFIG_HOME = xdg_home("XDG_CONFIG_HOME", Path.home() / ".config")
DEFAULT_DATA_HOME = xdg_home("XDG_DATA_HOME", Path.home() / ".local" / "share")
DEFAULT_CACHE_HOME = xdg_home("XDG_CACHE_HOME", Path.home() / ".cache")
DEFAULT_CONFIG_FILE = DEFAULT_CONFIG_HOME / "ttychatter" / "openrouter" / "config"
LEGACY_CONFIG_FILE = DEFAULT_CONFIG_HOME / "ttychatter" / "config"
DEFAULT_MODEL_CACHE_FILE = DEFAULT_CACHE_HOME / "ttychatter" / "openrouter" / "models.json"
DEFAULT_GPG_API_KEY_FILE = DEFAULT_CONFIG_HOME / "ttychatter" / "openrouter" / "api-key.gpg"
LEGACY_GPG_API_KEY_FILE = DEFAULT_CONFIG_HOME / "ttychatter" / "api-key.gpg"
DEFAULT_SESSION_DIR = DEFAULT_DATA_HOME / "ttychatter" / "openrouter" / "sessions"
DEFAULT_ATTACHMENT_DIR = DEFAULT_DATA_HOME / "ttychatter" / "openrouter" / "attachments"
DEFAULT_MODEL_MIN_INPUT_TOKENS = 0
DEFAULT_MODEL_MIN_OUTPUT_TOKENS = 0
DEFAULT_MODEL_SORT_ORDER = "api"
THEME_CHOICES = ["terminal"]
WEB_SEARCH_ENGINES = ["auto", "native", "exa", "parallel", "perplexity", "firecrawl"]
WEB_SEARCH_MODES = ["auto", "server-tool", "plugin"]
MODEL_TYPE_CHOICES = ["all", "routers", "fixed", "free", "auto"]


# ---------------------------------------------------------------------------
# Configuration model
# ---------------------------------------------------------------------------
# Shared config file:
#   ~/.config/ttychatter/openrouter/config
#
# Preferred memory terminology:
#   CONTEXT_TURNS
#
# Legacy compatibility:
#   HISTORY_LIMIT is still accepted as an alias for CONTEXT_TURNS.
#
# Autoscan was intentionally removed. The model workflow is now:
#   --models / F2 model selector -> select a model -> test selected model -> activate/save
# ---------------------------------------------------------------------------


@dataclass
# ------------------------------------------------------------
# MAINTAINER COMMENTARY: class Config
# Central configuration record. Keep this boring and explicit because all implementations share
# the same conceptual settings. If you add a config key here, update the config loader, options
# UI, man page, README, and Bash variants.
# ------------------------------------------------------------
class Config:
    model: str = ""
    context_turns: int = 12
    api_key: str = ""
    api_key_gpg_file: Optional[Path] = None
    confirm_live_send: bool = True
    live_send_confirmed: bool = False
    session_dir: Path = field(default_factory=lambda: DEFAULT_SESSION_DIR)
    attachment_dir: Optional[Path] = None
    editor: str = ""
    github_url: str = DEFAULT_GITHUB_URL
    model_test_prompt: str = DEFAULT_MODEL_TEST_PROMPT
    monochrome: bool = False
    input_placeholder: str = INPUT_PLACEHOLDER_DEFAULT
    startup_notice: bool = True
    config_file: Path = field(default_factory=lambda: DEFAULT_CONFIG_FILE)
    model_cache_file: Path = field(default_factory=lambda: DEFAULT_MODEL_CACHE_FILE)
    model_filter_chat_completions: bool = True
    model_filter_require_tokens: bool = False
    model_filter_hide_preview: bool = False
    model_min_input_tokens: int = DEFAULT_MODEL_MIN_INPUT_TOKENS
    model_min_output_tokens: int = DEFAULT_MODEL_MIN_OUTPUT_TOKENS
    model_sort_order: str = DEFAULT_MODEL_SORT_ORDER
    model_type_filter: str = "all"
    theme: str = "terminal"
    send_input: str = "enter"
    prompt_session_name: bool = True
    code_attachment_min_lines: int = 5
    model_favorites_file: Optional[Path] = None
    max_attachment_bytes: int = MAX_INLINE_ATTACHMENT_BYTES
    demo_mode: bool = False
    loopback_file: Optional[Path] = None
    session_auto_title: bool = False
    session_title_model: str = FALLBACK_MODEL
    session_title_max_words: int = 8
    stream: bool = False
    ai_file_download_mode: str = "ask"
    input_height: int = 3
    web_search: bool = False
    web_search_engine: str = "auto"
    web_search_max_results: int = 5
    web_search_max_uses: int = 3
    web_search_mode: str = "auto"
    request_session_id: str = ""
    last_response_metadata: dict = field(default_factory=dict)

    @property
    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def effective_model
    # Maintainer note for effective_model: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def effective_model(self) -> str:
        return self.model or FALLBACK_MODEL

    @property
    def effective_api_key_gpg_file(self) -> Path:
        """Return the encrypted API-key file path.

        This path is separate from the simple KEY=VALUE config file because
        GPG ciphertext can be armored, multi-line, or handled by external GPG
        tooling. Keeping it in its own file makes encrypted key storage usable
        across the ncurses, Python-helper Bash, Bash-only, and future C tracks
        without changing the config parser into a full structured-data reader.
        """
        if self.api_key_gpg_file is not None:
            return self.api_key_gpg_file
        return DEFAULT_GPG_API_KEY_FILE

    @property
    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def effective_attachment_dir
    # Maintainer note for effective_attachment_dir: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def effective_attachment_dir(self) -> Path:
        if self.attachment_dir is not None:
            return self.attachment_dir
        return DEFAULT_ATTACHMENT_DIR

    @property
    def effective_model_favorites_file(self) -> Path:
        """Return provider-specific model favorites file.

        Favorites are user preferences, not cache. They belong under config so
        they survive cache deletion and make model-browser navigation more
        personal without forcing users to edit raw cache JSON.
        """
        if self.model_favorites_file is not None:
            return self.model_favorites_file
        return self.config_file.parent / "model-favorites"

    @property
    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def effective_editor
    # Maintainer note for effective_editor: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def effective_editor(self) -> str:
        return self.editor or os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def expand_path
# Maintainer note for expand_path: this routine is part of the long-term public behavior of the
# program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def expand_path(value: str) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(value))).resolve()


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def normalize_model_id
# Maintainer note for normalize_model_id: this routine is part of the long-term public behavior
# of the program. When changing it, check callers, documentation, config compatibility, session-
# log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def normalize_model_id(model: str) -> str:
    model = model.strip()
    if model.startswith("models/"):
        return model.split("/", 1)[1]
    return model


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def parse_positive_int
# Maintainer note for parse_positive_int: this routine is part of the long-term public behavior
# of the program. When changing it, check callers, documentation, config compatibility, session-
# log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def parse_positive_int(value: str, fallback: int) -> int:
    try:
        parsed = int(value)
    except ValueError:
        return fallback
    return max(1, parsed)


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def parse_nonnegative_int
# Maintainer note for parse_nonnegative_int: this routine is part of the long-term public
# behavior of the program. When changing it, check callers, documentation, config compatibility,
# session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def parse_nonnegative_int(value: str, fallback: int) -> int:
    try:
        parsed = int(value)
    except ValueError:
        return fallback
    return max(0, parsed)


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def parse_bool
# Maintainer note for parse_bool: this routine is part of the long-term public behavior of the
# program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def parse_bool(value: str, default: bool = False) -> bool:
    value = value.strip().lower()
    if value in {"1", "yes", "true", "on", "y"}:
        return True
    if value in {"0", "no", "false", "off", "n"}:
        return False
    return default


def decrypt_gpg_file(path: Path) -> str:
    """Attempt to decrypt an OpenRouter API key from a GPG file.

    The program deliberately shells out to the user's existing `gpg` command
    instead of embedding cryptography. That keeps ttychatter aligned with Unix
    user control: the user's keyring, pinentry program, and trust model remain
    outside ttychatter. If decryption fails, we return an empty string and let
    normal runtime/API-key prompts handle the situation.

    This helper must never log or print the decrypted key. Diagnostic screens
    may say whether gpg exists and whether the file exists, but the secret value
    stays out of the terminal transcript, session logs, and error messages.
    """
    if not path.exists() or shutil.which("gpg") is None:
        return ""
    try:
        proc = subprocess.run(
            ["gpg", "--quiet", "--decrypt", str(path)],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except Exception:
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.strip()


def save_gpg_encrypted_api_key(key: str, path: Path) -> Tuple[bool, str]:
    """Encrypt an API key into a dedicated GPG file.

    This routine is intentionally verbose because it is a security-sensitive
    bridge between ttychatter's terminal UI and the user's external GPG setup.
    ttychatter does not implement cryptography itself. Instead it writes the
    pasted key to a temporary file with private permissions, temporarily yields
    the curses display so that GPG/pinentry can interact with the user, and asks
    the user's local `gpg` program to create an armored symmetric ciphertext.

    Maintainers should preserve several invariants:
      * never print the API key;
      * never log the API key;
      * delete the temporary plaintext file even if GPG fails;
      * do not silently fall back to plaintext if GPG is missing;
      * keep this as an explicit user choice, not a surprise side effect.

    The function returns (ok, message). The message is safe to display because
    it contains paths/status only, never the secret value.
    """
    if shutil.which("gpg") is None:
        return False, "gpg not found; encrypted API-key storage is unavailable"

    path = expand_path(str(path))
    path.parent.mkdir(parents=True, exist_ok=True)

    tmp_path: Optional[Path] = None
    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", delete=False, prefix="ttychatter-api-key-", suffix=".txt") as tmp:
            tmp.write(key.strip() + "\n")
            tmp_path = Path(tmp.name)
        try:
            os.chmod(tmp_path, 0o600)
        except OSError:
            pass

        # GPG may need to prompt through pinentry or the terminal. Running it
        # while curses owns the screen can hide the prompt or garble the UI, so
        # we temporarily restore the terminal. curses.wrapper will restore
        # normal screen handling after this helper returns to the UI loop.
        try:
            curses.endwin()
        except curses.error:
            pass
        print(f"ttychatter: encrypting API key with gpg -> {path}", file=sys.stderr)
        proc = subprocess.run([
            "gpg", "--yes", "--armor", "--symmetric", "--cipher-algo", "AES256",
            "--output", str(path), str(tmp_path)
        ], check=False)
        if proc.returncode != 0:
            return False, "gpg encryption failed; API key was not saved"

        try:
            os.chmod(path, 0o600)
        except OSError:
            pass
        return True, f"encrypted API key saved to {path}"
    finally:
        if tmp_path is not None:
            try:
                tmp_path.unlink()
            except OSError:
                pass



# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def load_config
# Reads the shared KEY=VALUE config file. This is deliberately not TOML/YAML/JSON because Bash-
# only and future C implementations must be able to follow the same rules.
# ------------------------------------------------------------
def load_config() -> Config:
    """Load ~/.config/ttychatter/openrouter/config using simple KEY=VALUE parsing.

    This path is now part of the ttychatter public contract. Keep provider
    settings under the `openrouter` subdirectory so future providers can use their
    own sibling directories without confusing user configuration. This loader is
    intentionally simple so Bash-only, Bash+Python3, Python ncurses, and future
    C implementations can all share the same behavior.
    """
    cfg = Config()
    env_api_key = os.environ.get("OPENROUTER_API_KEY", "") or os.environ.get("TTYCHATTER_API_KEY", "")
    context_turns_explicit = False

    read_config_file = cfg.config_file
    if not read_config_file.exists() and LEGACY_CONFIG_FILE.exists():
        read_config_file = LEGACY_CONFIG_FILE

    # Namespace note:
    # ttychatter AI clients read ~/.config/ttychatter/openrouter/config. Keep
    # provider configuration under this explicit AI subdirectory so future
    # providers can use sibling directories without changing the project name.

    if read_config_file.exists():
        with read_config_file.open("r", encoding="utf-8") as fh:
            for raw_line in fh:
                line = raw_line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key = key.strip()
                value = value.strip()

                if key == "MODEL":
                    cfg.model = normalize_model_id(value)
                elif key == "CONTEXT_TURNS":
                    cfg.context_turns = parse_positive_int(value, cfg.context_turns)
                    context_turns_explicit = True
                elif key == "HISTORY_LIMIT":
                    if not context_turns_explicit:
                        cfg.context_turns = parse_positive_int(value, cfg.context_turns)
                elif key in {"OPENROUTER_API_KEY", "API_KEY"}:
                    cfg.api_key = env_api_key or value
                elif key in {"API_KEY_GPG_FILE", "OPENROUTER_API_KEY_GPG_FILE"}:
                    cfg.api_key_gpg_file = expand_path(value)
                elif key == "CONFIRM_LIVE_SEND":
                    cfg.confirm_live_send = parse_bool(value, cfg.confirm_live_send)
                elif key == "SESSION_DIR":
                    cfg.session_dir = expand_path(value)
                elif key == "ATTACHMENT_DIR":
                    cfg.attachment_dir = expand_path(value)
                elif key == "EDITOR":
                    cfg.editor = value
                elif key == "GITHUB_URL":
                    cfg.github_url = value
                elif key == "MODEL_TEST_PROMPT":
                    if value:
                        cfg.model_test_prompt = value
                elif key == "MONOCHROME":
                    cfg.monochrome = parse_bool(value, cfg.monochrome)
                elif key == "INPUT_PLACEHOLDER":
                    if value:
                        cfg.input_placeholder = value
                elif key == "STARTUP_NOTICE":
                    cfg.startup_notice = parse_bool(value, cfg.startup_notice)
                elif key == "MODEL_CACHE_FILE":
                    cfg.model_cache_file = expand_path(value)
                elif key == "MODEL_FILTER_CHAT_COMPLETIONS":
                    cfg.model_filter_chat_completions = parse_bool(value, cfg.model_filter_chat_completions)
                elif key == "MODEL_FILTER_REQUIRE_TOKENS":
                    cfg.model_filter_require_tokens = parse_bool(value, cfg.model_filter_require_tokens)
                elif key == "MODEL_FILTER_HIDE_PREVIEW":
                    cfg.model_filter_hide_preview = parse_bool(value, cfg.model_filter_hide_preview)
                elif key == "MODEL_MIN_INPUT_TOKENS":
                    cfg.model_min_input_tokens = parse_nonnegative_int(value, cfg.model_min_input_tokens)
                elif key == "MODEL_MIN_OUTPUT_TOKENS":
                    cfg.model_min_output_tokens = parse_nonnegative_int(value, cfg.model_min_output_tokens)
                elif key == "MODEL_SORT_ORDER":
                    if value:
                        cfg.model_sort_order = value
                elif key == "MODEL_TYPE_FILTER":
                    if value in MODEL_TYPE_CHOICES:
                        cfg.model_type_filter = value
                elif key == "THEME":
                    # Old theme names remain readable; the terminal owns colors.
                    cfg.theme = "terminal"
                elif key == "MAX_ATTACHMENT_BYTES":
                    cfg.max_attachment_bytes = parse_nonnegative_int(value, cfg.max_attachment_bytes)
                elif key == "SEND_INPUT":
                    # Constrain this to known modes. Free-form send-key text
                    # created invalid states in earlier options screens.
                    normalized = value.strip().lower().replace("+", "_").replace("-", "_")
                    if normalized in {"enter", "ctrl_g", "ctrl_enter"}:
                        cfg.send_input = normalized
                elif key == "PROMPT_SESSION_NAME":
                    cfg.prompt_session_name = parse_bool(value, cfg.prompt_session_name)
                elif key == "CODE_ATTACHMENT_MIN_LINES":
                    cfg.code_attachment_min_lines = parse_positive_int(value, cfg.code_attachment_min_lines)
                elif key == "MODEL_FAVORITES_FILE":
                    cfg.model_favorites_file = expand_path(value)
                elif key == "DEMO_MODE":
                    cfg.demo_mode = parse_bool(value, cfg.demo_mode)
                elif key == "LOOPBACK_FILE":
                    cfg.loopback_file = expand_path(value)
                elif key == "SESSION_AUTO_TITLE":
                    cfg.session_auto_title = parse_bool(value, cfg.session_auto_title)
                elif key == "SESSION_TITLE_MODEL":
                    cfg.session_title_model = normalize_model_id(value) or cfg.session_title_model
                elif key == "SESSION_TITLE_MAX_WORDS":
                    cfg.session_title_max_words = parse_positive_int(value, cfg.session_title_max_words)
                elif key == "STREAM":
                    cfg.stream = parse_bool(value, cfg.stream)
                elif key == "INPUT_HEIGHT":
                    cfg.input_height = min(12, parse_positive_int(value, 3))
                elif key == "WEB_SEARCH":
                    cfg.web_search = parse_bool(value, cfg.web_search)
                elif key == "WEB_SEARCH_ENGINE" and value in WEB_SEARCH_ENGINES:
                    cfg.web_search_engine = value
                elif key == "WEB_SEARCH_MAX_RESULTS":
                    cfg.web_search_max_results = min(25, parse_nonnegative_int(value, 5))
                elif key == "WEB_SEARCH_MAX_USES":
                    cfg.web_search_max_uses = min(25, parse_nonnegative_int(value, 3))
                elif key == "WEB_SEARCH_MODE" and value in WEB_SEARCH_MODES:
                    cfg.web_search_mode = value
                elif key in {"AI_FILE_DOWNLOAD_MODE", "AI_DOWNLOAD"}:
                    if value.lower() in {"ask", "auto", "metadata", "off"}:
                        cfg.ai_file_download_mode = value.lower()

    if env_api_key:
        cfg.api_key = env_api_key

    if not cfg.api_key:
        cfg.api_key = decrypt_gpg_file(cfg.effective_api_key_gpg_file)
    if not cfg.api_key and LEGACY_GPG_API_KEY_FILE.exists():
        cfg.api_key = decrypt_gpg_file(LEGACY_GPG_API_KEY_FILE)

    return cfg

def write_private_text(path: Path, text: str) -> None:
    target = path.resolve()
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix='.' + target.name + '-', dir=target.parent)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(name, target)
    finally:
        try:
            os.unlink(name)
        except FileNotFoundError:
            pass


def set_config_value(cfg: Config, key: str, value: str) -> None:
    if not re.fullmatch(r'[A-Z0-9_]+', key) or '\n' in value or '\r' in value:
        raise ValueError('Configuration entries must be single KEY=VALUE lines.')
    lines = cfg.config_file.read_text(encoding='utf-8', errors='replace').splitlines() if cfg.config_file.exists() else []
    kept = [line for line in lines if line.partition('=')[0].strip() != key]
    kept.append(key + '=' + value)
    write_private_text(cfg.config_file, '\n'.join(kept) + '\n')




def remove_config_key(cfg: Config, key: str) -> None:
    if not cfg.config_file.exists():
        return
    lines = cfg.config_file.read_text(encoding='utf-8', errors='replace').splitlines()
    write_private_text(cfg.config_file, '\n'.join(line for line in lines if line.partition('=')[0].strip() != key) + '\n')


# ---------------------------------------------------------------------------
# Command-line parsing
# ---------------------------------------------------------------------------


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def parse_args
# Command-line entry point. Keep command names stable because scripts and users may depend on
# them. The full-screen UI can be rich, but CLI flags should remain predictable.
# ------------------------------------------------------------
def parse_args() -> argparse.Namespace:
    if len(sys.argv) == 2 and sys.argv[1] == "help":
        sys.argv[1] = "--help"

    parser = argparse.ArgumentParser(prog=PROGRAM, description="ncurses OpenRouter terminal chat interface")
    parser.add_argument("session_name", nargs="?", help="named session to create or open")
    parser.add_argument("--session", metavar="NAME", help="open/create NAME as an alias for the positional session operand")
    parser.add_argument("--resume", metavar="NAME", help="resume an existing named session")
    parser.add_argument("--new", action="store_true", help="force a fresh timestamped session")
    parser.add_argument("--list", action="store_true", help="list saved sessions with title metadata when present")
    parser.add_argument("--rename-session", nargs=2, metavar=("SESSION", "TITLE"), help="set the session title and safely rename its log file")
    parser.add_argument("--turns", metavar="SESSION", help="list user/assistant message numbers from a session")
    parser.add_argument("--branch", nargs=2, metavar=("SESSION", "TURN"), help="create a timestamped branch containing messages through TURN")
    parser.add_argument("--edit-turn", nargs=2, metavar=("SESSION", "TURN"), help="not implemented in ncurses; use C or ttychatter.python")
    parser.add_argument("--export", metavar="SESSION", help="export a session to stdout or --output")
    parser.add_argument("--format", choices=("markdown", "text", "json"), default="markdown", help="export format")
    parser.add_argument("--output", metavar="FILE", help="write --export output to FILE")
    parser.add_argument("--models", action="store_true", help="list cached OpenRouter chat models, fetching if cache is missing")
    parser.add_argument("--routers", action="store_true", help="list cached OpenRouter router/special entries such as openrouter/auto and openrouter/free")
    parser.add_argument("--model-type", choices=MODEL_TYPE_CHOICES, help="filter --models output by model type: all, routers, fixed, free, or auto")
    parser.add_argument("--update-models", action="store_true", help="refresh the cached OpenRouter model list and exit")
    parser.add_argument("--doctor", action="store_true", help="run diagnostics for configuration, filesystem, terminal, editor, cache, and network readiness")
    parser.add_argument("--test-model", metavar="MODEL", help="send the model-test prompt to MODEL and print the response")
    parser.add_argument("--demo", action="store_true", help="run without OpenRouter network calls using local demo responses and demo model metadata")
    parser.add_argument("--loopback-file", metavar="PATH", help="append each AI response to PATH while the ncurses UI remains interactive")
    parser.add_argument("--stream", action="store_true", help="stream assistant output into the transcript while the UI remains interactive")
    parser.add_argument("--no-stream", action="store_true", help="disable streaming for this run")
    web = parser.add_mutually_exclusive_group()
    web.add_argument('--web', action='store_true', help='enable OpenRouter web search for this run')
    web.add_argument('--no-web', action='store_true', help='disable OpenRouter web search for this run')
    parser.add_argument('--web-engine', choices=WEB_SEARCH_ENGINES, help='web search engine')
    parser.add_argument('--web-max-results', type=int, choices=range(0, 26), metavar='0..25', help='maximum results per search; 0 leaves the provider default')
    parser.add_argument('--web-max-uses', type=int, choices=range(0, 26), metavar='0..25', help='maximum server-tool search rounds; 0 imposes no ttychatter limit')
    parser.add_argument('--web-mode', choices=WEB_SEARCH_MODES, help='web compatibility: auto, server-tool, or plugin')
    parser.add_argument("--ai-download", choices=("ask", "auto", "metadata", "off"), help="AI file receipt mode for provider-returned attachments")
    parser.add_argument("--version", action="store_true", help="show version information")
    return parser.parse_args()

# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def sanitize_session_name
# Maintainer note for sanitize_session_name: this routine is part of the long-term public
# behavior of the program. When changing it, check callers, documentation, config compatibility,
# session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def sanitize_session_name(name: str) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9._-]+", "_", name.strip())
    cleaned = cleaned.strip("._-")
    return cleaned or "session"


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def default_session_name
# Maintainer note for default_session_name: this routine is part of the long-term public
# behavior of the program. When changing it, check callers, documentation, config compatibility,
# session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def default_session_name() -> str:
    return "session-" + datetime.now().strftime("%Y-%m-%d-%H-%M-%S")


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def list_sessions
# Maintainer note for list_sessions: this routine is part of the long-term public behavior of
# the program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def clean_session_title(raw: str, max_words: int = 0) -> str:
    text = re.sub(r'[\x00-\x1f\x7f]+', ' ', raw or '')
    text = re.sub(r'\s+', ' ', text).strip()
    if max_words:
        text = re.sub(r'^(session[ -]?title|title)\s*:\s*', '', text, flags=re.I)
        text = text.strip(' "\'`*.-')
        text = ' '.join(text.split()[:max_words])
    return text[:240].strip()


def session_title_from_file(path: Path, max_words: int = 0) -> str:
    title = ''
    try:
        with path.open('r', encoding='utf-8', errors='replace') as fh:
            for line in fh:
                match = re.match(r'^\[\d\d:\d\d:\d\d\] system: session-title: (.*)$', line)
                if match:
                    title = match.group(1)
    except OSError:
        return ''
    return clean_session_title(title)


def write_session_title_metadata(path: Path, title: str, max_words: int = 0) -> bool:
    clean = clean_session_title(title)
    if not clean:
        return False
    ensure_prechat_line(path)
    append_log(path, 'system', f'session-title: {clean}', now_time())
    return True


def ensure_prechat_line(path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if not path.exists() or path.stat().st_size == 0:
        path.write_text(PRECHAT_LINE + "\n", encoding="utf-8")


def session_display_title(path: Path, max_words: int = 8) -> str:
    return session_title_from_file(path, max_words) or path.stem


def list_sessions(session_dir: Path) -> None:
    session_dir.mkdir(parents=True, exist_ok=True)
    rows = sorted(session_dir.glob("*.log"))
    if not rows:
        print("no saved sessions")
        return
    print(f"{'TITLE':42} {'FILE':32} SIZE")
    print(f"{'-----':42} {'----':32} ----")
    for path in rows:
        title = session_display_title(path)
        try:
            size = path.stat().st_size
        except OSError:
            size = 0
        print(f"{title[:42]:42} {path.name[:32]:32} {size}")


def default_session_name_unique(session_dir: Path) -> str:
    base = default_session_name()
    name = base
    n = 1
    while (session_dir / f"{name}.log").exists():
        name = f"{base}-{n:03d}"
        n += 1
    return name


def is_conversation_entry(entry: LogEntry) -> bool:
    return entry.speaker.lower() != 'system' and not (
        entry.speaker == 'remfan1994' and entry.text.strip() == PROJECT_NOTICE.strip())


def real_session_messages(path: Path) -> List[LogEntry]:
    out: List[LogEntry] = []
    for entry in load_log_entries(path):
        if not is_conversation_entry(entry):
            continue
        if is_snapshot_entry(entry):
            continue
        out.append(entry)
    return out


def print_turns(path: Path) -> int:
    if not path.exists():
        print(f"session not found: {path}", file=sys.stderr)
        return 1
    print(f"{'MSG':5} {'ROLE':10} PREVIEW")
    for idx, entry in enumerate(real_session_messages(path), 1):
        role = "assistant" if entry.speaker in {"AI", "OpenRouter", "Assistant"} else "user"
        preview = re.sub(r"\s+", " ", entry.text).strip()
        if len(preview) > 88:
            preview = preview[:85] + "..."
        print(f"{idx:<5} {role:<10} {preview}")
    return 0


def branch_session_cli(cfg: Config, source_path: Path, turn_text: str) -> int:
    try:
        turn = int(turn_text)
    except ValueError:
        print("branch turn must be numeric", file=sys.stderr)
        return 2
    if not source_path.exists():
        print(f"session not found: {source_path}", file=sys.stderr)
        return 1
    name = default_session_name_unique(cfg.session_dir)
    branch = cfg.session_dir / f"{name}.log"
    ensure_prechat_line(branch)
    append_log(branch, "system", f"branch-from: {source_path}", now_time())
    append_log(branch, "system", f"branch-turn: {turn}", now_time())
    append_log(branch, "system", "branch-reason: manual-branch", now_time())
    for idx, entry in enumerate(real_session_messages(source_path), 1):
        if idx > turn:
            break
        append_log(branch, entry.speaker, entry.text, entry.timestamp)
    src_title = session_display_title(source_path)
    branch = rename_session_file(branch, f"Branch of {src_title}")
    print(branch)
    return 0


def export_session_cli(source_path: Path, fmt: str, output: Optional[str]) -> int:
    if not source_path.exists():
        print(f"session not found: {source_path}", file=sys.stderr)
        return 1
    title = session_display_title(source_path)
    messages = []
    for entry in real_session_messages(source_path):
        role = "assistant" if entry.speaker in {"AI", "OpenRouter", "Assistant"} else "user"
        messages.append({"role": role, "speaker": entry.speaker, "time": entry.timestamp, "text": entry.text})
    if fmt == "json":
        data = json.dumps({"title": title, "session": str(source_path), "messages": messages}, ensure_ascii=False, indent=2)
    elif fmt == "text":
        parts = [f"Title: {title}", f"Session: {source_path}", ""]
        for item in messages:
            label = "Assistant" if item["role"] == "assistant" else "User"
            parts.extend([label + ":", item["text"], ""])
        data = "\n".join(parts)
    else:
        parts = [f"# {title}", "", f"Source: `{source_path}`", ""]
        for item in messages:
            label = "Assistant" if item["role"] == "assistant" else "User"
            parts.extend([f"## {label}", "", item["text"], ""])
        data = "\n".join(parts)
    if output:
        out_path = expand_path(output)
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_text(data, encoding="utf-8")
    else:
        print(data)
    return 0


def generate_session_title(cfg: Config, path: Path, user_text: str, assistant_text: str) -> Optional[Path]:
    if not cfg.session_auto_title or session_title_from_file(path):
        return None
    if cfg.demo_mode:
        title = clean_session_title(user_text, cfg.session_title_max_words)
    else:
        prompt = ('Generate a concise topical session title. Reply only with the title, maximum '
                  + str(cfg.session_title_max_words) + ' words.\nUser: ' + user_text + '\nAssistant: ' + assistant_text)
        old_web, old_metadata = cfg.web_search, cfg.last_response_metadata
        try:
            cfg.web_search = False
            ok, answer = generate_with_model(cfg, cfg.session_title_model, prompt, path.stem,
                cfg.effective_attachment_dir, [], timeout=60)
        finally:
            cfg.web_search, cfg.last_response_metadata = old_web, old_metadata
        title = clean_session_title(answer.splitlines()[0] if ok and answer else '', cfg.session_title_max_words)
    if title:
        if path.parent.resolve() == cfg.session_dir.resolve():
            return rename_session_file(path, title)
        write_session_title_metadata(path, title)
        return path
    return None


# ---------------------------------------------------------------------------
# Diagnostics / doctor checks
# ---------------------------------------------------------------------------
# The doctor system is a stabilization tool. It helps users and maintainers
# distinguish application bugs from environment problems such as missing API
# keys, unwritable directories, terminal-size trouble, editor misconfiguration,
# stale model caches, and DNS failures. It is also a practical reference for
# the future native C ncurses implementation: the C version should eventually
# expose equivalent diagnostics.
# ---------------------------------------------------------------------------


@dataclass
# ------------------------------------------------------------
# MAINTAINER COMMENTARY: class DoctorResult
# Maintainer note for DoctorResult: this routine is part of the long-term public behavior of the
# program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
class DoctorResult:
    status: str
    label: str
    detail: str


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def resolve_command
# Maintainer note for resolve_command: this routine is part of the long-term public behavior of
# the program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def resolve_command(command_line: str) -> Tuple[bool, str]:
    """Resolve the executable portion of an editor/command string."""
    if not command_line.strip():
        return False, "empty command"
    try:
        parts = shlex.split(command_line)
    except ValueError as exc:
        return False, f"could not parse command: {exc}"
    if not parts:
        return False, "empty command"
    exe = parts[0]
    if "/" in exe:
        path = Path(exe).expanduser()
        if path.exists() and os.access(path, os.X_OK):
            return True, str(path)
        return False, f"not executable or not found: {path}"
    found = shutil.which(exe)
    if found:
        return True, found
    return False, f"not found in PATH: {exe}"


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def check_writable_directory
# Maintainer note for check_writable_directory: this routine is part of the long-term public
# behavior of the program. When changing it, check callers, documentation, config compatibility,
# session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def check_writable_directory(path: Path) -> Tuple[bool, str]:
    """Check whether a directory can be created and written to."""
    try:
        path.mkdir(parents=True, exist_ok=True)
        probe = path / f".ttychatter.ncurses-doctor-write-test-{os.getpid()}"
        probe.write_text("ok", encoding="utf-8")
        probe.unlink(missing_ok=True)
        return True, str(path)
    except Exception as exc:
        return False, f"{path}: {exc}"


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def check_dns
# Maintainer note for check_dns: this routine is part of the long-term public behavior of the
# program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def check_dns(hostname: str = "openrouter.ai") -> Tuple[bool, str]:
    """Check DNS resolution for the AI API host without a model request."""
    old_timeout = socket.getdefaulttimeout()
    try:
        socket.setdefaulttimeout(5)
        addresses = socket.getaddrinfo(hostname, 443)
        if not addresses:
            return False, "no addresses returned"
        sample = sorted({item[4][0] for item in addresses})[:3]
        return True, hostname if not sample else f"{hostname} -> {', '.join(sample)}"
    except Exception as exc:
        return False, str(exc)
    finally:
        socket.setdefaulttimeout(old_timeout)


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_cache_summary
# Maintainer note for model_cache_summary: this routine is part of the long-term public behavior
# of the program. When changing it, check callers, documentation, config compatibility, session-
# log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def model_cache_summary(cfg: Config) -> Tuple[bool, str]:
    """Summarize cached model-list state without contacting OpenRouter."""
    models, error, updated_at = load_model_cache(cfg)
    if error:
        return False, error
    visible = filter_model_list(cfg, models)
    return True, f"{len(visible)}/{len(models)} models visible after filters; updated {updated_at}"


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def doctor_report
# Diagnostics gather environmental facts without sending chat prompts. This helps distinguish
# app bugs from DNS, API-key, terminal-size, or filesystem problems.
# ------------------------------------------------------------
def doctor_report(cfg: Config) -> List[DoctorResult]:
    """Return diagnostics as structured rows.

    The report never prints API-key values. It does not call chat.completions.
    """
    rows: List[DoctorResult] = []

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def add
    # Maintainer note for add: this routine is part of the long-term public behavior of the
    # program. When changing it, check callers, documentation, config compatibility, session-log
    # compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def add(status: str, label: str, detail: str) -> None:
        rows.append(DoctorResult(status, label, detail))

    add("OK", "program", f"{PROGRAM} {VERSION}")
    add("OK", "python", platform.python_version())
    add("OK", "platform", platform.platform())
    add("OK", "curses", "module imported")

    term = os.environ.get("TERM", "")
    add("OK" if term else "WARN", "TERM", term or "TERM is not set")
    size = shutil.get_terminal_size(fallback=(0, 0))
    add("OK" if size.columns >= 40 and size.lines >= 12 else "WARN", "terminal-size", f"{size.columns}x{size.lines}")
    add("OK" if cfg.api_key else "WARN", "api-key", "loaded from env/config/gpg/runtime" if cfg.api_key else "not loaded; F3, OPENROUTER_API_KEY, TTYCHATTER_API_KEY, or api-key.gpg required")
    gpg_path = cfg.effective_api_key_gpg_file
    add("OK" if shutil.which("gpg") else "WARN", "gpg", "available" if shutil.which("gpg") else "not found; encrypted API-key loading unavailable")
    add("OK" if gpg_path.exists() else "WARN", "api-key.gpg", f"present: {gpg_path}" if gpg_path.exists() else f"not found: {gpg_path}")

    ok, detail = check_writable_directory(cfg.session_dir)
    add("OK" if ok else "FAIL", "session-dir", detail)
    ok, detail = check_writable_directory(cfg.effective_attachment_dir)
    add("OK" if ok else "FAIL", "attachment-dir", detail)
    ok, detail = check_writable_directory(cfg.model_cache_file.parent)
    add("OK" if ok else "FAIL", "model-cache-dir", detail)

    if cfg.config_file.exists():
        add("OK" if os.access(cfg.config_file, os.R_OK) else "FAIL", "config-file", f"readable: {cfg.config_file}")
    else:
        add("WARN", "config-file", f"not found yet: {cfg.config_file}")

    ok, detail = model_cache_summary(cfg)
    add("OK" if ok else "WARN", "model-cache", detail)

    ok, detail = resolve_command(cfg.effective_editor)
    add("OK" if ok else "WARN", "editor", f"{cfg.effective_editor} -> {detail}")

    ok, detail = check_dns()
    add("OK" if ok else "WARN", "dns", detail)
    add("WARN", "model-endpoint", "not contacted by --doctor; use --update-models to refresh cache")
    return rows


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def doctor_lines
# Maintainer note for doctor_lines: this routine is part of the long-term public behavior of the
# program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def doctor_lines(cfg: Config) -> List[str]:
    lines = [
        "ttychatter.ncurses diagnostics",
        "",
        "OK = ready, WARN = check recommended, FAIL = likely broken",
        "",
    ]
    for row in doctor_report(cfg):
        lines.append(f"[{row.status:<4}] {row.label:<18} {row.detail}")
    lines.append("")
    lines.append("This report never prints API-key values.")
    return lines


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def print_doctor
# Maintainer note for print_doctor: this routine is part of the long-term public behavior of the
# program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def print_doctor(cfg: Config) -> int:
    rows = doctor_report(cfg)
    for line in doctor_lines(cfg):
        print(line)
    return 1 if any(row.status == "FAIL" for row in rows) else 0


# ---------------------------------------------------------------------------
# AI API transport
# ---------------------------------------------------------------------------


@dataclass
# ------------------------------------------------------------
# MAINTAINER COMMENTARY: class ModelInfo
# Structured model metadata from OpenRouter listModels. The selector should rely on this metadata
# instead of guessing future model names.
# ------------------------------------------------------------
class ModelInfo:
    model_id: str
    api_name: str
    display_name: str
    description: str
    input_token_limit: Optional[int] = None
    output_token_limit: Optional[int] = None
    methods: List[str] = field(default_factory=list)


def demo_model_list() -> List[ModelInfo]:
    """Return a small local model catalog for no-network testing.

    This is deliberately not a fake provider abstraction. It is a user-facing
    safety feature: maintainers and users can test model-browser rendering,
    search, favorites, sorting, sessions, and message flow without spending
    OpenRouter requests or touching openrouter/free. Keep these rows obviously
    marked as demo rows so nobody confuses them with the live OpenRouter catalog.
    """
    return [
        ModelInfo(
            model_id="demo/auto",
            api_name="demo/auto",
            display_name="Demo Auto Router",
            description="Local demo model. No network request is made.",
            input_token_limit=8192,
            output_token_limit=1024,
            methods=["chat.completions", "router", "demo"],
        ),
        ModelInfo(
            model_id="demo/free",
            api_name="demo/free",
            display_name="Demo Free Route",
            description="Local demo row that behaves like a free/router-style model for UI testing.",
            input_token_limit=4096,
            output_token_limit=512,
            methods=["chat.completions", "router", "free", "demo"],
        ),
        ModelInfo(
            model_id="demo/code-helper",
            api_name="demo/code-helper",
            display_name="Demo Code Helper",
            description="Local demo row that returns short and long code blocks for attachment testing.",
            input_token_limit=32768,
            output_token_limit=4096,
            methods=["chat.completions", "demo"],
        ),
    ]


def demo_ai_response(prompt_text: str, attachments: List[PendingAttachment]) -> str:
    """Return a local response without contacting OpenRouter.

    The response intentionally includes one short code block and one long code
    block. That makes demo mode useful for the exact kind of release-candidate
    testing the project needs: users can verify transcript rendering, code-block
    threshold behavior, attachment extraction, session logging, and memory updates
    without sending fake prompts to OpenRouter.
    """
    attachment_note = ""
    if attachments:
        names = ", ".join(item.path.name for item in attachments)
        attachment_note = f"\n\nQueued attachment(s) seen locally: {names}."
    prompt_excerpt = prompt_text.strip().replace("\n", " ")[:140]
    return (
        "Demo mode is active; no OpenRouter request was made. "
        f"I received this local prompt excerpt: {prompt_excerpt!r}."
        + attachment_note
        + "\n\nShort inline code block:\n```text\nok\n```"
        + "\n\nLong code block for attachment-threshold testing:\n"
        + "```python\n"
        + "def demo():\n"
        + "    print('ttychatter demo mode')\n"
        + "    print('no provider request was made')\n"
        + "    print('longer code blocks should become attachments')\n"
        + "    return True\n"
        + "```"
    )


@dataclass
# ------------------------------------------------------------
