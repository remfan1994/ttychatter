    def command_items(self) -> List[Tuple[str, str, str]]:
        return [
            ('F2', 'Models', 'models'), ('F3', 'API key', 'api-key'),
            ('F4', 'Sessions', 'sessions'), ('F5', 'Options', 'options'),
            ('F6', 'Memory', 'memory'), ('F7', 'Files / attachments', 'files'),
            ('F8', 'External editor options', 'editor'), ('F9', 'About', 'credits'),
            ('', 'Name current session', 'name'),
            ('F11', 'Show or hide draft / read mode', 'toggle-input'),
            (self.send_key_label(), 'Send draft', 'send'), ('', 'Diagnostics', 'doctor'),
            ('', 'Keyboard help', 'key-help'), ('F10', 'Close session (confirm)', 'quit'),
        ]

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def run_command
    # Maintainer note for run_command: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def run_command(self, action: str) -> None:
        self.dispatch_command_action(action.replace('api_key', 'api-key'))

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_help
    # Full command menu, accessible without relying on emulator function-key bindings.
    # ------------------------------------------------------------
    def open_help(self) -> None:
        items = self.command_items()
        labels = [f'{key:<8} {label}' for key, label, action in items]
        chosen = self.choice_modal('COMMAND MENU - Esc', 'Esc is the primary menu key. Function keys remain direct screen navigation.', labels, labels[0])
        if chosen is not None:
            self.dispatch_command_action(items[labels.index(chosen)][2])

