    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_api_key_input
    # Maintainer note for open_api_key_input: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def open_api_key_input(self) -> None:
        """Open the first-class API-key entry workflow.

        Earlier builds treated GPG as a background config option while the F3
        API-key screen still looked like a plaintext-only workflow. That was a
        UX mismatch: users should see the storage choice at the moment they are
        pasting the secret. This screen therefore keeps the actual key input and
        the "Encrypt with GPG" checkbox together. If gpg is not installed, the
        checkbox is replaced by a visible "gpg not found" line so users do not
        waste time searching the options menu for a feature their system cannot
        currently use.

        Important terminal mechanics: the key is edited in-memory, masked on
        screen, and never appended to the transcript. Enter accepts. Space
        toggles the GPG checkbox if available. Function keys remain global so
        the user can escape to another feature screen without first pressing
        Esc. Saving with GPG may temporarily leave curses mode so GPG/pinentry
        can display its own prompt.
        """
        key = ""
        cursor = 0
        encrypt_with_gpg = False
        gpg_path = shutil.which("gpg")

        while True:
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            box_w = min(width - 4, 86)
            box_h = 14
            top = max(0, (height - box_h) // 2)
            left = max(0, (width - box_w) // 2)
            field_w = max(8, box_w - 8)

            masked = ("*" * max(0, len(key) - 4) + key[-4:]) if key else ""
            field_left = max(0, min(cursor - field_w + 1, max(0, len(masked) - field_w)))
            shown = masked[field_left:field_left + field_w]

            self.safe_addstr(top, left, "+" + "-" * (box_w - 2) + "+", attr=self.reverse_attr())
            self.safe_addstr(top + 1, left, "|" + "API KEY".center(box_w - 2) + "|", attr=self.reverse_attr())
            self.safe_addstr(top + 2, left, "+" + "-" * (box_w - 2) + "+", attr=self.reverse_attr())
            self.safe_addstr(top + 3, left + 2, "Paste OpenRouter API key. Runtime use is immediate; storage is your choice.", box_w - 4)
            self.safe_addstr(top + 5, left + 2, "Key:", box_w - 4)
            self.safe_addstr(top + 6, left + 2, " " * field_w, field_w, self.reverse_attr())
            self.safe_addstr(top + 6, left + 2, shown, field_w, self.reverse_attr())

            if gpg_path:
                checkbox = "[x]" if encrypt_with_gpg else "[ ]"
                self.safe_addstr(top + 8, left + 2, f"{checkbox} encrypt with gpg", box_w - 4, self.dim_attr() if not encrypt_with_gpg else self.normal_attr())
                self.safe_addstr(top + 9, left + 2, f"GPG: {gpg_path}", box_w - 4, self.dim_attr())
            else:
                self.safe_addstr(top + 8, left + 2, "[ ] encrypt with gpg  (gpg not found)", box_w - 4, self.dim_attr())
                self.safe_addstr(top + 9, left + 2, "Install gpg or set API_KEY_GPG_FILE manually after creating a key file.", box_w - 4, self.dim_attr())

            self.safe_addstr(top + 11, left + 2, "Space=toggle GPG | Enter=accept | Esc=cancel | Backspace=edit", box_w - 4, self.dim_attr())
            self.safe_addstr(top + 12, left + 2, "Plaintext save warns separately; encrypted save writes api-key.gpg.", box_w - 4, self.dim_attr())
            self.safe_addstr(top + 13, left, "+" + "-" * (box_w - 2) + "+", attr=self.reverse_attr())
            self.stdscr.refresh()

            ch = self.ui_getch()
            if self.handle_global_hotkey(ch):
                return
            if ch == ord(" "):
                if gpg_path:
                    encrypt_with_gpg = not encrypt_with_gpg
                else:
                    self.status = "gpg not found; encrypted API-key storage unavailable"
                continue
            if ch in (10, 13, curses.KEY_ENTER):
                key = key.strip()
                if not key:
                    self.status = "API key entry cancelled: empty key"
                    return
                self.cfg.api_key = key
                if encrypt_with_gpg:
                    ok, message = save_gpg_encrypted_api_key(key, self.cfg.effective_api_key_gpg_file)
                    if ok:
                        set_config_value(self.cfg, "API_KEY_GPG_FILE", str(self.cfg.effective_api_key_gpg_file))
                        remove_config_key(self.cfg, "OPENROUTER_API_KEY")
                        remove_config_key(self.cfg, "TTYCHATTER_API_KEY")
                    self.status = message
                    return

                if self.ask_yes_no("SAVE PLAINTEXT API KEY", "Key stored in plaintext if saved. Save OPENROUTER_API_KEY to config? Default is no.", default=False):
                    set_config_value(self.cfg, "OPENROUTER_API_KEY", key)
                    self.status = "API key saved to config in plaintext"
                else:
                    self.status = "API key active for this run only"
                return
            if ch == 27:
                self.status = "API key entry cancelled"
                return
            if ch in (curses.KEY_BACKSPACE, 127, 8):
                if cursor > 0:
                    key = key[: cursor - 1] + key[cursor:]
                    cursor -= 1
            elif ch == curses.KEY_DC:
                if cursor < len(key):
                    key = key[:cursor] + key[cursor + 1:]
            elif ch == curses.KEY_LEFT:
                cursor = max(0, cursor - 1)
            elif ch == curses.KEY_RIGHT:
                cursor = min(len(key), cursor + 1)
            elif ch == curses.KEY_HOME:
                cursor = 0
            elif ch == curses.KEY_END:
                cursor = len(key)
            elif 32 <= ch <= 126:
                key = key[:cursor] + chr(ch) + key[cursor:]
                cursor += 1

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def show_model_info
    # Maintainer note for show_model_info: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def show_model_info(self, model: ModelInfo) -> None:
        self.show_message("MODEL INFO", [
            f"Model ID: {model.model_id}",
            f"API name: {model.api_name}",
            f"Display name: {model.display_name}",
            f"Input token limit: {model.input_token_limit}",
            f"Output token limit: {model.output_token_limit}",
            f"Methods: {', '.join(model.methods)}",
            "",
            model.description or "No description returned by API.",
        ])

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def test_model_interactive
    # Maintainer note for test_model_interactive: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def test_model_interactive(self, model: ModelInfo) -> None:
        if not self.cfg.api_key:
            self.show_message("MODEL TEST", ["No API key loaded. Press F3 first."])
            return
        self.status = f"testing model: {model.model_id}"
        self.draw()
        ok, text = generate_with_model(self.cfg, model.model_id, self.cfg.model_test_prompt, self.session_name, self.attachment_dir, [], timeout=60)
        lines = ["Prompt sent:", self.cfg.model_test_prompt, "", "Model response:", text]
        self.show_message("MODEL TEST RESULT", lines)
        if ok and self.ask_yes_no("ACTIVATE MODEL", f"Activate {model.model_id} for this run?", default=True):
            self.cfg.model = model.model_id
            self.transcript.append(TranscriptItem("system", f"Model activated after test: {model.model_id}"))
            self.status = f"activated model: {model.model_id}"
            if self.ask_yes_no("SAVE MODEL", f"Save MODEL={model.model_id} to config?", default=True):
                set_config_value(self.cfg, "MODEL", model.model_id)
                self.status = f"model saved: {model.model_id}"

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_model_selector
    # F2 model workflow. It should separate local cached viewing from explicit network refreshes
    # and keep testing user-operated.
    # ------------------------------------------------------------
    def open_model_selector(self) -> None:
        """Open a local model-management menu without network access.

        Earlier releases immediately fetched OpenRouter's model list when F2 was
        pressed. That was surprising, especially offline or on limited quota.
        F2 now opens a local menu first. The user explicitly chooses whether
        to use the cached list or update the list from OpenRouter.
        """
        selected = 0
        while True:
            models_cached, cache_error, updated_at = load_model_cache(self.cfg)
            cached_label = f"cached model list ({len(models_cached)} models, updated {updated_at})" if models_cached else "cached model list unavailable"
            filter_label = model_filter_summary(self.cfg, len(models_cached), len(filter_model_list(self.cfg, models_cached))) if models_cached else model_filter_summary(self.cfg, 0, 0)
            actions = [
                ("c", f"Open {cached_label}", "cached"),
                ("u", "Update model list from OpenRouter", "update"),
                ("f", f"Model filters: {filter_label}", "filters"),
                ("r", "Router shortcuts (openrouter/auto, openrouter/free, discovered routers)", "routers"),
                ("t", f"Test current model: {self.model_label()}", "test-current"),
                ("e", "Enter model ID manually", "enter"),
                ("s", f"Save current model: {self.model_label()}", "save-current"),
                ("q", "Return to chat", "return"),
            ]

            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 6)
            self.safe_addstr(0, 0, "MODEL MENU", width, self.reverse_attr())
            self.safe_addstr(1, 0, "Cached list is preferred. Updating contacts OpenRouter only after confirmation.", width, self.dim_attr())
            self.safe_addstr(2, 0, f"Current model: {self.model_label()}", width)
            self.safe_addstr(3, 0, "Enter/click=choose | f=filters | F-keys jump screens | Esc/q=return", width, self.dim_attr())
            self.safe_addstr(4, 0, "_" * width, width, self.dim_attr())

            selected = max(0, min(selected, len(actions) - 1))
            for row, (key, label, _action) in enumerate(actions[:visible_h]):
                attr = self.reverse_attr() if row == selected else 0
                self.safe_addstr(5 + row, 0, f"{key}  {label}", width, attr)

            self.stdscr.refresh()
            ch = self.ui_getch()
            if self.handle_global_hotkey(ch, current_action="models"):
                return
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - 1)
                    continue
                if delta < 0:
                    selected = min(len(actions) - 1, selected + 1)
                    continue
                if self.mouse_button1(state) and 5 <= y < 5 + len(actions):
                    selected = y - 5
                    ch = 10
                else:
                    continue
            if ch in (27, ord("q"), ord("Q")):
                self.status = "model menu closed"
                return
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
                continue
            if ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(actions) - 1, selected + 1)
                continue
            if ch not in (10, 13, curses.KEY_ENTER):
                for idx, (key, _label, _action) in enumerate(actions):
                    if ch in (ord(key), ord(key.upper())):
                        selected = idx
                        ch = 10
                        break
            if ch not in (10, 13, curses.KEY_ENTER):
                continue

            action = actions[selected][2]
            if action == "return":
                self.status = "model menu closed"
                return
            if action == "update":
                if not self.cfg.api_key:
                    self.show_message("MODEL LIST", ["No API key loaded. Press F3 to paste one."])
                    continue
                if not self.ask_yes_no("UPDATE MODEL LIST", "This will connect to OpenRouter and refresh the cached model list. Continue?", default=False):
                    self.status = "model list update cancelled"
                    continue
                self.status = "loading model list from OpenRouter..."
                self.draw()
                models, error = fetch_models(self.cfg)
                if error:
                    self.show_message("MODEL LIST ERROR", [
                        error,
                        "",
                        "If this is a DNS/network error, verify that the Linux container is online and can resolve openrouter.ai.",
                    ])
                    self.status = "model list failed"
                    continue
                save_model_cache(self.cfg, models)
                self.status = f"model list updated: {len(models)} models"
                self.open_model_list_selector(models, source_label="OpenRouter live list")
                return
            if action == "cached":
                if cache_error:
                    self.show_message("MODEL CACHE", [cache_error])
                    continue
                self.open_model_list_selector(models_cached, source_label=f"cached list updated {updated_at}")
                return
            if action == "filters":
                self.open_model_filter_menu()
                continue
            if action == "routers":
                self.open_router_shortcuts(models_cached if models_cached else [])
                continue
            if action == "test-current":
                model = ModelInfo(
                    model_id=normalize_model_id(self.cfg.effective_model),
                    api_name="",
                    display_name=normalize_model_id(self.cfg.effective_model),
                    description="Current configured/fallback model.",
                )
                self.test_model_interactive(model)
                continue
            if action == "enter":
                new_model = self.text_input_modal("ENTER MODEL ID", "Enter exact OpenRouter model ID:", self.cfg.model or self.cfg.effective_model)
                if new_model:
                    self.cfg.model = normalize_model_id(new_model)
                    self.transcript.append(TranscriptItem("system", f"Model entered manually: {self.cfg.model}"))
                    self.status = f"model activated: {self.cfg.model}"
                    if self.ask_yes_no("SAVE MODEL", f"Save MODEL={self.cfg.model} to config?", default=True):
                        set_config_value(self.cfg, "MODEL", self.cfg.model)
                        self.status = f"model saved: {self.cfg.model}"
                continue
            if action == "save-current":
                set_config_value(self.cfg, "MODEL", normalize_model_id(self.cfg.effective_model))
                self.status = f"model saved: {normalize_model_id(self.cfg.effective_model)}"
                continue

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_router_shortcuts
    # Router shortcuts are OpenRouter-specific navigation aids.  They are kept
    # separate from ordinary fixed models because openrouter/auto and
    # openrouter/free are not normal model IDs in the user's mental model: they
    # are routing choices.  This screen therefore gives the user a small,
    # explicit dropdown-style list before they dive into the full model table.
    # The list includes the two well-known routers plus any additional cached
    # OpenRouter router rows discovered from the model catalog.
    # ------------------------------------------------------------
    def open_router_shortcuts(self, cached_models: List[ModelInfo]) -> None:
        base = ["openrouter/auto", "openrouter/free"]
        discovered = [m.model_id for m in cached_models if model_type_label(m) in {"router", "free", "auto"}]
        choices = []
        for item in base + discovered:
            if item and item not in choices:
                choices.append(item)
        if not choices:
            choices = base
        chosen = self.choice_modal(
            "ROUTER / SPECIAL MODEL",
            "Choose an OpenRouter router/special entry. Routers are provider-defined selection policies, not fixed models.",
            choices,
            self.cfg.effective_model,
        )
        if not chosen:
            return
        self.cfg.model = normalize_model_id(chosen)
        self.transcript.append(TranscriptItem("system", f"Router/model selected: {self.cfg.model}"))
        self.status = f"activated router/model: {self.cfg.model}"
        if self.ask_yes_no("SAVE MODEL", f"Save MODEL={self.cfg.model} to config?", default=True):
            set_config_value(self.cfg, "MODEL", self.cfg.model)
            self.status = f"saved MODEL={self.cfg.model}"

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_model_filter_menu
    # Maintainer note for open_model_filter_menu: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def open_model_filter_menu(self) -> None:
        """Edit model-list metadata filters.

        These settings use only the model-list metadata returned by OpenRouter:
        supportedGenerationMethods, token limits, names, and descriptions. No
        model generation requests are sent from this screen.
        """
        selected = 0
        sort_orders = ["favorites", "type", "api", "name", "display", "input-desc", "output-desc"]

        while True:
            rows = [
                ("MODEL_FILTER_CHAT_COMPLETIONS", "bool", "Require chat.completions support", self.cfg.model_filter_chat_completions),
                ("MODEL_FILTER_REQUIRE_TOKENS", "bool", "Require input/output token limits > 0", self.cfg.model_filter_require_tokens),
                ("MODEL_FILTER_HIDE_PREVIEW", "bool", "Hide preview/experimental/beta models", self.cfg.model_filter_hide_preview),
                ("MODEL_MIN_INPUT_TOKENS", "int", "Minimum input tokens", str(self.cfg.model_min_input_tokens)),
                ("MODEL_MIN_OUTPUT_TOKENS", "int", "Minimum output tokens", str(self.cfg.model_min_output_tokens)),
                ("MODEL_SORT_ORDER", "choice", "Sort order", self.cfg.model_sort_order),
                ("MODEL_TYPE_FILTER", "choice", "Model type", self.cfg.model_type_filter),
            ]
            selected = max(0, min(selected, len(rows) - 1))
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 6)
            self.safe_addstr(0, 0, "MODEL FILTERS", width, self.reverse_attr())
            self.safe_addstr(1, 0, "Space/Enter=toggle/cycle/edit | Esc/q=back | F-keys jump", width, self.dim_attr())
            self.safe_addstr(2, 0, "Uses OpenRouter model metadata; does not test/probe models.", width, self.dim_attr())
            self.safe_addstr(3, 0, "_" * width, width, self.dim_attr())

            for row in range(visible_h):
                idx = row
                if idx >= len(rows):
                    break
                _key, kind, label, value = rows[idx]
                attr = self.reverse_attr() if idx == selected else 0
                if kind == "bool":
                    mark = "[x]" if value else "[ ]"
                    line = f"{mark} {label}"
                else:
                    line = f"{label:<42} [{value}]"
                self.safe_addstr(4 + row, 0, line, width, attr)
            self.safe_addstr(height - 1, 0, "Model tests remain user-operated with t on one highlighted model.", width, self.dim_attr())
            self.stdscr.refresh()
            ch = self.ui_getch()
            if self.handle_global_hotkey(ch, current_action="models"):
                return
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - 1)
                    continue
                if delta < 0:
                    selected = min(len(rows) - 1, selected + 1)
                    continue
                if self.mouse_button1(state) and 4 <= y < 4 + len(rows):
                    selected = y - 4
                    ch = 10
                else:
                    continue
            if ch in (27, ord("q"), ord("Q")):
                self.status = "model filters closed"
                return
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
                continue
            if ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(rows) - 1, selected + 1)
                continue
            if ch not in (10, 13, curses.KEY_ENTER, ord(" ")):
                continue

            key, kind, _label, value = rows[selected]
            if kind == "bool":
                new_value = not bool(value)
                if key == "MODEL_FILTER_CHAT_COMPLETIONS":
                    self.cfg.model_filter_chat_completions = new_value
                elif key == "MODEL_FILTER_REQUIRE_TOKENS":
                    self.cfg.model_filter_require_tokens = new_value
                elif key == "MODEL_FILTER_HIDE_PREVIEW":
                    self.cfg.model_filter_hide_preview = new_value
                set_config_value(self.cfg, key, "1" if new_value else "0")
                self.status = f"saved {key}"
            elif kind == "choice":
                if key == "MODEL_SORT_ORDER":
                    current_idx = sort_orders.index(self.cfg.model_sort_order) if self.cfg.model_sort_order in sort_orders else 0
                    self.cfg.model_sort_order = sort_orders[(current_idx + 1) % len(sort_orders)]
                    set_config_value(self.cfg, key, self.cfg.model_sort_order)
                    self.status = f"saved {key}={self.cfg.model_sort_order}"
                elif key == "MODEL_TYPE_FILTER":
                    current_idx = MODEL_TYPE_CHOICES.index(self.cfg.model_type_filter) if self.cfg.model_type_filter in MODEL_TYPE_CHOICES else 0
                    self.cfg.model_type_filter = MODEL_TYPE_CHOICES[(current_idx + 1) % len(MODEL_TYPE_CHOICES)]
                    set_config_value(self.cfg, key, self.cfg.model_type_filter)
                    self.status = f"saved {key}={self.cfg.model_type_filter}"
            else:
                new_text = self.text_input_modal("MODEL FILTER", f"Edit {key}:", str(value))
                if new_text is not None:
                    if key == "MODEL_MIN_INPUT_TOKENS":
                        self.cfg.model_min_input_tokens = parse_positive_int(new_text, self.cfg.model_min_input_tokens)
                        set_config_value(self.cfg, key, str(self.cfg.model_min_input_tokens))
                    elif key == "MODEL_MIN_OUTPUT_TOKENS":
                        self.cfg.model_min_output_tokens = parse_positive_int(new_text, self.cfg.model_min_output_tokens)
                        set_config_value(self.cfg, key, str(self.cfg.model_min_output_tokens))
                    self.status = f"saved {key}"


    def load_model_favorites(self) -> set[str]:
        """Read persistent favorite model IDs.

        Favorites are intentionally stored as one model ID per line. That keeps
        them editable by humans and portable to Bash/C editions without JSON.
        """
        path = self.cfg.effective_model_favorites_file
        if not path.exists():
            legacy = path.with_name("model-favorites.txt")
            if legacy.exists():
                try:
                    path.parent.mkdir(parents=True, exist_ok=True)
                    path.write_text(legacy.read_text(encoding="utf-8", errors="replace"), encoding="utf-8")
                except OSError:
                    path = legacy
            else:
                return set()
        return {line.strip() for line in path.read_text(encoding="utf-8", errors="replace").splitlines() if line.strip()}

    def save_model_favorites(self, favorites: set[str]) -> None:
        path = self.cfg.effective_model_favorites_file
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text("\n".join(sorted(favorites)) + ("\n" if favorites else ""), encoding="utf-8")

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_model_list_selector
    # Maintainer note for open_model_list_selector: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def open_model_list_selector(self, models: List[ModelInfo], source_label: str = "model list") -> None:
        """Browse, search, favorite, sort, test, activate, and save models.

        This deliberately resembles old file/server browsers: a table of rows,
        a search string, visible metadata, keyboard/mouse navigation, and a few
        commands that operate on the highlighted row.  The model list is not a
        magic recommendation engine. It exposes provider metadata and lets the
        user decide.
        """
        if not models:
            self.show_message("MODEL BROWSER", ["No models available."])
            return

        raw_models = list(models)
        selected = 0
        top_index = 0
        search = ""
        favorites = self.load_model_favorites()
        sort_modes = ["favorites", "name", "input-desc", "output-desc", "api"]

        while True:
            filtered = filter_model_list(self.cfg, raw_models)
            if search:
                needle = search.lower()
                filtered = [m for m in filtered if needle in m.model_id.lower() or needle in m.display_name.lower() or needle in m.description.lower()]
            if self.cfg.model_sort_order == "favorites":
                filtered = sorted(filtered, key=lambda m: (m.model_id not in favorites, m.model_id.lower()))
            current = normalize_model_id(self.cfg.effective_model)

            if not filtered:
                self.stdscr.erase()
                height, width = self.stdscr.getmaxyx()
                self.safe_addstr(0, 0, "MODEL BROWSER", width, self.reverse_attr())
                self.safe_addstr(1, 0, f"Source: {source_label}", width, self.dim_attr())
                self.safe_addstr(2, 0, f"Search: {search or '(none)'}", width, self.dim_attr())
                self.safe_addstr(4, 0, "No models match active filters/search.", width)
                self.safe_addstr(6, 0, "/=search | f=filters | Esc/q=back | F-keys jump", width, self.dim_attr())
                self.stdscr.refresh()
                ch = self.ui_getch()
                if self.handle_global_hotkey(ch, current_action="models"):
                    return
                if ch in (27, ord("q"), ord("Q")):
                    return
                if ch == ord("/"):
                    value = self.text_input_modal("MODEL SEARCH", "Search model IDs, names, descriptions:", search)
                    if value is not None:
                        search = value.strip()
                if ch in (ord("f"), ord("F")):
                    self.open_model_filter_menu()
                continue

            selected = max(0, min(selected, len(filtered) - 1))
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 9)
            self.safe_addstr(0, 0, "MODEL BROWSER", width, self.reverse_attr())
            self.safe_addstr(1, 0, f"Source: {source_label} | Search: {search or '(none)'} | Sort: {self.cfg.model_sort_order}", width, self.dim_attr())
            self.safe_addstr(2, 0, "/=search | b=favorite | o/O=sort +/- | t=test | i=info | s=save | Enter=activate", width, self.dim_attr())
            self.safe_addstr(3, 0, "Fav  Type    Model                              InTok     OutTok    Features", width, self.reverse_dim_attr())
            self.safe_addstr(4, 0, "_" * width, width, self.dim_attr())

            if selected < top_index:
                top_index = selected
            elif selected >= top_index + visible_h:
                top_index = selected - visible_h + 1
            top_index = max(0, min(top_index, max(0, len(filtered) - visible_h)))

            for row in range(visible_h):
                model_index = top_index + row
                if model_index >= len(filtered):
                    break
                model = filtered[model_index]
                fav = "*" if model.model_id in favorites else " "
                model_text = model.model_id[:38]
                in_tok = str(model.input_token_limit or "?")[:8]
                out_tok = str(model.output_token_limit or "?")[:8]
                kind = model_type_label(model)[:7]
                badges = model_badges(model)[:24]
                line = f" {fav}   {kind:<7} {model_text:<34} {in_tok:>8} {out_tok:>8}  {badges}"
                attr = self.reverse_attr() if model_index == selected else 0
                if model.model_id == current and attr == 0:
                    attr = self.dim_attr()
                self.safe_addstr(5 + row, 0, line, width, attr)

            self.safe_addstr(height - 2, 0, "_" * width, width, self.dim_attr())
            self.safe_addstr(height - 1, 0, f"{selected + 1}/{len(filtered)} shown; {len(raw_models)} total; {len(favorites)} favorites", width, self.dim_attr())
            self.stdscr.refresh()
            ch = self.ui_getch()
            if self.handle_global_hotkey(ch, current_action="models"):
                return
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - MOUSE_SCROLL_LINES)
                    continue
                if delta < 0:
                    selected = min(len(filtered) - 1, selected + MOUSE_SCROLL_LINES)
                    continue
                if self.mouse_button1(state) and 5 <= y < 5 + visible_h:
                    idx = top_index + (y - 5)
                    if 0 <= idx < len(filtered):
                        selected = idx
                        if self.mouse_button1_double(state):
                            self.cfg.model = filtered[selected].model_id
                            self.status = f"activated model: {self.cfg.model}"
                            return
                    continue
            if ch in (27, ord("q"), ord("Q")):
                self.status = "model browser closed"
                return
            if ch in (ord("/"),):
                value = self.text_input_modal("MODEL SEARCH", "Search model IDs, names, descriptions:", search)
                if value is not None:
                    search = value.strip()
                    selected = 0
                    top_index = 0
                continue
            if ch in (ord("b"), ord("B")):
                mid = filtered[selected].model_id
                if mid in favorites:
                    favorites.remove(mid)
                    self.status = f"removed favorite: {mid}"
                else:
                    favorites.add(mid)
                    self.status = f"added favorite: {mid}"
                self.save_model_favorites(favorites)
                continue
            if ch in (ord("o"), ord("O")):
                try:
                    idx = sort_modes.index(self.cfg.model_sort_order)
                except ValueError:
                    idx = 0
                # Model browsing should feel like an old server/file browser:
                # one key cycles sort modes forward, and Shift+O walks the same
                # cycle backward.  This is faster than entering the options
                # screen when the user is actively comparing model rows.
                delta = -1 if ch == ord("O") else 1
                self.cfg.model_sort_order = sort_modes[(idx + delta) % len(sort_modes)]
                set_config_value(self.cfg, "MODEL_SORT_ORDER", self.cfg.model_sort_order)
                self.status = f"model sort: {self.cfg.model_sort_order}"
                selected = 0
                top_index = 0
                continue
            if ch in (ord("f"), ord("F")):
                self.open_model_filter_menu()
                continue
            if ch in (ord("i"), ord("I")):
                self.show_model_info(filtered[selected])
                continue
            if ch in (ord("t"), ord("T")):
                self.test_model_interactive(filtered[selected])
                continue
            if ch in (ord("s"), ord("S")):
                set_config_value(self.cfg, "MODEL", filtered[selected].model_id)
                self.status = f"model saved: {filtered[selected].model_id}"
                return
            if ch in (10, 13, curses.KEY_ENTER):
                self.cfg.model = filtered[selected].model_id
                self.status = f"activated model: {self.cfg.model}"
                self.transcript.append(TranscriptItem("system", f"Model activated: {self.cfg.model}"))
                return
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
            elif ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(filtered) - 1, selected + 1)
            elif ch == curses.KEY_PPAGE:
                selected = max(0, selected - visible_h)
            elif ch == curses.KEY_NPAGE:
                selected = min(len(filtered) - 1, selected + visible_h)
            elif ch == curses.KEY_HOME:
                selected = 0
            elif ch == curses.KEY_END:
                selected = len(filtered) - 1

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def session_names
    # Maintainer note for session_names: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def session_names(self) -> List[str]:
        self.cfg.session_dir.mkdir(parents=True, exist_ok=True)
        return sorted(path.stem for path in self.cfg.session_dir.glob("*.log"))

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def rename_session
    # Maintainer note for rename_session: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def rename_session(self, old_name: str, new_name: str) -> None:
        if self._request_active and old_name == self.session_name:
            self.show_message('REQUEST ACTIVE', ['The current session cannot be renamed while its response is in flight.'])
            return
        old_path = self.session_path if old_name == self.session_name else self.cfg.session_dir / (old_name + '.log')
        try:
            new_path = rename_session_file(old_path, new_name)
            if old_path == self.session_path:
                self.session_path, self.session_name = new_path, new_path.stem
                self.session_title = session_title_from_file(new_path)
            self.status = 'Session named: ' + session_title_from_file(new_path)
        except (OSError, ValueError) as exc:
            self.show_message('NAME SESSION', [str(exc)])


    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_session_browser
    # Maintainer note for open_session_browser: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def session_records(self, sort_mode: str = 'newest', title_query: str = '', content_query: str = '') -> List[Tuple[str, Path, str, float]]:
        """Return session rows with filtering and deterministic sort order."""
        self.cfg.session_dir.mkdir(parents=True, exist_ok=True)
        tq = title_query.casefold().strip()
        cq = content_query.casefold().strip()
        rows = []
        for path in self.cfg.session_dir.glob('*.log'):
            if path.is_symlink() or not path.is_file():
                continue
            title = session_display_title(path, self.cfg.session_title_max_words)
            if tq and tq not in (title + ' ' + path.stem).casefold():
                continue
            if cq and not self.session_file_contains(path, cq):
                continue
            try:
                stamp = path.stat().st_mtime
            except OSError:
                stamp = 0.0
            rows.append((path.stem, path, title, stamp))
        if sort_mode == 'oldest':
            rows.sort(key=lambda row: (row[3], row[0].casefold()))
        elif sort_mode == 'title-a-z':
            rows.sort(key=lambda row: (row[2].casefold(), -row[3], row[0].casefold()))
        elif sort_mode == 'title-z-a':
            rows.sort(key=lambda row: (row[2].casefold(), row[3], row[0].casefold()), reverse=True)
        elif sort_mode == 'filename-a-z':
            rows.sort(key=lambda row: row[0].casefold())
        elif sort_mode == 'filename-z-a':
            rows.sort(key=lambda row: row[0].casefold(), reverse=True)
        else:
            rows.sort(key=lambda row: (row[3], row[0].casefold()), reverse=True)
        return rows

    def session_file_contains(self, path: Path, needle_casefold: str) -> bool:
        """Case-insensitive streaming search so advanced search does not load huge logs at once."""
        if not needle_casefold:
            return True
        carry = ''
        overlap = max(0, len(needle_casefold) - 1)
        try:
            with path.open('r', encoding='utf-8', errors='replace') as fh:
                while True:
                    chunk = fh.read(65536)
                    if not chunk:
                        return False
                    haystack = (carry + chunk).casefold()
                    if needle_casefold in haystack:
                        return True
                    carry = haystack[-overlap:] if overlap else ''
        except OSError:
            return False

    def open_session_browser(self) -> None:
        selected = 0
        top_index = 0
        sort_mode = 'newest'
        title_query = ''
        content_query = ''
        sort_choices = ['newest', 'oldest', 'title-a-z', 'title-z-a', 'filename-a-z', 'filename-z-a']
        while True:
            rows = self.session_records(sort_mode, title_query, content_query)
            if not rows:
                if title_query or content_query:
                    self.show_message('SESSIONS', ['No sessions match the current search.', 'Clear or change the search to continue.'])
                    title_query = ''
                    content_query = ''
                    selected = top_index = 0
                    continue
                self.show_message('SESSIONS', ['No sessions found.'])
                return
            selected = min(selected, len(rows) - 1)
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 7)
            self.safe_addstr(0, 0, 'SESSION BROWSER', width, self.reverse_attr())
            self.safe_addstr(1, 0, 'Enter=switch | s=sort | /=title search | f=full-text search | x=clear search | a=new | r=retitle', width, self.dim_attr())
            filters = []
            if title_query:
                filters.append('title=' + title_query)
            if content_query:
                filters.append('content=' + content_query)
            self.safe_addstr(2, 0, 'Sort: ' + sort_mode + (' | ' + ' | '.join(filters) if filters else ''), width)
            self.safe_addstr(3, 0, 'Current: ' + self.session_name + (' | response in flight' if self._request_active else ''), width)
            self.safe_addstr(4, 0, '_' * width, width, self.dim_attr())
            if selected < top_index:
                top_index = selected
            elif selected >= top_index + visible_h:
                top_index = selected - visible_h + 1
            top_index = max(0, min(top_index, max(0, len(rows) - visible_h)))
            for row_no in range(visible_h):
                idx = top_index + row_no
                if idx >= len(rows):
                    break
                name, _path, title, stamp = rows[idx]
                marker = '* ' if name == self.session_name else '  '
                label = f'{title}  ({name})' if title != name else name
                attr = self.reverse_attr() if idx == selected else 0
                self.safe_addstr(5 + row_no, 0, marker + label, width, attr)
            self.safe_addstr(height - 1, 0, f'{selected + 1}/{len(rows)} | Esc/q=return | j/k move | PgUp/PgDn', width, self.dim_attr())
            self.stdscr.refresh()
            ch = self.ui_getch()
            if self.handle_global_hotkey(ch, current_action='sessions'):
                return
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - MOUSE_SCROLL_LINES)
                elif delta < 0:
                    selected = min(len(rows) - 1, selected + MOUSE_SCROLL_LINES)
                elif self.mouse_button1(state) and 5 <= y < 5 + visible_h:
                    idx = top_index + (y - 5)
                    if 0 <= idx < len(rows):
                        selected = idx
                continue
            if ch in (27, ord('q'), ord('Q')):
                return
            if ch in (ord('s'), ord('S')):
                picked = self.choice_modal('SESSION SORT', 'Choose how the session browser is ordered.', sort_choices, sort_mode)
                if picked:
                    sort_mode = picked
                    selected = top_index = 0
                continue
            if ch == ord('/'):
                value = self.text_input_modal('SESSION TITLE SEARCH', 'Case-insensitive substring in friendly title or filename. Blank clears.', title_query)
                if value is not None:
                    title_query = value.strip()
                    selected = top_index = 0
                continue
            if ch in (ord('f'), ord('F')):
                value = self.text_input_modal('SESSION FULL-TEXT SEARCH', 'Search inside session log files. Case-insensitive substring. Blank clears.', content_query)
                if value is not None:
                    content_query = value.strip()
                    selected = top_index = 0
                continue
            if ch in (ord('x'), ord('X')):
                title_query = content_query = ''
                selected = top_index = 0
                continue
            if ch in (10, 13, curses.KEY_ENTER):
                if self._request_active:
                    self.show_message('REQUEST ACTIVE', ['The response continues in the current session.', 'Session switching is disabled until it completes so the reply cannot be written to the wrong log.'])
                    continue
                name, path, _title, _stamp = rows[selected]
                self.reset_to_session(name, path)
                return
            if ch in (ord('a'), ord('A')):
                if self._request_active:
                    self.show_message('REQUEST ACTIVE', ['Finish the current response before creating or switching sessions.'])
                    continue
                new = self.text_input_modal('NEW SESSION', 'Name this new chat session (blank for timestamp):', '')
                if new is None:
                    continue
                name = default_session_name_unique(self.cfg.session_dir)
                path = self.cfg.session_dir / (name + '.log')
                ensure_session_id(path)
                if new.strip():
                    path = rename_session_file(path, new)
                self.reset_to_session(path.stem, path)
                return
            if ch in (ord('d'), ord('D')):
                if self._request_active:
                    self.show_message('REQUEST ACTIVE', ['Session deletion is disabled while a response is in flight.'])
                    continue
                victim, path, _title, _stamp = rows[selected]
                if not self.ask_yes_no('DELETE SESSION', f'Delete session log {victim}.log?', default=False):
                    continue
                try:
                    path.unlink()
                    self.status = f'deleted session: {victim}'
                    if victim == self.session_name:
                        name = default_session_name_unique(self.cfg.session_dir)
                        self.reset_to_session(name, self.cfg.session_dir / f'{name}.log')
                        return
                except OSError as exc:
                    self.show_message('DELETE SESSION', [f'Could not delete {victim}: {exc}'])
                selected = min(selected, max(0, len(rows) - 2))
                continue
            if ch in (ord('r'), ord('R')):
                old, path, title, _stamp = rows[selected]
                if self._request_active and old == self.session_name:
                    self.show_message('REQUEST ACTIVE', ['The active session cannot be retitled until its response completes.'])
                    continue
                new = self.text_input_modal('RETITLE SESSION', f"Friendly title for '{old}':", title)
                if new:
                    self.rename_session(old, new)
                continue
            if ch in (curses.KEY_UP, ord('k'), ord('K')):
                selected = max(0, selected - 1)
            elif ch in (curses.KEY_DOWN, ord('j'), ord('J')):
                selected = min(len(rows) - 1, selected + 1)
            elif ch == curses.KEY_PPAGE:
                selected = max(0, selected - visible_h)
            elif ch == curses.KEY_NPAGE:
                selected = min(len(rows) - 1, selected + visible_h)
            elif ch == curses.KEY_HOME:
                selected = 0
            elif ch == curses.KEY_END:
                selected = len(rows) - 1

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def choice_modal
    #
    # Choice values such as SEND_INPUT should never force users to remember and
    # type magic strings.  In a terminal UI, a setting with a small legal value
    # set should look and behave like an old options dialog: move to the row,
    # press Enter, select from a list.  This helper is intentionally tiny but it
    # centralizes that behavior so future option fields do not quietly degrade
    # into free-form text entry again.
    #
    # Navigation mirrors the rest of ttychatter: arrows, j/k, PgUp/PgDn,
    # Home/End, mousewheel, row click, Enter.  Function keys remain global even
    # inside this chooser so a mistaken key does not trap the user.
    # ------------------------------------------------------------
    def choice_modal(self, title: str, prompt: str, choices: List[str], current: str) -> Optional[str]:
        if not choices:
            return None
        selected = choices.index(current) if current in choices else 0
        top_index = 0
        while True:
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 6)
            self.safe_addstr(0, 0, title, width, self.reverse_attr())
            self.safe_addstr(1, 0, prompt, width, self.dim_attr())
            self.safe_addstr(2, 0, "Enter/click=choose | j/k move | Esc/q=cancel | F-keys jump", width, self.dim_attr())
            self.safe_addstr(3, 0, "_" * width, width, self.dim_attr())

            if selected < top_index:
                top_index = selected
            elif selected >= top_index + visible_h:
                top_index = selected - visible_h + 1
            top_index = max(0, min(top_index, max(0, len(choices) - visible_h)))

            for row in range(visible_h):
                idx = top_index + row
                if idx >= len(choices):
                    break
                mark = "* " if choices[idx] == current else "  "
                attr = self.reverse_attr() if idx == selected else 0
                self.safe_addstr(4 + row, 0, mark + choices[idx], width, attr)

            self.safe_addstr(height - 1, 0, f"{selected + 1}/{len(choices)}", width, self.reverse_dim_attr())
            self.stdscr.refresh()
            ch = self.ui_getch()
            if self.handle_global_hotkey(ch, current_action=self._active_screen):
                return None
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - MOUSE_SCROLL_LINES)
                    continue
                if delta < 0:
                    selected = min(len(choices) - 1, selected + MOUSE_SCROLL_LINES)
                    continue
                if self.mouse_button1(state) and 4 <= y < 4 + visible_h:
                    idx = top_index + (y - 4)
                    if 0 <= idx < len(choices):
                        selected = idx
                        if self.mouse_button1_double(state):
                            return choices[selected]
                    continue
            if ch in (27, ord("q"), ord("Q")):
                return None
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
            elif ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(choices) - 1, selected + 1)
            elif ch == curses.KEY_PPAGE:
                selected = max(0, selected - visible_h)
            elif ch == curses.KEY_NPAGE:
                selected = min(len(choices) - 1, selected + visible_h)
            elif ch == curses.KEY_HOME:
                selected = 0
            elif ch == curses.KEY_END:
                selected = len(choices) - 1
            elif ch in (10, 13, curses.KEY_ENTER):
                return choices[selected]

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_options_menu
    # Options UI. This should behave like a friendly form, not like dumping users into raw
    # config editing.
    # ------------------------------------------------------------
    def open_options_menu(self) -> None:
        """w3m-style options form.

        The old options screen behaved like a list of config-file lines. This
        form keeps values visible together, uses checkboxes for booleans, and
        edits the active field inline without opening a second full-screen
        editor for every option.
        """
        selected = 0
        top_index = 0
        editing = False
        edit_value = ""

        # ------------------------------------------------------------
        # MAINTAINER COMMENTARY: def current_fields
        # Maintainer note for current_fields: this routine is part of the long-term public
        # behavior of the program. When changing it, check callers, documentation, config
        # compatibility, session-log compatibility, and the parallel Bash/C implementation
        # plans.
        # ------------------------------------------------------------
        def current_fields() -> List[dict]:
            return [
                {"key": "MODEL", "label": "Model", "kind": "text", "value": self.cfg.model},
                {"key": "WEB_SEARCH", "label": "Web search", "kind": "bool", "value": self.cfg.web_search},
                {"key": "WEB_SEARCH_ENGINE", "label": "Web search engine", "kind": "choice", "value": self.cfg.web_search_engine, "choices": WEB_SEARCH_ENGINES},
                {"key": "WEB_SEARCH_MODE", "label": "Web compatibility", "kind": "choice", "value": self.cfg.web_search_mode, "choices": WEB_SEARCH_MODES},
                {"key": "WEB_SEARCH_MAX_RESULTS", "label": "Web results/search (0=provider default)", "kind": "int", "value": str(self.cfg.web_search_max_results)},
                {"key": "WEB_SEARCH_MAX_USES", "label": "Web search rounds (0=no ttychatter cap)", "kind": "int", "value": str(self.cfg.web_search_max_uses)},
                {"key": "INPUT_HEIGHT", "label": "Draft rows (1..12)", "kind": "int", "value": str(self.cfg.input_height)},
                {"key": "CONTEXT_TURNS", "label": "Context turns", "kind": "int", "value": str(self.cfg.context_turns)},
                {"key": "SESSION_DIR", "label": "Session directory", "kind": "path", "value": str(self.cfg.session_dir)},
                {"key": "ATTACHMENT_DIR", "label": "Attachment directory", "kind": "path", "value": str(self.cfg.effective_attachment_dir)},
                {"key": "MAX_ATTACHMENT_BYTES", "label": "Max inline attachment bytes", "kind": "int", "value": str(self.cfg.max_attachment_bytes)},
                {"key": "EDITOR", "label": "External editor", "kind": "editor_choice", "value": self.cfg.editor},
                {"key": "MODEL_CACHE_FILE", "label": "Model cache file", "kind": "path", "value": str(self.cfg.model_cache_file)},
                {"key": "MODEL_FAVORITES_FILE", "label": "Model favorites file", "kind": "path", "value": str(self.cfg.effective_model_favorites_file)},
                {"key": "MODEL_FILTER_CHAT_COMPLETIONS", "label": "Model browser: chat.completions only", "kind": "bool", "value": self.cfg.model_filter_chat_completions},
                {"key": "MODEL_FILTER_REQUIRE_TOKENS", "label": "Model browser: require token limits", "kind": "bool", "value": self.cfg.model_filter_require_tokens},
                {"key": "MODEL_FILTER_HIDE_PREVIEW", "label": "Model browser: hide preview/experimental", "kind": "bool", "value": self.cfg.model_filter_hide_preview},
                {"key": "MODEL_MIN_INPUT_TOKENS", "label": "Model browser: min input tokens", "kind": "int", "value": str(self.cfg.model_min_input_tokens)},
                {"key": "MODEL_MIN_OUTPUT_TOKENS", "label": "Model browser: min output tokens", "kind": "int", "value": str(self.cfg.model_min_output_tokens)},
                {"key": "MODEL_SORT_ORDER", "label": "Model browser: sort order", "kind": "choice", "value": self.cfg.model_sort_order, "choices": ["favorites", "type", "api", "name", "display", "input-desc", "output-desc"]},
                {"key": "MODEL_TYPE_FILTER", "label": "Model browser: type filter", "kind": "choice", "value": self.cfg.model_type_filter, "choices": MODEL_TYPE_CHOICES},
                {"key": "MODEL_TEST_PROMPT", "label": "Model test prompt", "kind": "text", "value": self.cfg.model_test_prompt},
                {"key": "GITHUB_URL", "label": "GitHub/status URL", "kind": "text", "value": self.cfg.github_url},
                {"key": "INPUT_PLACEHOLDER", "label": "Input placeholder", "kind": "text", "value": self.cfg.input_placeholder},
                {"key": "SEND_INPUT", "label": "Send key", "kind": "choice", "value": self.cfg.send_input, "choices": ["enter", "ctrl_g", "ctrl_enter"]},
                {"key": "STREAM", "label": "Stream assistant output", "kind": "bool", "value": self.cfg.stream},
                {"key": "AI_FILE_DOWNLOAD_MODE", "label": "AI returned files", "kind": "choice", "value": self.cfg.ai_file_download_mode, "choices": ["ask", "auto", "metadata", "off"]},
                {"key": "LOOPBACK_FILE", "label": "Loopback output file", "kind": "path", "value": str(self.cfg.loopback_file or "")},
                {"key": "PROMPT_SESSION_NAME", "label": "Prompt for session name", "kind": "bool", "value": self.cfg.prompt_session_name},
                {"key": "CODE_ATTACHMENT_MIN_LINES", "label": "Code block attachment min lines", "kind": "int", "value": str(self.cfg.code_attachment_min_lines)},
                {"key": "SESSION_AUTO_TITLE", "label": "AI session-title metadata", "kind": "bool", "value": self.cfg.session_auto_title},
                {"key": "SESSION_TITLE_MODEL", "label": "Session title model", "kind": "text", "value": self.cfg.session_title_model},
                {"key": "SESSION_TITLE_MAX_WORDS", "label": "Session title max words", "kind": "int", "value": str(self.cfg.session_title_max_words)},
                {"key": "STARTUP_NOTICE", "label": "Startup Project Lead notice", "kind": "bool", "value": self.cfg.startup_notice},
                {"key": "DEMO_MODE", "label": "Demo mode", "kind": "bool", "value": self.cfg.demo_mode},
                {"key": "CONFIRM_LIVE_SEND", "label": "Confirm first live send", "kind": "bool", "value": self.cfg.confirm_live_send},
                {"key": "API_KEY_GPG_FILE", "label": "GPG API-key file" + ("" if shutil.which("gpg") else " (gpg not found)"), "kind": "text", "value": str(self.cfg.effective_api_key_gpg_file)},
            ]

        # ------------------------------------------------------------
        # MAINTAINER COMMENTARY: def apply_field
        # Maintainer note for apply_field: this routine is part of the long-term public behavior
        # of the program. When changing it, check callers, documentation, config compatibility,
        # session-log compatibility, and the parallel Bash/C implementation plans.
        # ------------------------------------------------------------
        def apply_field(key: str, value: object) -> None:
            if key == "MODEL":
                self.cfg.model = normalize_model_id(str(value))
                set_config_value(self.cfg, key, self.cfg.model)
            elif key == "WEB_SEARCH":
                self.cfg.web_search = bool(value)
                set_config_value(self.cfg, key, '1' if value else '0')
            elif key == "WEB_SEARCH_ENGINE" and str(value) in WEB_SEARCH_ENGINES:
                self.cfg.web_search_engine = str(value)
                set_config_value(self.cfg, key, str(value))
            elif key == "WEB_SEARCH_MODE" and str(value) in WEB_SEARCH_MODES:
                self.cfg.web_search_mode = str(value)
                set_config_value(self.cfg, key, str(value))
            elif key == "WEB_SEARCH_MAX_RESULTS":
                self.cfg.web_search_max_results = min(25, parse_nonnegative_int(str(value), self.cfg.web_search_max_results))
                set_config_value(self.cfg, key, str(self.cfg.web_search_max_results))
            elif key == "WEB_SEARCH_MAX_USES":
                self.cfg.web_search_max_uses = min(25, parse_nonnegative_int(str(value), self.cfg.web_search_max_uses))
                set_config_value(self.cfg, key, str(self.cfg.web_search_max_uses))
            elif key == "INPUT_HEIGHT":
                self.cfg.input_height = min(12, parse_positive_int(str(value), 3))
                set_config_value(self.cfg, key, str(self.cfg.input_height))
            elif key == "CONTEXT_TURNS":
                self.cfg.context_turns = parse_positive_int(str(value), self.cfg.context_turns)
                set_config_value(self.cfg, key, str(self.cfg.context_turns))
            elif key == "SESSION_DIR":
                self.cfg.session_dir = expand_path(str(value))
                self.cfg.session_dir.mkdir(parents=True, exist_ok=True)
                set_config_value(self.cfg, key, str(self.cfg.session_dir))
            elif key == "ATTACHMENT_DIR":
                self.cfg.attachment_dir = expand_path(str(value))
                self.attachment_dir = self.cfg.effective_attachment_dir
                self.attachment_dir.mkdir(parents=True, exist_ok=True)
                set_config_value(self.cfg, key, str(self.attachment_dir))
            elif key == "MAX_ATTACHMENT_BYTES":
                self.cfg.max_attachment_bytes = parse_nonnegative_int(str(value), self.cfg.max_attachment_bytes)
                set_config_value(self.cfg, key, str(self.cfg.max_attachment_bytes))
            elif key == "EDITOR":
                self.cfg.editor = str(value)
                set_config_value(self.cfg, key, self.cfg.editor)
            elif key == "MODEL_CACHE_FILE":
                self.cfg.model_cache_file = expand_path(str(value))
                self.cfg.model_cache_file.parent.mkdir(parents=True, exist_ok=True)
                set_config_value(self.cfg, key, str(self.cfg.model_cache_file))
            elif key == "MODEL_FAVORITES_FILE":
                self.cfg.model_favorites_file = expand_path(str(value))
                self.cfg.model_favorites_file.parent.mkdir(parents=True, exist_ok=True)
                set_config_value(self.cfg, key, str(self.cfg.model_favorites_file))
            elif key == "MODEL_FILTER_CHAT_COMPLETIONS":
                self.cfg.model_filter_chat_completions = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.model_filter_chat_completions else "0")
            elif key == "MODEL_FILTER_REQUIRE_TOKENS":
                self.cfg.model_filter_require_tokens = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.model_filter_require_tokens else "0")
            elif key == "MODEL_FILTER_HIDE_PREVIEW":
                self.cfg.model_filter_hide_preview = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.model_filter_hide_preview else "0")
            elif key == "MODEL_MIN_INPUT_TOKENS":
                self.cfg.model_min_input_tokens = parse_nonnegative_int(str(value), self.cfg.model_min_input_tokens)
                set_config_value(self.cfg, key, str(self.cfg.model_min_input_tokens))
            elif key == "MODEL_MIN_OUTPUT_TOKENS":
                self.cfg.model_min_output_tokens = parse_nonnegative_int(str(value), self.cfg.model_min_output_tokens)
                set_config_value(self.cfg, key, str(self.cfg.model_min_output_tokens))
            elif key == "MODEL_SORT_ORDER":
                value_text = str(value)
                if value_text in {"favorites", "type", "api", "name", "display", "input-desc", "output-desc"}:
                    self.cfg.model_sort_order = value_text
                    set_config_value(self.cfg, key, self.cfg.model_sort_order)
            elif key == "MODEL_TYPE_FILTER":
                value_text = str(value)
                if value_text in MODEL_TYPE_CHOICES:
                    self.cfg.model_type_filter = value_text
                    set_config_value(self.cfg, key, self.cfg.model_type_filter)
            elif key == "THEME":
                value_text = str(value)
                if value_text in THEME_CHOICES:
                    self.cfg.theme = value_text
                    self.cfg.monochrome = value_text == "mono"
                    set_config_value(self.cfg, key, self.cfg.theme)
            elif key == "MODEL_TEST_PROMPT":
                self.cfg.model_test_prompt = str(value)
                set_config_value(self.cfg, key, self.cfg.model_test_prompt)
            elif key == "GITHUB_URL":
                self.cfg.github_url = str(value)
                set_config_value(self.cfg, key, self.cfg.github_url)
            elif key == "INPUT_PLACEHOLDER":
                self.cfg.input_placeholder = str(value)
                set_config_value(self.cfg, key, self.cfg.input_placeholder)
            elif key == "SEND_INPUT":
                self.cfg.send_input = str(value)
                set_config_value(self.cfg, key, self.cfg.send_input)
            elif key == "STREAM":
                self.cfg.stream = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.stream else "0")
            elif key == "AI_FILE_DOWNLOAD_MODE":
                text = str(value).lower()
                if text in {"ask", "auto", "metadata", "off"}:
                    self.cfg.ai_file_download_mode = text
                    set_config_value(self.cfg, key, text)
            elif key == "LOOPBACK_FILE":
                text = str(value).strip()
                self.cfg.loopback_file = expand_path(text) if text else None
                set_config_value(self.cfg, key, str(self.cfg.loopback_file or ""))
            elif key == "PROMPT_SESSION_NAME":
                self.cfg.prompt_session_name = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.prompt_session_name else "0")
            elif key == "CODE_ATTACHMENT_MIN_LINES":
                self.cfg.code_attachment_min_lines = parse_positive_int(str(value), self.cfg.code_attachment_min_lines)
                set_config_value(self.cfg, key, str(self.cfg.code_attachment_min_lines))
            elif key == "SESSION_AUTO_TITLE":
                self.cfg.session_auto_title = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.session_auto_title else "0")
            elif key == "SESSION_TITLE_MODEL":
                self.cfg.session_title_model = normalize_model_id(str(value)) or FALLBACK_MODEL
                set_config_value(self.cfg, key, self.cfg.session_title_model)
            elif key == "SESSION_TITLE_MAX_WORDS":
                self.cfg.session_title_max_words = parse_positive_int(str(value), self.cfg.session_title_max_words)
                set_config_value(self.cfg, key, str(self.cfg.session_title_max_words))
            elif key == "MONOCHROME":
                self.cfg.monochrome = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.monochrome else "0")
            elif key == "STARTUP_NOTICE":
                self.cfg.startup_notice = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.startup_notice else "0")
            elif key == "DEMO_MODE":
                self.cfg.demo_mode = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.demo_mode else "0")
            elif key == "CONFIRM_LIVE_SEND":
                self.cfg.confirm_live_send = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.confirm_live_send else "0")
            elif key == "API_KEY_GPG_FILE":
                self.cfg.api_key_gpg_file = expand_path(str(value))
                set_config_value(self.cfg, key, str(self.cfg.api_key_gpg_file))
            self.status = f"saved option: {key}"

        while True:
            fields = current_fields()
            selected = max(0, min(selected, len(fields) - 1))
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            body_h = max(1, height - 6)
            if selected < top_index:
                top_index = selected
            elif selected >= top_index + body_h:
                top_index = selected - body_h + 1

            self.safe_addstr(0, 0, "OPTIONS", width, self.reverse_attr())
            help_line = "Space=toggle | Enter=edit/save | Esc/q=return | F-keys jump"
            if editing:
                help_line = "Editing inline: Enter=save | Esc=cancel edit | Backspace=delete"
            self.safe_addstr(1, 0, help_line, width, self.dim_attr())
            self.safe_addstr(2, 0, "_" * width, width, self.dim_attr())

            for row in range(body_h):
                idx = top_index + row
                if idx >= len(fields):
                    break
                field = fields[idx]
                attr = self.reverse_attr() if idx == selected else 0
                if field["kind"] == "bool":
                    mark = "[x]" if field["value"] else "[ ]"
                    line = f"{mark} {field['label']}"
                else:
                    if field["kind"] == "editor_choice":
                        val = str(field["value"] or self.cfg.effective_editor)
                    else:
                        val = str(field["value"])
                    if editing and idx == selected:
                        val = edit_value
                    line = f"{field['label']:<24} [{val}]"
                self.safe_addstr(3 + row, 0, line, width, attr)

            self.safe_addstr(height - 2, 0, "_" * width, width, self.dim_attr())
            if editing:
                self.safe_addstr(height - 1, 0, f"Editing {fields[selected]['key']}: {edit_value}", width, self.reverse_attr())
            else:
                self.safe_addstr(height - 1, 0, f"{selected + 1}/{len(fields)}  Config: {self.cfg.config_file}", width, self.reverse_attr())
            self.stdscr.refresh()

            ch = self.ui_getch()
            if self.handle_global_hotkey(ch, current_action="options"):
                return
            field = fields[selected]

            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - MOUSE_SCROLL_LINES)
                elif delta < 0:
                    selected = min(len(fields) - 1, selected + MOUSE_SCROLL_LINES)
                elif self.mouse_button1(state) and 3 <= y < 3 + body_h:
                    idx = top_index + (y - 3)
                    if 0 <= idx < len(fields):
                        selected = idx
                        if self.mouse_button1_double(state):
                            ch = 10
                else:
                    continue

            if editing:
                if ch in (27,):
                    editing = False
                    edit_value = ""
                    continue
                if ch in (10, 13, curses.KEY_ENTER):
                    apply_field(field["key"], edit_value)
                    editing = False
                    edit_value = ""
                    continue
                if ch in (curses.KEY_BACKSPACE, 127, 8):
                    edit_value = edit_value[:-1]
                    continue
                if ch == curses.KEY_DC:
                    continue
                if 32 <= ch <= 126:
                    edit_value += chr(ch)
                    continue
                continue

            if ch in (27, ord("q"), ord("Q")):
                return
            if ch in (curses.KEY_UP, ord("k")):
                selected = max(0, selected - 1)
            elif ch in (curses.KEY_DOWN, ord("j")):
                selected = min(len(fields) - 1, selected + 1)
            elif ch == curses.KEY_PPAGE:
                selected = max(0, selected - body_h)
            elif ch == curses.KEY_NPAGE:
                selected = min(len(fields) - 1, selected + body_h)
            elif ch == curses.KEY_HOME:
                selected = 0
            elif ch == curses.KEY_END:
                selected = len(fields) - 1
            elif ch in (ord(" "),):
                if field["kind"] == "bool":
                    apply_field(field["key"], not bool(field["value"]))
            elif ch in (10, 13, curses.KEY_ENTER):
                if field["kind"] == "bool":
                    apply_field(field["key"], not bool(field["value"]))
                elif field["kind"] == "choice":
                    # Choice fields are not free-form strings.  SEND_INPUT is
                    # the main example: users should choose from supported send
                    # gestures rather than typing labels like ctrl_g manually.
                    # The chooser also gives us room to document terminal-
                    # dependent options such as ctrl_enter without pretending
                    # every terminal can distinguish them.
                    chosen = self.choice_modal(
                        f"CHOOSE {field['key']}",
                        "Choose one supported value.  ctrl_enter depends on terminal support.",
                        field.get("choices", []),
                        str(field["value"]),
                    )
                    if chosen is not None:
                        apply_field(field["key"], chosen)
                elif field["kind"] == "editor_choice":
                    # EDITOR is a bounded-choice field in practice even though
                    # users may ultimately type a custom path.  The selector
                    # shows only editors found in PATH, plus Custom/Browse
                    # fallbacks.  This keeps the Options screen from becoming
                    # a raw config-file editor.
                    chosen_editor = self.select_editor_value()
                    if chosen_editor is not None:
                        apply_field(field["key"], chosen_editor)
                else:
                    editing = True
                    edit_value = str(field["value"])

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_memory_menu
    # Maintainer note for open_memory_menu: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def open_memory_menu(self) -> None:
        """Open the memory/context tools menu.

        Terminal-physics note for future maintainers:
        this screen is visually a small menu, not a transcript.  It should
        therefore behave like every other small menu in ttychatter: Up/Down,
        j/k, mousewheel, click, Enter, and global F-keys all work.  Earlier
        versions accepted only letter shortcuts here, which made this screen
        feel like a trap compared with F5 Options.  Consistency matters more
        than saving a few lines of code because users often navigate by muscle
        memory, in the dark, or on cramped keyboards.
        """
        choices = [
            ("v", "view memory"),
            ("e", "edit memory in external editor"),
            ("c", "clear memory"),
            ("r", "rebuild memory from log"),
            ("q", "return to chat"),
        ]
        selected = 0
        while True:
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 5)
            self.safe_addstr(0, 0, "MEMORY MENU", width, self.reverse_attr())
            self.safe_addstr(1, 0, f"Context entries: {len(self.context_buffer)} | CONTEXT_TURNS={self.cfg.context_turns}", width)
            self.safe_addstr(2, 0, "Enter=select | j/k move | Esc/q=return | F-keys jump", width, self.dim_attr())
            self.safe_addstr(3, 0, "_" * width, width, self.dim_attr())
            selected = max(0, min(selected, len(choices) - 1))
            for row, (_key, label) in enumerate(choices[:visible_h]):
                attr = self.reverse_attr() if row == selected else 0
                self.safe_addstr(4 + row, 0, f"{_key}  {label}", width, attr)
            self.stdscr.refresh()
            ch = self.ui_getch()
            if self.handle_global_hotkey(ch, current_action="memory"):
                return
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - MOUSE_SCROLL_LINES)
                    continue
                if delta < 0:
                    selected = min(len(choices) - 1, selected + MOUSE_SCROLL_LINES)
                    continue
                if self.mouse_button1(state) and 4 <= y < 4 + len(choices):
                    selected = y - 4
                    ch = 10
                else:
                    continue
            if ch in (27, ord("q"), ord("Q")):
                return
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
                continue
            if ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(choices) - 1, selected + 1)
                continue
            if ch in (10, 13, curses.KEY_ENTER):
                action = choices[selected][0]
            else:
                action = chr(ch).lower() if 0 <= ch < 256 else ""

            if action == "v":
                self.show_message("CURRENT MEMORY", self.context_buffer or ["Memory is empty."])
            elif action == "e":
                edited = self.run_external_editor("\n".join(self.context_buffer))
                if edited is not None:
                    self.context_buffer = [line for line in edited.splitlines() if line.strip()]
                    self.trim_context_buffer()
                    self.save_context_snapshot()
                    self.status = "memory edited and snapshot saved"
                    return
            elif action == "c":
                if self.ask_yes_no("CLEAR MEMORY", "Clear current memory context? Logs are not deleted.", default=False):
                    self.context_buffer = []
                    self.save_context_snapshot()
                    self.status = "memory cleared"
                    return
            elif action == "r":
                self.context_buffer = []
                entries = load_log_entries(self.session_path)
                snapshot = latest_context_snapshot(entries)
                if snapshot:
                    self.context_buffer = snapshot
                else:
                    max_entries = self.cfg.context_turns * 2
                    for entry in entries[-max_entries:]:
                        if is_snapshot_entry(entry) or entry.speaker == "system":
                            continue
                        self.context_buffer.append(("Assistant: " if entry.speaker == "AI" else "User: ") + entry.text)
                self.trim_context_buffer()
                self.status = "memory rebuilt from log"
                return

    # ------------------------------------------------------------
    def file_picker(self, start_dir: Path, title: str) -> Optional[Path]:
        current = start_dir.expanduser().resolve()
        selected = 0
        top_index = 0
        while True:
            try:
                entries = [current.parent] + sorted(current.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower()))
            except OSError as exc:
                self.show_message(title, [f"Cannot read directory: {exc}"])
                return None
            selected = min(selected, len(entries) - 1)
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 5)
            self.safe_addstr(0, 0, title, width, self.reverse_attr())
            self.safe_addstr(1, 0, f"Directory: {current}", width)
            self.safe_addstr(2, 0, "Enter=open/select | Esc/q=cancel | wheel=scroll", width, self.dim_attr())
            if selected < top_index: top_index = selected
            elif selected >= top_index + visible_h: top_index = selected - visible_h + 1
            for row in range(visible_h):
                idx = top_index + row
                if idx >= len(entries): break
                p = entries[idx]
                label = "../" if idx == 0 else (p.name + ("/" if p.is_dir() else ""))
                attr = self.reverse_attr() if idx == selected else 0
                self.safe_addstr(3 + row, 0, label, width, attr)
            self.stdscr.refresh()
            ch = self.ui_getch()
            if self.handle_global_hotkey(ch, current_action="files"):
                return None
            if ch == curses.KEY_MOUSE:
                try: _mid, _x, y, _z, state = curses.getmouse()
                except curses.error: continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0: selected = max(0, selected - MOUSE_SCROLL_LINES)
                elif delta < 0: selected = min(len(entries) - 1, selected + MOUSE_SCROLL_LINES)
                elif self.mouse_button1(state) and 3 <= y < 3 + visible_h:
                    idx = top_index + (y - 3)
                    if 0 <= idx < len(entries): selected = idx
                continue
            if ch in (27, ord("q"), ord("Q")): return None
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
            elif ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(entries) - 1, selected + 1)
            elif ch in (10, 13, curses.KEY_ENTER):
                chosen = entries[selected]
                if chosen.is_dir():
                    current = chosen.resolve(); selected = 0; top_index = 0
                else:
                    return chosen

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_file_menu
    # File and attachment workflow. Keep user-visible file actions explicit because media
    # compatibility depends on the chosen model/API behavior.
    # ------------------------------------------------------------
    def open_file_menu(self) -> None:
        choices = [
            ("a", "attach file for next AI request"),
            ("l", "list pending files"),
            ("c", "clear pending files"),
            ("b", "browse saved attachment directory"),
            ("q", "cancel"),
        ]
        selected = 0
        while True:
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            self.safe_addstr(0, 0, "FILES / ATTACHMENTS", width, self.reverse_attr())
            self.safe_addstr(1, 0, f"Pending files: {len(self.pending_attachments)}", width)
            self.safe_addstr(2, 0, "Enter=select | Esc/q=cancel | wheel=move", width, self.dim_attr())
            self.safe_addstr(3, 0, "_" * width, width, self.dim_attr())
            visible_h = max(1, height - 5)
            for row, (_key, label) in enumerate(choices[:visible_h]):
                attr = self.reverse_attr() if row == selected else 0
                self.safe_addstr(4 + row, 0, f"{_key}  {label}", width, attr)
            self.stdscr.refresh()

            ch = self.ui_getch()
            if self.handle_global_hotkey(ch, current_action="files"):
                return
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - 1)
                elif delta < 0:
                    selected = min(len(choices) - 1, selected + 1)
                elif self.mouse_button1(state) and 4 <= y < 4 + len(choices):
                    selected = y - 4
                    ch = 10
                else:
                    continue

            if ch in (27, ord("q"), ord("Q")):
                return
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
                continue
            if ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(choices) - 1, selected + 1)
                continue
            if ch in (10, 13, curses.KEY_ENTER):
                action = choices[selected][0]
            else:
                action = chr(ch).lower() if 0 <= ch < 256 else ""

            if action == "a":
                path = self.file_picker(Path.cwd(), "ATTACH FILE")
                if path:
                    self.pending_attachments.append(PendingAttachment(path, guess_mime(path)))
                    self.status = f"attached file for next request: {path.name}"
                    return
            elif action == "l":
                self.show_message("PENDING FILES", [f"{p.path} ({p.mime_type})" for p in self.pending_attachments] or ["No pending files."])
            elif action == "c":
                self.pending_attachments = []
                self.status = "pending files cleared"
                return
            elif action == "b":
                path = self.file_picker(self.attachment_dir, "BROWSE SAVED ATTACHMENTS")
                if path and self.ask_yes_no("OPEN FILE", f"Open {path.name} in external editor/viewer?", default=True):
                    self.run_external_editor(path.read_text(encoding="utf-8", errors="replace") if path.stat().st_size < 2_000_000 else f"Binary/large file: {path}")
                    return

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def detected_editors
    # Maintainer note for detected_editors: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def detected_editors(self) -> List[Tuple[str, str]]:
        """Return common editors that are actually runnable from PATH.

        The project goal is a friendly terminal client, so F8 should not assume
        the user remembers the exact path to their editor. This helper finds
        common editors with shutil.which(), which answers the practical
        question: can this command be launched from this terminal session?
        """
        names = ["nvim", "vim", "vi", "micro", "nano", "pico", "emacs", "mg", "joe", "jed", "ed"]
        found: List[Tuple[str, str]] = []
        seen = set()
        for name in names:
            path = shutil.which(name)
            if path and path not in seen:
                found.append((name, path))
                seen.add(path)
        return found

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def browse_for_editor
    # Maintainer note for browse_for_editor: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def browse_for_editor(self) -> Optional[str]:
        """Browse common executable directories for an editor command.

        This is intentionally similar to an old "Run... Browse" dialog: the
        user can select an executable file without typing its full path.
        """
        for start in [Path("/usr/bin"), Path("/bin"), Path("/usr/local/bin"), Path.home()]:
            if start.exists():
                chosen = self.file_browser("BROWSE FOR EDITOR EXECUTABLE", start)
                if chosen is not None:
                    return str(chosen)
        return None

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def select_editor_value
    #
    # Compact editor selector used by the Options screen.  F8 is deliberately
    # *not* this selector: F8 is the quick compose action that opens the already
    # configured editor for the current draft.  Editor selection is a preference,
    # so it belongs in Options alongside SEND_INPUT and THEME.
    #
    # The list is built from executables found in PATH with shutil.which().  We
    # do not show editors that are not installed, because a menu of imaginary
    # commands teaches users nothing and makes old-PC/minimal installations feel
    # broken.  "Custom" and "Browse" remain available because Unix users often
    # keep editors in nonstandard paths.
    # ------------------------------------------------------------
    def select_editor_value(self) -> Optional[str]:
        detected = self.detected_editors()
        choices: List[Tuple[str, str]] = [(f"{name} ({path})", path) for name, path in detected]
        choices.append(("Custom command/path...", "__custom__"))
        choices.append(("Browse executable...", "__browse__"))
        labels = [label for label, _value in choices]
        current = self.cfg.editor or self.cfg.effective_editor
        chosen = self.choice_modal("SELECT EDITOR", f"Current editor: {current}", labels, labels[0] if labels else "")
        if chosen is None:
            return None
        value = dict(choices).get(chosen)
        if value == "__custom__":
            return self.text_input_modal("CUSTOM EDITOR", "Enter editor command or executable path.", initial=current)
        if value == "__browse__":
            return self.browse_for_editor()
        return value

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_external_editor_for_input
    # Maintainer note for open_external_editor_for_input: this routine is part of the long-term
    # public behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def open_external_editor_for_input(self) -> None:
        """Run the editor after the explicit Open in external editor action."""
        edited = self.run_external_editor(self.current_input())
        if edited is not None:
            self.input_lines = edited.rstrip("\n").splitlines() or [""]
            self.cursor_row = len(self.input_lines) - 1
            self.cursor_col = len(self.input_lines[-1])
            self.input_visible = True
            self.status = "input loaded from external editor"

    # ------------------------------------------------------------------
    # Input editing and sending
    # ------------------------------------------------------------------

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def insert_text
    # Maintainer note for insert_text: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def insert_text(self, text: str) -> None:
        line = self.input_lines[self.cursor_row]
        self.input_lines[self.cursor_row] = line[: self.cursor_col] + text + line[self.cursor_col:]
        self.cursor_col += len(text)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def insert_newline
    # Maintainer note for insert_newline: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def insert_newline(self) -> None:
        line = self.input_lines[self.cursor_row]
        self.input_lines[self.cursor_row] = line[: self.cursor_col]
        self.input_lines.insert(self.cursor_row + 1, line[self.cursor_col:])
        self.cursor_row += 1
        self.cursor_col = 0

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def backspace
    # Maintainer note for backspace: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def backspace(self) -> None:
        if self.cursor_col > 0:
            line = self.input_lines[self.cursor_row]
            self.input_lines[self.cursor_row] = line[: self.cursor_col - 1] + line[self.cursor_col:]
            self.cursor_col -= 1
        elif self.cursor_row > 0:
            previous_len = len(self.input_lines[self.cursor_row - 1])
            self.input_lines[self.cursor_row - 1] += self.input_lines[self.cursor_row]
            del self.input_lines[self.cursor_row]
            self.cursor_row -= 1
            self.cursor_col = previous_len

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def delete_forward
    # Maintainer note for delete_forward: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def delete_forward(self) -> None:
        line = self.input_lines[self.cursor_row]
        if self.cursor_col < len(line):
            self.input_lines[self.cursor_row] = line[: self.cursor_col] + line[self.cursor_col + 1:]
        elif self.cursor_row < len(self.input_lines) - 1:
            self.input_lines[self.cursor_row] += self.input_lines[self.cursor_row + 1]
            del self.input_lines[self.cursor_row + 1]

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def move_left
    # Maintainer note for move_left: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def move_left(self) -> None:
        if self.cursor_col > 0: self.cursor_col -= 1
        elif self.cursor_row > 0: self.cursor_row -= 1; self.cursor_col = len(self.input_lines[self.cursor_row])

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def move_right
    # Maintainer note for move_right: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def move_right(self) -> None:
        line = self.input_lines[self.cursor_row]
        if self.cursor_col < len(line): self.cursor_col += 1
        elif self.cursor_row < len(self.input_lines) - 1: self.cursor_row += 1; self.cursor_col = 0

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def move_up
    # Maintainer note for move_up: this routine is part of the long-term public behavior of the
    # program. When changing it, check callers, documentation, config compatibility, session-log
    # compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def move_up(self) -> None:
        if self.cursor_row > 0:
            self.cursor_row -= 1; self.cursor_col = min(self.cursor_col, len(self.input_lines[self.cursor_row]))

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def move_down
    # Maintainer note for move_down: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def move_down(self) -> None:
        if self.cursor_row < len(self.input_lines) - 1:
            self.cursor_row += 1; self.cursor_col = min(self.cursor_col, len(self.input_lines[self.cursor_row]))

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def clear_input
    # Maintainer note for clear_input: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def clear_input(self) -> None:
        self.input_lines = [""]; self.cursor_row = 0; self.cursor_col = 0; self.input_scroll = 0

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def current_input
    # Maintainer note for current_input: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def current_input(self) -> str:
        return "\n".join(self.input_lines).strip("\n")

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def send_current_message
    # Message send path. This is where UI text becomes session log entries, memory context,
    # AI request parts, and visible transcript output.
    # ------------------------------------------------------------
    def ask_ai_file_download(self, rec: Dict[str, str], idx: int) -> bool:
        return self.ask_yes_no('AI FILE ATTACHMENT', f"Download AI attachment {idx}: {rec.get('name','assistant-file')} ({rec.get('mime','application/octet-stream')})?", default=False)

    def _run_request_worker(self, cfg_work: Config, prompt_text: str, session_name: str,
                            attachments: List[PendingAttachment]) -> None:
        """Network work only. The worker never calls curses or mutates live UI state."""
        fallback_used = False
        cached_support = cached_model_tool_support(cfg_work, cfg_work.effective_model) if cfg_work.web_search else None
        if cfg_work.web_search and cfg_work.web_search_mode == 'auto' and cached_support is False:
            cfg_work.web_search_mode = 'plugin'
            fallback_used = True
            self._request_events.put(('notice', 'Current model cache does not advertise tool support; using OpenRouter web plugin fallback.'))

        def run_once() -> Tuple[bool, str, bool]:
            if cfg_work.stream:
                def on_piece(piece: str) -> None:
                    self._request_events.put(('piece', piece))
                return generate_with_model_stream(cfg_work, cfg_work.effective_model, prompt_text,
                    session_name, cfg_work.effective_attachment_dir, attachments, on_piece,
                    self._request_cancel.is_set)
            ok, output = generate_with_model(cfg_work, cfg_work.effective_model, prompt_text,
                session_name, cfg_work.effective_attachment_dir, attachments, timeout=120, ask_download=None)
            return ok, output, False

        ok, output, cancelled = run_once()
        if (not ok and cfg_work.web_search and cfg_work.web_search_mode == 'auto'
                and is_tool_endpoint_404(output) and not cfg_work.last_response_metadata.get('partial_text')):
            cfg_work.web_search_mode = 'plugin'
            fallback_used = True
            self._request_events.put(('notice', 'Server web tool is unavailable on this route; retrying once with the OpenRouter web plugin.'))
            ok, output, cancelled = run_once()
        self._request_events.put(('done', {
            'ok': ok, 'output': output, 'cancelled': cancelled,
            'metadata': dict(cfg_work.last_response_metadata),
            'fallback_used': fallback_used,
        }))

    def send_current_message(self) -> None:
        if self._request_active:
            self.status = 'A response is already being generated; the UI remains available.'
            return
        message = self.current_input()
        if not message.strip() and not self.pending_attachments:
            self.status = 'Empty message ignored'
            return
        if not message.strip():
            message = 'Please review the attached file(s).'
        if not self.cfg.demo_mode and self.cfg.confirm_live_send and not self.cfg.live_send_confirmed:
            if not self.ask_yes_no('LIVE OPENROUTER REQUEST', 'Send this request to OpenRouter?', default=False):
                self.status = 'Send cancelled; draft retained'
                return
            self.cfg.live_send_confirmed = True

        attachments = list(self.pending_attachments)
        note = '\n[Attachments sent: ' + ', '.join(p.path.name for p in attachments) + ']' if attachments else ''
        old_context = list(self.context_buffer)
        prompt_text = (self.build_context() + '\n' if self.context_buffer else '') + 'User: ' + message
        user_time = now_time()
        self.remove_startup_notice()
        append_log(self.session_path, self.username, message + note, user_time)
        self.transcript.append(TranscriptItem(self.username, message + note, user_time))
        self.context_buffer.append('User: ' + message + note)
        self.trim_context_buffer()
        self.clear_input()
        # Files in this request are consumed now. Files attached while it runs belong
        # to the next request and must never be cleared by completion of this one.
        self.pending_attachments = []
        self.transcript_scroll = 0
        stream_item = None
        if self.cfg.stream:
            stream_item = TranscriptItem('AI', '', now_time())
            self.transcript.append(stream_item)
        self._request_state = {
            'message': message,
            'attachments': attachments,
            'old_context': old_context,
            'stream_item': stream_item,
            'session_path': self.session_path,
            'session_name': self.session_name,
        }
        self._request_active = True
        self._request_cancel = threading.Event()
        self.status = 'Generating response in background; UI remains available.'
        cfg_work = copy.deepcopy(self.cfg)
        # 'ask' would require curses input from the worker. Metadata mode preserves
        # the returned-file references without ever touching curses off-thread.
        if cfg_work.ai_file_download_mode == 'ask':
            cfg_work.ai_file_download_mode = 'metadata'
        self._request_thread = threading.Thread(target=self._run_request_worker,
            args=(cfg_work, prompt_text, self.session_name, attachments), daemon=True,
            name='ttychatter-request')
        self._request_thread.start()

    def process_request_events(self) -> None:
        """Apply completed network work on the curses/main thread."""
        while True:
            try:
                kind, payload = self._request_events.get_nowait()
            except queue.Empty:
                return
            state = self._request_state
            if state is None:
                continue
            if kind == 'notice':
                self.status = str(payload)
                continue
            if kind == 'piece':
                stream_item = state.get('stream_item')
                if stream_item is None:
                    stream_item = TranscriptItem('AI', '', now_time())
                    self.transcript.append(stream_item)
                    state['stream_item'] = stream_item
                stream_item.text += str(payload)
                self.input_visible = False
                self.transcript_scroll = 0
                self.status = 'Streaming response; read mode entered automatically.'
                continue
            if kind == 'done':
                self._finish_request(payload)

    def ui_getch(self) -> int:
        """Wait for a real curses key while continuing background request work."""
        while True:
            ch = self.stdscr.getch()
            if ch != -1:
                return ch
            self.process_request_events()

    def _finish_request(self, result: dict) -> None:
        state = self._request_state or {}
        self._request_active = False
        self._request_thread = None
        self._request_state = None
        ok = bool(result.get('ok'))
        output = str(result.get('output') or '')
        cancelled = bool(result.get('cancelled'))
        metadata = dict(result.get('metadata') or {})
        self.cfg.last_response_metadata = metadata
        partial = bool(metadata.get('partial_text'))
        stream_item = state.get('stream_item')
        old_context = list(state.get('old_context') or [])
        message = str(state.get('message') or '')
        sent_attachments = list(state.get('attachments') or [])

        if not ok and not partial:
            append_log(self.session_path, 'system', 'request-failed: ' + output, now_time())
            self.transcript.append(TranscriptItem('system', self._friendly_request_error(output), now_time()))
            if stream_item is not None and stream_item in self.transcript:
                self.transcript.remove(stream_item)
            self.context_buffer = old_context
            # Restore the failed prompt only if the user has not already started the next one.
            if not self.current_input().strip():
                self.input_lines = message.split('\n') or ['']
                self.cursor_row = len(self.input_lines) - 1
                self.cursor_col = len(self.input_lines[-1])
            existing = {str(item.path) for item in self.pending_attachments}
            self.pending_attachments = sent_attachments + [item for item in self.pending_attachments if str(item.path) not in {str(x.path) for x in sent_attachments}]
            self.input_visible = True
            self.status = 'Request failed; original prompt/files retained. UI remained responsive.'
        else:
            if stream_item is not None:
                stream_item.text = output
            else:
                stream_item = TranscriptItem('AI', output, now_time())
                self.transcript.append(stream_item)
            self.input_visible = False
            self.transcript_scroll = 0
            self.last_reply = output
            storage_errors = []
            try:
                append_log(self.session_path, 'AI', output, now_time())
            except OSError as exc:
                storage_errors.append('Reply log: ' + str(exc))
            try:
                cleaned = extract_code_attachments(output, self.attachment_dir, self.session_name, self.cfg.code_attachment_min_lines)
                stream_item.text = cleaned
            except OSError as exc:
                cleaned = output
                storage_errors.append('Code attachment: ' + str(exc))
            self.context_buffer.append('Assistant: ' + cleaned)
            self.trim_context_buffer()
            if not storage_errors:
                try:
                    self.save_context_snapshot()
                except OSError as exc:
                    storage_errors.append('Context snapshot: ' + str(exc))
            if self.cfg.loopback_file is not None:
                try:
                    self.cfg.loopback_file.parent.mkdir(parents=True, exist_ok=True)
                    with self.cfg.loopback_file.open('a', encoding='utf-8') as fh:
                        fh.write(cleaned + '\n')
                except OSError as exc:
                    self.transcript.append(TranscriptItem('system', 'Loopback write failed: ' + str(exc), now_time()))
            suffix = ' (web plugin fallback)' if result.get('fallback_used') else ''
            self.status = ('Partial response saved' if cancelled or not ok else 'Response complete') + suffix + '; read mode'
            if not cancelled and ok and not storage_errors:
                new_path = generate_session_title(self.cfg, self.session_path, message, cleaned)
                if new_path:
                    self.session_path, self.session_name = new_path, new_path.stem
                    self.session_title = session_title_from_file(new_path)
            if storage_errors:
                self.status = 'Response received; save failed. F8 can save the last reply.'
                self.transcript.append(TranscriptItem('system', self.status + '\n' + '\n'.join(storage_errors), now_time()))

        if metadata:
            try:
                encoded = json.dumps(metadata, ensure_ascii=True)
                if self.cfg.api_key:
                    encoded = encoded.replace(self.cfg.api_key, '[redacted]')
                append_log(self.session_path, 'system', 'openrouter-response: ' + encoded, now_time())
            except OSError as exc:
                self.status = 'Response metadata could not be saved: ' + str(exc)
        if ok and not cancelled and not self._named_after_reply and not self.should_quit:
            self._named_after_reply = True
            # Do not interrupt read mode with a naming modal. The prominent UNNAMED
            # header and Esc menu keep naming available without hijacking the reply.
            if not self.session_title:
                self.status += ' | Session is UNNAMED; name it from Esc menu.'

    def _friendly_request_error(self, output: str) -> str:
        if is_tool_endpoint_404(output):
            return ('Web server tool unavailable for this model/provider route. '
                    'Use F5 Options > Web compatibility = auto/plugin, or choose a tool-capable model.\n' + output)
        return output

    def wait_for_request_completion(self, timeout: float = 5.0) -> bool:
        """Test/maintenance helper; the interactive UI never waits this way."""
        deadline = time.monotonic() + timeout
        while self._request_active and time.monotonic() < deadline:
            self.process_request_events()
            time.sleep(0.01)
        self.process_request_events()
        return not self._request_active

    # ------------------------------------------------------------------
    # Command dispatch
    # ------------------------------------------------------------------

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def action_for_function_key
    # Maintainer note for action_for_function_key: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def action_for_function_key(self, ch: int) -> Optional[str]:
        return {curses.KEY_F1: 'help', curses.KEY_F2: 'models', curses.KEY_F3: 'api-key',
                curses.KEY_F4: 'sessions', curses.KEY_F5: 'options', curses.KEY_F6: 'memory',
                curses.KEY_F7: 'files', curses.KEY_F8: 'editor', curses.KEY_F9: 'credits',
                curses.KEY_F10: 'quit', curses.KEY_F11: 'toggle-input'}.get(ch)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def dispatch_command_action
    # Maintainer note for dispatch_command_action: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------

    def perform_command_action(self, action: str) -> None:
        commands = {'help': self.open_help, 'doctor': self.open_doctor,
                    'models': self.open_model_selector, 'api-key': self.open_api_key_input,
                    'sessions': self.open_session_browser, 'options': self.open_options_menu,
                    'memory': self.open_memory_menu, 'files': self.open_file_menu,
                    'editor': self.open_editor_menu, 'credits': self.open_credits,
                    'send': self.send_current_message, 'quit': self.request_quit,
                    'name': self.prompt_session_title,
                    'toggle-input': self.toggle_input, 'key-help': self.open_key_help}
        if action in commands:
            commands[action]()

    def toggle_input(self) -> None:
        self.input_visible = not self.input_visible
        self.status = 'Draft visible' if self.input_visible else 'Read mode: arrows or j/k; u/d half-page; g/G oldest/latest'

    def request_quit(self) -> None:
        if self.ask_yes_no('CLOSE SESSION', 'Session will be ended and unsaved data lost. Really close? Y/N', default=False):
            if self._request_active:
                self._request_cancel.set()
            self.should_quit = True

    def prompt_session_title(self, reminder: bool = False) -> None:
        if reminder and (not self.cfg.prompt_session_name or self.session_title):
            return
        title = self.text_input_modal('NAME THIS SESSION',
            'Use a name you will recognize in the log directory. Blank or Esc keeps it unnamed.', self.session_title)
        if title:
            self.rename_session(self.session_name, title)
        elif not self.session_title:
            self.status = 'Session is UNNAMED. Use Esc menu > Name current session.'

    def open_editor_menu(self) -> None:
        choices = ['Open in external editor', 'Choose or configure editor', 'Save last reply to file', 'Return to chat']
        while True:
            selected = self.choice_modal('EXTERNAL EDITOR - F8',
                'Current editor: ' + self.cfg.effective_editor, choices, choices[0])
            if selected == choices[0]:
                self.open_external_editor_for_input()
                return
            if selected == choices[1]:
                editor = self.select_editor_value()
                if editor:
                    self.cfg.editor = editor
                    set_config_value(self.cfg, 'EDITOR', editor)
            elif selected == choices[2]:
                self.save_last_reply()
            else:
                return

    def save_last_reply(self) -> None:
        if not self.last_reply:
            self.show_message('SAVE REPLY', ['No reply has been received in this session yet.'])
            return
        name = self.text_input_modal('SAVE LAST REPLY', 'Enter a new file path. Existing files are kept.',
            str(self.attachment_dir / (self.session_name[:80] + '-reply.txt')))
        if not name:
            return
        try:
            target = expand_path(name)
            target.parent.mkdir(parents=True, exist_ok=True)
            with target.open('x', encoding='utf-8') as fh:
                fh.write(self.last_reply)
            self.status = 'Reply saved: ' + str(target)
        except OSError as exc:
            self.show_message('SAVE REPLY', [str(exc)])

    def open_key_help(self) -> None:
        self.show_message('KEYBOARD HELP', [
            'Esc: complete command menu. F1 remains an optional alias for terminals where it is available.',
            'F2 Models; F3 API key; F4 Sessions; F5 Options; F6 Memory; F7 Files; F8 Editor options; F9 About.',
            'F11 toggles draft/read mode. PgUp/PgDn scroll the transcript.',
            'Read mode: Up/Down or k/j scroll one line; u/d scroll half a page; g/G go oldest/latest.',
            'Draft mode: arrows and Home/End edit the draft. Ctrl+G sends when configured as the send key.',
            'Attachments are managed from F7 Files; they intentionally have no global control-key shortcuts.',
            'Web search settings are ordinary F5 Options entries; there is no separate web-search hotkey.',
            'F10 opens the close confirmation. Enter/Esc/N cancels. Only Y confirms.',
            'While a response is in flight, the UI remains interactive. The first rendered response automatically enters read mode.',
            'Function keys remain direct navigation between feature screens.'])

    def dispatch_command_action(self, action: str) -> None:
        # Switching screens unwinds the old screen; it cannot grow the call stack.
        if self._dispatching:
            raise ScreenNavigation(action)
        self._dispatching = True
        try:
            while action:
                self._active_screen = action
                try:
                    self.perform_command_action(action)
                    action = ''
                except ScreenNavigation as navigation:
                    action = navigation.action
        finally:
            self._dispatching = False
            self._active_screen = None

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def handle_global_hotkey
    # Global function-key routing. This is critical for usability: users should be able to jump
    # from any feature screen to any other feature screen without first escaping back to the
    # main chat.
    # ------------------------------------------------------------
    def handle_global_hotkey(self, ch: int, current_action: Optional[str] = None) -> bool:
        action = self.action_for_function_key(ch)
        if not action:
            return False
        if action == (current_action or self._active_screen):
            return False
        raise ScreenNavigation(action)

    # ------------------------------------------------------------------
    # Main event loop
    # ------------------------------------------------------------------

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def handle_key
    # Maintainer note for handle_key: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def handle_key(self, ch: int) -> None:
        action = self.action_for_function_key(ch)
        if action:
            self.dispatch_command_action(action)
            return
        if ch == 7 and (self.cfg.send_input or 'enter').lower() == 'ctrl_g':
            self.dispatch_command_action('send')
            return
        if ch == curses.KEY_MOUSE:
            self.handle_mouse()
            return
        if ch == 27:
            self.dispatch_command_action('help')
            return
        page = max(1, self.layout.get('transcript_h', 10)-1)
        if ch == curses.KEY_PPAGE:
            self.transcript_scroll += page
        elif ch == curses.KEY_NPAGE:
            self.transcript_scroll = max(0, self.transcript_scroll-page)
        elif ch == getattr(curses, 'KEY_SR', -999):
            self.transcript_scroll += 1
        elif ch == getattr(curses, 'KEY_SF', -999):
            self.transcript_scroll = max(0, self.transcript_scroll-1)
        elif not self.input_visible:
            if ch in (curses.KEY_UP, ord('k'), ord('K')):
                self.transcript_scroll += 1
            elif ch in (curses.KEY_DOWN, ord('j'), ord('J')):
                self.transcript_scroll = max(0, self.transcript_scroll-1)
            elif ch in (ord('u'), ord('U')):
                self.transcript_scroll += max(1, page // 2)
            elif ch in (ord('d'), ord('D')):
                self.transcript_scroll = max(0, self.transcript_scroll - max(1, page // 2))
            elif ch in (curses.KEY_HOME, ord('g')):
                self.transcript_scroll = len(self.transcript_display_lines(self.layout.get('width', 80)))
            elif ch in (curses.KEY_END, ord('G')):
                self.transcript_scroll = 0
        elif ch == curses.KEY_ENTER and self.cfg.send_input == 'ctrl_enter':
            self.send_current_message()
        elif ch in (10, 13, curses.KEY_ENTER):
            if self.cfg.send_input == 'enter':
                self.send_current_message()
            else:
                self.insert_newline()
        elif ch in (curses.KEY_BACKSPACE, 127, 8): self.backspace()
        elif ch == curses.KEY_DC: self.delete_forward()
        elif ch == curses.KEY_LEFT: self.move_left()
        elif ch == curses.KEY_RIGHT: self.move_right()
        elif ch == curses.KEY_UP: self.move_up()
        elif ch == curses.KEY_DOWN: self.move_down()
        elif ch == curses.KEY_HOME: self.cursor_col = 0
        elif ch == curses.KEY_END: self.cursor_col = len(self.input_lines[self.cursor_row])
        elif ch == 21: self.clear_input()
        elif ch == 9: self.insert_text('    ')
        elif 32 <= ch <= 126: self.insert_text(chr(ch))

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def run
    # Maintainer note for run: this routine is part of the long-term public behavior of the
    # program. When changing it, check callers, documentation, config compatibility, session-log
    # compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def run(self, stdscr: curses.window) -> None:
        self.stdscr = stdscr
        curses.noecho()
        curses.cbreak()
        stdscr.keypad(True)
        try:
            stdscr.timeout(50)
        except (AttributeError, curses.error):
            pass
        try:
            curses.start_color()
            curses.use_default_colors()
        except curses.error:
            pass
        stdscr.bkgd(' ', curses.A_NORMAL)
        try:
            curses.set_escdelay(35)
        except (AttributeError, curses.error):
            pass
        try:
            curses.mousemask(curses.ALL_MOUSE_EVENTS)
        except curses.error:
            pass
        self.cfg.request_session_id = ensure_session_id(self.session_path)
        self.session_title = session_title_from_file(self.session_path)
        self.load_session_into_ui()
        try:
            self.prompt_session_title(reminder=True)
        except ScreenNavigation as navigation:
            self.dispatch_command_action(navigation.action)
        while not self.should_quit:
            self.process_request_events()
            self.draw()
            try:
                ch = stdscr.getch()
                if ch == -1:
                    continue
                self.handle_key(ch)
            except ScreenNavigation as navigation:
                self.dispatch_command_action(navigation.action)
            except KeyboardInterrupt:
                self.dispatch_command_action('quit')
            except OSError as exc:
                self.status = 'File or system error: ' + str(exc)


# ---------------------------------------------------------------------------
# Program entry point
# ---------------------------------------------------------------------------



def resolve_session_argument(cfg: Config, value: str) -> Tuple[str, Path]:
    raw = Path(os.path.expanduser(value))
    if '/' in value:
        path = raw if raw.is_absolute() else Path.cwd() / raw
        return path.stem, path
    stem = raw.stem if raw.suffix == '.log' else value
    direct = cfg.session_dir / (sanitize_session_name(stem) + '.log')
    if direct.exists():
        return direct.stem, direct
    if raw.suffix == '.log' and raw.is_file():
        return raw.stem, raw.resolve()
    matches = []
    for path in cfg.session_dir.glob('*.log'):
        if path.is_symlink() or not path.is_file():
            continue
        if session_title_from_file(path) == value:
            matches.append(path)
            continue
        try:
            pattern = r'^\[\d\d:\d\d:\d\d\] system: session-alias: ' + re.escape(stem) + r'$'
            if re.search(pattern, path.read_text(encoding='utf-8', errors='replace'), re.M):
                matches.append(path)
        except OSError:
            continue
    if len(matches) > 1:
        raise ValueError('Ambiguous session name; use the exact filename from --list.')
    path = matches[0] if matches else direct
    return path.stem, path

# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def main
# Program bootstrap. Keep this thin: parse args, prepare config/dirs, run simple non-interactive
# commands, then hand control to curses.
# ------------------------------------------------------------
def main() -> int:
    args = parse_args()
    if args.version:
        print(f"{PROGRAM} version {VERSION}")
        return 0

    cfg = load_config()
    if args.demo:
        cfg.demo_mode = True
        if not cfg.model:
            cfg.model = "demo/auto"
    if args.loopback_file:
        cfg.loopback_file = expand_path(args.loopback_file)
    if args.stream:
        cfg.stream = True
    if args.no_stream:
        cfg.stream = False
    if args.web:
        cfg.web_search = True
    if args.no_web:
        cfg.web_search = False
    if args.web_engine:
        cfg.web_search_engine = args.web_engine
    if args.web_max_results is not None:
        cfg.web_search_max_results = args.web_max_results
    if args.web_max_uses is not None:
        cfg.web_search_max_uses = args.web_max_uses
    if getattr(args, "web_mode", None):
        cfg.web_search_mode = args.web_mode
    if getattr(args, "ai_download", None):
        cfg.ai_file_download_mode = args.ai_download
    cfg.session_dir.mkdir(parents=True, exist_ok=True)
    cfg.effective_attachment_dir.mkdir(parents=True, exist_ok=True)

    if args.list:
        list_sessions(cfg.session_dir)
        return 0
    if args.rename_session:
        session_name, session_path = resolve_session_argument(cfg, args.rename_session[0])
        if not session_path.exists():
            print(f"error: session not found: {args.rename_session[0]}", file=sys.stderr)
            return 1
        try:
            session_path = rename_session_file(session_path, args.rename_session[1])
        except (OSError, ValueError) as exc:
            print('error: ' + str(exc), file=sys.stderr)
            return 1
        print('session title set: ' + session_display_title(session_path))
        print('session: ' + str(session_path.resolve()))
        return 0
    if args.turns:
        _session_name, session_path = resolve_session_argument(cfg, args.turns)
        return print_turns(session_path)
    if args.branch:
        _session_name, session_path = resolve_session_argument(cfg, args.branch[0])
        return branch_session_cli(cfg, session_path, args.branch[1])
    if args.edit_turn:
        print("--edit-turn is not implemented in ttychatter.ncurses; use ttychatter.python or the C edition for edit-and-branch.", file=sys.stderr)
        return 2
    if args.export:
        _session_name, session_path = resolve_session_argument(cfg, args.export)
        return export_session_cli(session_path, args.format, args.output)
    if args.model_type:
        cfg.model_type_filter = args.model_type
    if args.routers:
        cfg.model_type_filter = "routers"
        return print_models(cfg)
    if args.models:
        return print_models(cfg)
    if args.update_models:
        return update_models_command(cfg)
    if args.doctor:
        return print_doctor(cfg)
    if args.test_model:
        return print_model_test(cfg, args.test_model)
    chosen = args.session or args.session_name
    if args.resume and chosen:
        print("error: use either a session operand/--session or --resume, not both", file=sys.stderr)
        return 2
    if args.new and (args.resume or chosen):
        print("error: --new cannot be combined with --resume, --session, or a session operand", file=sys.stderr)
        return 2

    if args.resume:
        session_name, session_path = resolve_session_argument(cfg, args.resume)
        if not session_path.exists():
            print(f"error: session not found: {session_name}", file=sys.stderr)
            return 1
    elif chosen:
        session_name, session_path = resolve_session_argument(cfg, chosen)
    else:
        session_name = default_session_name_unique(cfg.session_dir)
        session_path = cfg.session_dir / f"{session_name}.log"

    if chosen and not session_path.exists():
        ensure_session_id(session_path)
        write_session_title_metadata(session_path, Path(chosen).stem if '/' in chosen else chosen)
    app = AICursesApp(cfg, session_name, session_path)
    try:
        curses.wrapper(app.run)
    except KeyboardInterrupt:
        return 0
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError) as exc:
        print('error: ' + str(exc), file=sys.stderr)
        raise SystemExit(1)
