.TH TTYCHATTER.BASH 1 "November 2026" "ttychatter.bash 3.19-web-limits" "User Commands"
.SH NAME
ttychatter.bash \- dependency-light OpenRouter terminal chat client
.SH SYNOPSIS
.B ttychatter.bash
.RI [ options ]
.br
.B ttychatter.bash
.RI input.txt
.br
.B ttychatter.bash
.RI input.txt
output.log
.br
.B ttychatter.bash
.BR --prompt " TEXT"
.RB [ --output
.IR FILE ]
.br
.B ttychatter.bash
.BR --input " FILE"
.RB [ --output
.IR FILE ]
.br
.B ttychatter.bash
.BR --list
.br
.B ttychatter.bash
.BR --rename-session " SESSION TITLE"
.br
.B ttychatter.bash
.BR --turns " SESSION"
.br
