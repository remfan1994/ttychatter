#!/usr/bin/env bash

# ==========================================================
# ttychatter.python
# ----------------------------------------------------------
# Bash + Python 3 helper terminal OpenRouter AI interface.
#
# VERSION
#   3.19-web-limits
#
# DESIGN ROLE
#   This Bash edition is the lightweight, line-oriented version of
#   ttychatter. It stays scriptable and readable while keeping
#   capability parity with the ncurses edition where the feature makes sense
#   in a command-line interface.
#
# NEW IN 2.6
#   - Cached OpenRouter model list support
#   - --update-models
#   - --models uses cache when available
#   - --models --all
#   - Metadata-based model filtering
#   - Config-style option commands: --config, --set, --unset
#   - --forget-api-key
#   - --rename-session OLD NEW
#   - --show-memory / --edit-memory / --clear-memory
#   - --editor-prompt
#   - --attach FILE for prompt attachments
#   - Direct --models filter/sort flags
#   - OpenRouter help links in built-in help
#   - --credits
#
# OPTIONS PARITY NOTE
#   The ncurses version has a w3m-style options form. Bash cannot sensibly
#   provide that UI, so it exposes equivalent line-oriented commands:
#       --config
#       --set KEY VALUE
#       --unset KEY
#
# MODEL METADATA NOTE
#   OpenRouter model listings can change. This script uses models catalog metadata such as
#   supported_parameters, context_length, and max_completion_tokens to help
#   users choose models without guessing future model names.
#
# INPUT MODEL
#   Interactive chat keeps the Ctrl+D send workflow. Type/paste input, then
#   press Ctrl+D to submit it.
#
# RUNTIME COMMAND MODE
#   If an input begins with a colon, such as :help or :rename notes, the
#   client treats it as a local command instead of sending it to OpenRouter.
#   This gives the Bash interface an IRC/ex-style command mode so users can
#   manage sessions, models, memory, attachments, config, and editor workflow
#   without quitting the running chat.
# ==========================================================


# ==========================================================
# MAINTAINER COMMENTARY: WHY THIS FILE EXISTS
# ----------------------------------------------------------
# This is the Bash interface that intentionally uses Python 3 helper snippets.
# It is not the same thing as the bash-only edition.  The point of this edition
# is practical reliability: Bash orchestrates the workflow, while Python 3 does
# the parts that shell is historically bad at, especially JSON generation,
# JSON parsing, URL/path handling, attachment extraction, and log/context
# parsing.  This keeps the interface scriptable and terminal-native without
# forcing maintainers to maintain unsafe sed/awk JSON hacks for every edge case.
#
# Future maintainers should view this file as the "full shell client" track.
# It should stay line-oriented and avoid ncurses-style UI ambitions, but it may
# still provide serious capabilities: sessions, model cache/filtering, context
# memory, attachment extraction, model testing, and config management.
#
# Whenever a feature is added here, ask three questions:
#   1. Does it still make sense as a command-line action rather than a screen?
#   2. Does the bash-only edition need a reduced-dependency equivalent?
#   3. Does the ncurses implementation need equivalent behavior in its UI?
#
# This commentary is intentionally long because the project is intended to be
# forked, repaired, and carried forward by people who were not present for the
# original design conversations.
# ==========================================================
set -o pipefail
umask 077

PROGRAM="ttychatter.python"
VERSION="3.19-web-limits"

XDG_CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}"
CONFIG_DIR="$XDG_CONFIG_ROOT/ttychatter/openrouter"
CONFIG_FILE="$CONFIG_DIR/config"
LEGACY_CONFIG_FILE="$XDG_CONFIG_ROOT/ttychatter/config"
CONFIG_READ_FILE="$CONFIG_FILE"
[ ! -f "$CONFIG_READ_FILE" ] && [ -f "$LEGACY_CONFIG_FILE" ] && CONFIG_READ_FILE="$LEGACY_CONFIG_FILE"
MODEL_CACHE_FILE="$XDG_CACHE_ROOT/ttychatter/openrouter/models.json"
MODEL_CACHE_FILE_CONFIGURED=0
LEGACY_MODEL_CACHE_FILE="$CONFIG_DIR/models-cache.json"
API_KEY_GPG_FILE="$CONFIG_DIR/api-key.gpg"
LEGACY_API_KEY_GPG_FILE="$XDG_CONFIG_ROOT/ttychatter/api-key.gpg"

SESSION_DIR="$XDG_DATA_ROOT/ttychatter/openrouter/sessions"
DEFAULT_ATTACHMENT_DIR="$XDG_DATA_ROOT/ttychatter/openrouter/attachments"
ATTACHMENT_DIR=""
ATTACHMENT_DIR_CONFIGURED=0

FALLBACK_MODEL="openrouter/auto"
MODEL=""
CONTEXT_TURNS=12
CONTEXT_TURNS_EXPLICIT=0
MODEL_TEST_PROMPT="Please reply with a short sentence confirming this model is available for text generation."
DEMO_MODE=0
STARTUP_NOTICE=1
PROJECT_LEAD_NAME="remfan1994"
PROJECT_LEAD_NOTICE="Everyone is encouraged to get the cruelty-free vegetarian alternatives and remember the bloodguilt curse from the Bible... http://bloodguiltcurse.net"
PRECHAT_LINE="$PROJECT_LEAD_NOTICE"
TC_PRECHAT_LINE="$PROJECT_LEAD_NOTICE"

MODEL_FILTER_GENERATE_CONTENT=1
MODEL_FILTER_REQUIRE_TOKENS=0
MODEL_FILTER_HIDE_PREVIEW=0
MODEL_MIN_INPUT_TOKENS=0
MODEL_MIN_OUTPUT_TOKENS=0
MODEL_SORT_ORDER="name"
MODEL_TYPE_FILTER="all"
MODEL_FAVORITES_FILE="$CONFIG_DIR/model-favorites"
LEGACY_MODEL_FAVORITES_FILE="$CONFIG_DIR/model-favorites.txt"
THEME="default"
SEND_INPUT="ctrl_d"
CODE_ATTACHMENT_MIN_LINES=5
STREAM=0
STATUS_UPDATES=0
SESSION_AUTO_TITLE=0
SESSION_TITLE_MODEL="openrouter/auto"
SESSION_TITLE_MAX_WORDS=8
VOICE_INPUT_CMD=""
VOICE_OUTPUT_CMD=""
VOICE_OUTPUT=0
AI_FILE_DOWNLOAD_MODE="ask"
WEB_SEARCH=0
WEB_SEARCH_ENGINE="auto"
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_USES=3
PROMPT_SESSION_NAME=1
SESSION_ID=""
SESSION_FIXED_PATH=0

MAX_ATTACHMENT_BYTES=1048576
EDITOR_CMD=""

USER_NAME="$(whoami)"
CONTEXT_BUFFER=()
SUMMARY=""
ATTACH_FILES=()

OPENROUTER_API_KEY="${OPENROUTER_API_KEY:-${TTYCHATTER_API_KEY:-}}"

ACTION="chat"
SAVE=0
SHOW_ALL_MODELS=0
SESSION_NAME=""
RESUME=0
TEST_MODEL=""
SEARCH_QUERY=""
SEARCH_ALL=0
FAVORITE_MODEL_ARG=""
UNFAVORITE_MODEL_ARG=""
SET_KEY=""
SET_VALUE=""
UNSET_KEY=""
RENAME_OLD=""
RENAME_NEW=""
MEMORY_SESSION=""
EDITOR_PROMPT=0
RUNTIME_SEND_OVERRIDE=""
LOOPBACK=0
LOOPBACK_FILE=""
OUTPUT_PATH=""
PROMPT_TEXT=""
INPUT_FILE=""
FORCE_INTERACTIVE=0
NEW_SESSION=0
POSITIONAL_ARGS=()
EXPORT_SESSION=""
EXPORT_FORMAT="markdown"
BRANCH_SESSION=""
BRANCH_TURN=""
EDIT_SESSION=""
EDIT_TURN=""
TURNS_SESSION=""
VOICE_INPUT_PATH=""
SPEAK_SET=0
SPEAK=0
STREAM=0
STATUS_UPDATES=0
SESSION_AUTO_TITLE=0
SESSION_TITLE_MODEL="openrouter/auto"
SESSION_TITLE_MAX_WORDS=8
VOICE_INPUT_CMD=""
VOICE_OUTPUT_CMD=""
TTS_CMD=""
VOICE_OUTPUT=0
PROMPT_TEXT=""
INPUT_FILE=""
OUTPUT_PATH=""
INTERACTIVE=0
NEW_SESSION=0
EXPORT_SESSION=""
EXPORT_FORMAT="markdown"
TURN_SESSION=""
BRANCH_SESSION=""
BRANCH_TURN=""
EDIT_SESSION=""
EDIT_TURN=""
TRANSCRIBE_ONLY=0

# ==========================================================
# SMALL UTILITY FUNCTIONS
# ==========================================================

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function timestamp
# Central timestamp helper used in prompts, logs, and visible status output.
# Keep the format stable because log parsers depend on it.
# ----------------------------------------------------------
timestamp() { date +"%H:%M:%S"; }

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function trim
# Whitespace normalizer for config parsing. The config format is simple on
# purpose so all project editions can share it.
# ----------------------------------------------------------
trim() { printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'; }

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function expand_path
# Uses Python 3 because path expansion needs to be predictable across
# shells. This is one of the places where the python3 edition deliberately
# buys reliability.
# ----------------------------------------------------------
expand_path() {
  python3 -c 'import os, sys; print(os.path.abspath(os.path.expandvars(os.path.expanduser(sys.argv[1]))))' "$1"
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function normalize_model_id
# Allows both models/name and name forms. Provider APIs may return names with a
# models/ prefix while users often configure the shorter form.
# ----------------------------------------------------------
normalize_model_id() {
  case "$1" in
    models/*) printf '%s\n' "${1#models/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function quote_url_component
# quote_url_component is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
quote_url_component() {
  python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function api_key_query
# api_key_query is a named maintenance unit. Keep behavior stable, check
# call sites before changing it, and update man pages/help/comments when
# behavior changes.
# ----------------------------------------------------------
api_key_query() {
  python3 -c 'import sys, urllib.parse; print(urllib.parse.urlencode({"key": sys.argv[1]}))' "$OPENROUTER_API_KEY"
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function models_query
# models_query is a named maintenance unit. Keep behavior stable, check call
# sites before changing it, and update man pages/help/comments when behavior
# changes.
# ----------------------------------------------------------
models_query() {
  python3 -c 'import sys, urllib.parse; print(urllib.parse.urlencode({"key": sys.argv[1], "pageSize": "100"}))' "$OPENROUTER_API_KEY"
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function effective_model
# effective_model is a named maintenance unit. Keep behavior stable, check
# call sites before changing it, and update man pages/help/comments when
# behavior changes.
# ----------------------------------------------------------
effective_model() {
  if [ -n "$MODEL" ]; then normalize_model_id "$MODEL"; else printf '%s\n' "$FALLBACK_MODEL"; fi
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function model_label
# model_label is a named maintenance unit. Keep behavior stable, check call
# sites before changing it, and update man pages/help/comments when behavior
# changes.
# ----------------------------------------------------------
model_label() {
  if [ -n "$MODEL" ]; then
    printf '%s\n' "$(normalize_model_id "$MODEL")"
  else
    printf '%s (fallback; no MODEL configured)\n' "$FALLBACK_MODEL"
  fi
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function sanitize_session_name
# sanitize_session_name is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
sanitize_session_name() {
  python3 -c '
import re, sys
name = sys.argv[1].strip()
name = re.sub(r"[^A-Za-z0-9._-]+", "_", name).strip("._-")
print(name or "session")
' "$1"
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function positive_int_or_default
# positive_int_or_default is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
positive_int_or_default() {
  local value="$1" fallback="$2"
  case "$value" in
    ""|*[!0-9]*) printf '%s\n' "$fallback" ;;
    *) if [ "$value" -lt 0 ]; then printf '%s\n' "$fallback"; else printf '%s\n' "$value"; fi ;;
  esac
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function truthy
# truthy is a named maintenance unit. Keep behavior stable, check call sites
# before changing it, and update man pages/help/comments when behavior
# changes.
# ----------------------------------------------------------
truthy() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    1|yes|y|true|on) return 0 ;;
    *) return 1 ;;
  esac
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function clear_screen
# clear_screen is a named maintenance unit. Keep behavior stable, check call
# sites before changing it, and update man pages/help/comments when behavior
# changes.
# ----------------------------------------------------------
clear_screen() { if [ -t 1 ]; then printf '\033[H\033[J'; fi; }

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function editor_command
# editor_command is a named maintenance unit. Keep behavior stable, check
# call sites before changing it, and update man pages/help/comments when
# behavior changes.
# ----------------------------------------------------------
editor_command() {
  if [ -n "$EDITOR_CMD" ]; then printf '%s\n' "$EDITOR_CMD"
  elif [ -n "${VISUAL:-}" ]; then printf '%s\n' "$VISUAL"
  elif [ -n "${EDITOR:-}" ]; then printf '%s\n' "$EDITOR"
  elif command -v nano >/dev/null 2>&1; then printf '%s\n' "nano"
  else printf '%s\n' "vi"; fi
}

# ==========================================================
# GPG API KEY SUPPORT
# ----------------------------------------------------------
# GPG support is optional. It is implemented by shelling out to the user's
# existing gpg command instead of embedding cryptography in a shell script.
# This keeps keyring ownership and passphrase prompting in the user's normal
# Unix environment. The decrypted key is never printed.
# ==========================================================

decrypt_gpg_key_file() {
  local path="$1"
  [ -f "$path" ] || return 1
  command -v gpg >/dev/null 2>&1 || return 1
  gpg --quiet --decrypt "$path" 2>/dev/null | tr -d '\r' | sed '/^[[:space:]]*$/d' | head -n 1
}


# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function encrypt_gpg_key_file
# This helper is the Bash-family equivalent of the ncurses F3 checkbox labeled
# "encrypt with gpg". It is intentionally not silent and not automatic. The user
# chooses encrypted storage, ttychatter writes the pasted API key into a private
# temporary file, then hands that file to the user's installed gpg command. The
# external gpg program owns encryption, passphrase prompting, pinentry behavior,
# and trust policy. ttychatter should never print, log, or echo the key.
#
# Maintaining this routine correctly matters because it is security-sensitive:
#   * if gpg is missing, say so and do not fall back to plaintext;
#   * delete the temporary plaintext file on every path;
#   * chmod the resulting ciphertext where possible;
#   * keep plaintext saving as a separate warning path.
# ----------------------------------------------------------
encrypt_gpg_key_file() {
  local path="$1"
  local secret="$2"
  local tmp
  local status

  if ! command -v gpg >/dev/null 2>&1; then
    printf '%s\n' "gpg not found; encrypted API-key storage unavailable" >&2
    return 1
  fi

  mkdir -p "$(dirname "$path")"
  tmp="$(mktemp "${TMPDIR:-/tmp}/ttychatter-api-key.XXXXXX")" || return 1
  chmod 600 "$tmp" 2>/dev/null || true
  printf '%s\n' "$secret" > "$tmp"

  if gpg --symmetric --armor --yes --output "$path" "$tmp"; then
    status=0
    chmod 600 "$path" 2>/dev/null || true
  else
    status=$?
  fi

  rm -f "$tmp"
  if [ "$status" -eq 0 ]; then
    printf 'encrypted API key saved to %s\n' "$path"
    return 0
  fi

  printf '%s\n' "gpg encryption failed; API key was not saved encrypted" >&2
  return "$status"
}

# ==========================================================
# CONFIG FILE SUPPORT
# ==========================================================

if [ -f "$CONFIG_READ_FILE" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line="$(trim "$line")"
    case "$line" in ""|\#*) continue ;; esac
    case "$line" in *=*) key="$(trim "${line%%=*}")"; value="$(trim "${line#*=}")" ;; *) continue ;; esac

    case "$key" in
      MODEL) MODEL="$(normalize_model_id "$value")" ;;
      CONTEXT_TURNS) CONTEXT_TURNS="$value"; CONTEXT_TURNS_EXPLICIT=1 ;;
      HISTORY_LIMIT) if [ "$CONTEXT_TURNS_EXPLICIT" -eq 0 ]; then CONTEXT_TURNS="$value"; fi ;;
      OPENROUTER_API_KEY|API_KEY) OPENROUTER_API_KEY="${OPENROUTER_API_KEY:-$value}" ;;
      API_KEY_GPG_FILE|OPENROUTER_API_KEY_GPG_FILE) API_KEY_GPG_FILE="$value" ;;
      SESSION_DIR) SESSION_DIR="$(expand_path "$value")" ;;
      ATTACHMENT_DIR) ATTACHMENT_DIR="$(expand_path "$value")"; ATTACHMENT_DIR_CONFIGURED=1 ;;
      AI_FILE_DOWNLOAD_MODE|AI_DOWNLOAD) AI_FILE_DOWNLOAD_MODE="$value" ;;
      WEB_SEARCH) WEB_SEARCH="$value" ;;
    WEB_SEARCH_ENGINE) WEB_SEARCH_ENGINE="$value" ;;
    WEB_SEARCH_MAX_RESULTS) WEB_SEARCH_MAX_RESULTS="$value" ;;
    WEB_SEARCH_MAX_USES) WEB_SEARCH_MAX_USES="$value" ;;
    PROMPT_SESSION_NAME) PROMPT_SESSION_NAME="$value" ;;
    MODEL_TEST_PROMPT) [ -n "$value" ] && MODEL_TEST_PROMPT="$value" ;;
      DEMO_MODE) DEMO_MODE="$value" ;;
      STARTUP_NOTICE) STARTUP_NOTICE="$value" ;;
      STREAM) STREAM="$value" ;;
      STATUS_UPDATES|PROGRESS_UPDATES) STATUS_UPDATES="$value" ;;
      SESSION_AUTO_TITLE) SESSION_AUTO_TITLE="$value" ;;
      SESSION_TITLE_MODEL) [ -n "$value" ] && SESSION_TITLE_MODEL="$value" ;;
      SESSION_TITLE_MAX_WORDS) SESSION_TITLE_MAX_WORDS="$value" ;;
      VOICE_INPUT_CMD) VOICE_INPUT_CMD="$value" ;;
      VOICE_OUTPUT_CMD|TTS_CMD) VOICE_OUTPUT_CMD="$value"; TTS_CMD="$value" ;;
      VOICE_OUTPUT) VOICE_OUTPUT="$value" ;;
      MODEL_FILTER_GENERATE_CONTENT) MODEL_FILTER_GENERATE_CONTENT="$value" ;;
      MODEL_FILTER_REQUIRE_TOKENS) MODEL_FILTER_REQUIRE_TOKENS="$value" ;;
      MODEL_FILTER_HIDE_PREVIEW) MODEL_FILTER_HIDE_PREVIEW="$value" ;;
      MODEL_MIN_INPUT_TOKENS) MODEL_MIN_INPUT_TOKENS="$value" ;;
      MODEL_MIN_OUTPUT_TOKENS) MODEL_MIN_OUTPUT_TOKENS="$value" ;;
      MODEL_SORT_ORDER) MODEL_SORT_ORDER="$value" ;;
      MODEL_TYPE_FILTER) MODEL_TYPE_FILTER="$value" ;;
      MODEL_CACHE_FILE) MODEL_CACHE_FILE="$(expand_path "$value")"; MODEL_CACHE_FILE_CONFIGURED=1 ;;
      MODEL_FAVORITES_FILE) MODEL_FAVORITES_FILE="$(expand_path "$value")" ;;
      THEME) THEME="$value" ;;
      SEND_INPUT) SEND_INPUT="$value" ;;
      CODE_ATTACHMENT_MIN_LINES) CODE_ATTACHMENT_MIN_LINES="$value" ;;
      STREAM) STREAM="$value" ;;
      STATUS_UPDATES|PROGRESS_UPDATES) STATUS_UPDATES="$value" ;;
      SESSION_AUTO_TITLE) SESSION_AUTO_TITLE="$value" ;;
      SESSION_TITLE_MODEL) SESSION_TITLE_MODEL="$(normalize_model_id "$value")" ;;
      SESSION_TITLE_MAX_WORDS) SESSION_TITLE_MAX_WORDS="$value" ;;
      VOICE_INPUT_CMD) VOICE_INPUT_CMD="$value" ;;
      VOICE_OUTPUT_CMD|TTS_CMD) VOICE_OUTPUT_CMD="$value" ;;
      VOICE_OUTPUT) VOICE_OUTPUT="$value" ;;
      MAX_ATTACHMENT_BYTES) MAX_ATTACHMENT_BYTES="$value" ;;
      EDITOR) EDITOR_CMD="$value" ;;
    esac
  done < "$CONFIG_READ_FILE"
fi

CONTEXT_TURNS="$(positive_int_or_default "$CONTEXT_TURNS" 12)"
MODEL_MIN_INPUT_TOKENS="$(positive_int_or_default "$MODEL_MIN_INPUT_TOKENS" 0)"
MODEL_MIN_OUTPUT_TOKENS="$(positive_int_or_default "$MODEL_MIN_OUTPUT_TOKENS" 0)"
MAX_ATTACHMENT_BYTES="$(positive_int_or_default "$MAX_ATTACHMENT_BYTES" 1048576)"
CODE_ATTACHMENT_MIN_LINES="$(positive_int_or_default "$CODE_ATTACHMENT_MIN_LINES" 5)"
SESSION_TITLE_MAX_WORDS="$(positive_int_or_default "$SESSION_TITLE_MAX_WORDS" 8)"
SESSION_TITLE_MAX_WORDS="$(positive_int_or_default "$SESSION_TITLE_MAX_WORDS" 8)"

if [ -z "$OPENROUTER_API_KEY" ]; then
  OPENROUTER_API_KEY="$(decrypt_gpg_key_file "$API_KEY_GPG_FILE" || true)"
fi
if [ -z "$OPENROUTER_API_KEY" ] && [ -f "$LEGACY_API_KEY_GPG_FILE" ]; then
  OPENROUTER_API_KEY="$(decrypt_gpg_key_file "$LEGACY_API_KEY_GPG_FILE" || true)"
fi

if [ "$ATTACHMENT_DIR_CONFIGURED" -eq 0 ]; then ATTACHMENT_DIR="$DEFAULT_ATTACHMENT_DIR"; fi

mkdir -p "$CONFIG_DIR" "$SESSION_DIR" "$ATTACHMENT_DIR" "$(dirname "$MODEL_CACHE_FILE")"
if [ ! -e "$MODEL_FAVORITES_FILE" ] && [ -f "$LEGACY_MODEL_FAVORITES_FILE" ]; then
  cp "$LEGACY_MODEL_FAVORITES_FILE" "$MODEL_FAVORITES_FILE" 2>/dev/null || true
fi

# ==========================================================
# CONFIG WRITING / OPTIONS PARITY
# ==========================================================

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function set_config_value
# Writes one config key without destroying unrelated settings. Never use
# this implicitly for secrets; saving should follow explicit user action.
# ----------------------------------------------------------
set_config_value() {
  local key="$1" value="$2" tmp
  mkdir -p "$CONFIG_DIR"
  tmp="$(mktemp "${CONFIG_FILE}.tmp.XXXXXX")"
  if [ -f "$CONFIG_FILE" ]; then
    awk -v k="$key" -v v="$value" 'BEGIN{done=0} $0 ~ "^" k "=" {print k "=" v; done=1; next} {print} END{if(!done) print k "=" v}' "$CONFIG_FILE" > "$tmp"
  else
    printf '%s=%s\n' "$key" "$value" > "$tmp"
  fi
  mv "$tmp" "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE" 2>/dev/null || true
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function remove_config_key
# remove_config_key is a named maintenance unit. Keep behavior stable, check
# call sites before changing it, and update man pages/help/comments when
# behavior changes.
# ----------------------------------------------------------
remove_config_key() {
  local key="$1" tmp
  [ -f "$CONFIG_FILE" ] || return 0
  tmp="$(mktemp "${CONFIG_FILE}.tmp.XXXXXX")"
  awk -v k="$key" '$0 !~ "^" k "=" { print }' "$CONFIG_FILE" > "$tmp"
  mv "$tmp" "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE" 2>/dev/null || true
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function print_config_summary
# Line-oriented equivalent of the ncurses options screen. Bash users get
# readable configuration state without a full-screen form.
# ----------------------------------------------------------
print_config_summary() {
  cat <<EOF
$PROGRAM configuration summary

Config file:
  $CONFIG_FILE

Core:
  MODEL=$(model_label)
  CONTEXT_TURNS=$CONTEXT_TURNS
  SESSION_DIR=$SESSION_DIR
  ATTACHMENT_DIR=$ATTACHMENT_DIR
  MODEL_TEST_PROMPT=$MODEL_TEST_PROMPT
  STARTUP_NOTICE=$STARTUP_NOTICE
  WEB_SEARCH=$WEB_SEARCH
  WEB_SEARCH_ENGINE=$WEB_SEARCH_ENGINE
  WEB_SEARCH_MAX_RESULTS=$WEB_SEARCH_MAX_RESULTS
  WEB_SEARCH_MAX_USES=$WEB_SEARCH_MAX_USES
  PROMPT_SESSION_NAME=$PROMPT_SESSION_NAME
  STREAM=$STREAM
  STATUS_UPDATES=$STATUS_UPDATES
  SESSION_AUTO_TITLE=$SESSION_AUTO_TITLE
  SESSION_TITLE_MODEL=$SESSION_TITLE_MODEL
  SESSION_TITLE_MAX_WORDS=$SESSION_TITLE_MAX_WORDS
  VOICE_INPUT_CMD=$VOICE_INPUT_CMD
  VOICE_OUTPUT_CMD=${VOICE_OUTPUT_CMD:-$TTS_CMD}
  VOICE_OUTPUT=$VOICE_OUTPUT
  AI_FILE_DOWNLOAD_MODE=$AI_FILE_DOWNLOAD_MODE
  EDITOR=$(editor_command)
  MAX_ATTACHMENT_BYTES=$MAX_ATTACHMENT_BYTES
  THEME=$THEME
  SEND_INPUT=$SEND_INPUT
  CODE_ATTACHMENT_MIN_LINES=$CODE_ATTACHMENT_MIN_LINES
  MODEL_FAVORITES_FILE=$MODEL_FAVORITES_FILE

Model cache:
  MODEL_CACHE_FILE=$MODEL_CACHE_FILE
  cache present: $([ -f "$MODEL_CACHE_FILE" ] && printf yes || printf no)

Model filters:
  MODEL_FILTER_GENERATE_CONTENT=$MODEL_FILTER_GENERATE_CONTENT
  MODEL_FILTER_REQUIRE_TOKENS=$MODEL_FILTER_REQUIRE_TOKENS
  MODEL_FILTER_HIDE_PREVIEW=$MODEL_FILTER_HIDE_PREVIEW
  MODEL_MIN_INPUT_TOKENS=$MODEL_MIN_INPUT_TOKENS
  MODEL_MIN_OUTPUT_TOKENS=$MODEL_MIN_OUTPUT_TOKENS
  MODEL_SORT_ORDER=$MODEL_SORT_ORDER
  MODEL_TYPE_FILTER=$MODEL_TYPE_FILTER

API key:
  environment/config loaded: $([ -n "$OPENROUTER_API_KEY" ] && printf yes || printf no)
EOF
}

# ==========================================================
# MODEL FAVORITES / BOOKMARKS
# ----------------------------------------------------------
# The ncurses model browser lets users bookmark models.  The Bash+Python
# client has no clickable table, but it should still maintain the same
# persistent list.  Favorites are stored as one model id per line so the file
# is trivial to inspect, edit, copy, or remove.  This plain-text format also
# lets forks and future provider backends reuse the list without reverse
# engineering a private data structure.
# ==========================================================

ensure_favorites_dir() { mkdir -p "$(dirname "$MODEL_FAVORITES_FILE")"; }
list_favorite_models() { [ -f "$MODEL_FAVORITES_FILE" ] && sed '/^[[:space:]]*$/d' "$MODEL_FAVORITES_FILE" || true; }
favorite_model_command() {
  local model="$(normalize_model_id "$1")"
  [ -n "$model" ] || { printf '%s\n' "ERROR: model id required." >&2; return 2; }
  ensure_favorites_dir
  touch "$MODEL_FAVORITES_FILE"
  if grep -Fxq "$model" "$MODEL_FAVORITES_FILE" 2>/dev/null; then
    printf '%s is already a favorite\n' "$model"
  else
    printf '%s\n' "$model" >> "$MODEL_FAVORITES_FILE"
    printf 'favorited model: %s\n' "$model"
  fi
}
unfavorite_model_command() {
  local model="$(normalize_model_id "$1")" tmp
  [ -n "$model" ] || { printf '%s\n' "ERROR: model id required." >&2; return 2; }
  [ -f "$MODEL_FAVORITES_FILE" ] || { printf 'favorites file not found: %s\n' "$MODEL_FAVORITES_FILE"; return 0; }
  tmp="$(mktemp "${MODEL_FAVORITES_FILE}.tmp.XXXXXX")"
  grep -Fxv "$model" "$MODEL_FAVORITES_FILE" > "$tmp" || true
  mv "$tmp" "$MODEL_FAVORITES_FILE"
  printf 'unfavorited model: %s\n' "$model"
}

# ==========================================================
# TERMINAL STYLE HELPERS
# ----------------------------------------------------------
# Bash cannot offer the rich theme system of the ncurses client, but it can
# honor the same THEME key in a conservative way.  Styling is only emitted
# when stdout is a terminal.  Loopback/pipeline output remains plain text so
# other programs do not receive ANSI escape codes by surprise.
# ==========================================================

ai_style_start() {
  [ -t 1 ] || return 0
  case "$THEME" in
    dim|default|solarized_dark) printf '\033[2m' ;;
    high_contrast) printf '\033[1m' ;;
    mono) ;;
  esac
}
ai_style_end() { [ -t 1 ] && [ "$THEME" != "mono" ] && printf '\033[0m' || true; }
print_ai_output() { ai_style_start; printf '%s\n\n' "$1"; ai_style_end; }

# ==========================================================
# API KEY MANAGEMENT
# ==========================================================

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function require_api_key
# require_api_key is a named maintenance unit. Keep behavior stable, check
# call sites before changing it, and update man pages/help/comments when
# behavior changes.
# ----------------------------------------------------------
require_api_key() {
  if truthy "$DEMO_MODE"; then
    return 0
  fi
  if [ -z "$OPENROUTER_API_KEY" ]; then
    printf '%s\n' "ERROR: OPENROUTER_API_KEY not set." >&2
    printf '%s\n' "Set it with: export OPENROUTER_API_KEY=your_key" >&2
    printf '%s\n' "or save it with: $PROGRAM --set-api-key" >&2
    return 1
  fi
  return 0
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function set_api_key_command
# set_api_key_command is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
set_api_key_command() {
  local key mode answer

  printf 'Paste OpenRouter API key: '
  IFS= read -r -s key
  printf '\n'
  [ -n "$key" ] || { printf '%s\n' "No key entered."; return 1; }

  printf '%s\n' "How should ttychatter store this API key?"
  printf '%s\n' "  1) runtime only (do not store)"
  printf '%s\n' "  2) encrypted with gpg"
  printf '%s\n' "  3) plaintext config"
  if command -v gpg >/dev/null 2>&1; then
    printf '%s\n' "gpg status: available"
  else
    printf '%s\n' "gpg status: gpg not found (encrypted storage unavailable)"
  fi
  printf 'Choice [1]: '
  IFS= read -r mode
  mode="${mode:-1}"

  case "$mode" in
    1)
      OPENROUTER_API_KEY="$key"
      printf '%s\n' "API key active for this run only."
      ;;
    2)
      if ! command -v gpg >/dev/null 2>&1; then
        OPENROUTER_API_KEY="$key"
        printf '%s\n' "gpg not found; key active for this run only."
        return 0
      fi
      printf 'Encrypt API key with gpg and save to %s? [y/N] ' "$API_KEY_GPG_FILE"
      IFS= read -r answer
      case "$answer" in y|Y|yes|YES) ;; *) OPENROUTER_API_KEY="$key"; printf '%s\n' "Cancelled; key active for this run only."; return 0 ;; esac
      if encrypt_gpg_key_file "$API_KEY_GPG_FILE" "$key"; then
        OPENROUTER_API_KEY="$key"
        set_config_value "API_KEY_GPG_FILE" "$API_KEY_GPG_FILE"
        remove_config_key "OPENROUTER_API_KEY"
        remove_config_key "API_KEY"
        printf 'encrypted API key saved to %s\n' "$API_KEY_GPG_FILE"
      else
        OPENROUTER_API_KEY="$key"
        printf '%s\n' "GPG encryption failed; key active for this run only."
      fi
      ;;
    3)
      printf '%s\n' "WARNING: key will be stored in plaintext:"
      printf '  %s\n' "$CONFIG_FILE"
      printf 'Continue? [y/N] '
      IFS= read -r answer
      case "$answer" in y|Y|yes|YES) ;; *) OPENROUTER_API_KEY="$key"; printf '%s\n' "Cancelled; key active for this run only."; return 0 ;; esac
      OPENROUTER_API_KEY="$key"
      set_config_value "OPENROUTER_API_KEY" "$key"
      printf 'saved OPENROUTER_API_KEY to %s\n' "$CONFIG_FILE"
      ;;
    *)
      OPENROUTER_API_KEY="$key"
      printf '%s\n' "Unknown choice; key active for this run only."
      ;;
  esac
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function forget_api_key_command
# forget_api_key_command is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
forget_api_key_command() {
  remove_config_key "OPENROUTER_API_KEY"
  remove_config_key "TTYCHATTER_API_KEY"
  printf 'removed plaintext API-key config entries if present\n'
}


# ==========================================================
# DIAGNOSTICS / DOCTOR
# ----------------------------------------------------------
# The Python-helper Bash edition has enough moving parts that a quick doctor
# command is useful for users and bug reporters. It checks tools, config,
# storage paths, model cache state, editor availability, API-key presence, and
# network reachability. It does not send a generation prompt to OpenRouter.
# ==========================================================

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function doctor_status
# doctor_status is a named maintenance unit. Keep behavior stable, check
# call sites before changing it, and update man pages/help/comments when
# behavior changes.
# ----------------------------------------------------------
doctor_status() { printf '[%-4s] %s: %s\n' "$1" "$2" "$3"; }

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function check_writable_dir
# check_writable_dir is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
check_writable_dir() {
  local path="$1" test_file
  mkdir -p "$path" 2>/dev/null || { printf 'not creatable: %s' "$path"; return 1; }
  test_file="$path/.ttychatter.bash-write-test-$$"
  if printf '%s' ok > "$test_file" 2>/dev/null; then rm -f "$test_file"; printf 'writable: %s' "$path"; return 0; fi
  printf 'not writable: %s' "$path"; return 1
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function doctor_command
# Diagnostic command. It should report environment state without sending
# generation prompts or leaking API keys.
# ----------------------------------------------------------
doctor_command() {
  local status detail editor_first
  printf '%s\n\n' "${PROGRAM} diagnostics"
  doctor_status OK program "$PROGRAM version $VERSION"
  doctor_status OK bash "$BASH_VERSION"
  for cmd in bash curl python3 sed awk grep tr mktemp; do
    if command -v "$cmd" >/dev/null 2>&1; then doctor_status OK "command $cmd" "$(command -v "$cmd")"; else doctor_status FAIL "command $cmd" "not found"; fi
  done
  [ -f "$CONFIG_FILE" ] && doctor_status OK "config file" "$CONFIG_FILE present" || doctor_status WARN "config file" "not found: $CONFIG_FILE"
  [ -n "$OPENROUTER_API_KEY" ] && doctor_status OK "API key" "loaded from env/config/gpg" || doctor_status WARN "API key" "not loaded"
  command -v gpg >/dev/null 2>&1 && doctor_status OK gpg "$(command -v gpg)" || doctor_status WARN gpg "not found; encrypted key unavailable"
  [ -f "$API_KEY_GPG_FILE" ] && doctor_status OK "api-key.gpg" "$API_KEY_GPG_FILE present" || doctor_status WARN "api-key.gpg" "not found: $API_KEY_GPG_FILE"
  detail="$(check_writable_dir "$SESSION_DIR")"; status=$?; doctor_status $([ "$status" -eq 0 ] && printf OK || printf FAIL) "session dir" "$detail"
  detail="$(check_writable_dir "$ATTACHMENT_DIR")"; status=$?; doctor_status $([ "$status" -eq 0 ] && printf OK || printf FAIL) "attachment dir" "$detail"
  detail="$(check_writable_dir "$(dirname "$MODEL_CACHE_FILE")")"; status=$?; doctor_status $([ "$status" -eq 0 ] && printf OK || printf FAIL) "model cache dir" "$detail"
  [ -f "$MODEL_CACHE_FILE" ] && doctor_status OK "model cache" "$MODEL_CACHE_FILE present" || doctor_status WARN "model cache" "missing; run --update-models"
  editor_first="${EDITOR_CMD:-${VISUAL:-${EDITOR:-vi}}}"; editor_first="${editor_first%% *}"
  command -v "$editor_first" >/dev/null 2>&1 && doctor_status OK editor "$(command -v "$editor_first")" || doctor_status WARN editor "$editor_first not found"
  python3 - <<'PYDOC' 2>/dev/null
import socket
host='openrouter.ai'
try:
    infos=socket.getaddrinfo(host,443,type=socket.SOCK_STREAM)
    addrs=sorted({i[4][0] for i in infos})[:3]
    print('[OK  ] DNS: %s resolves to %s' % (host, ', '.join(addrs)))
except Exception as exc:
    print('[WARN] DNS: lookup failed for %s: %s' % (host, exc))
PYDOC
  if [ -n "$OPENROUTER_API_KEY" ]; then
    curl -sS --max-time 20 "https://openrouter.ai/v1beta/models?$(models_query)" >/dev/null 2>&1 && doctor_status OK "models endpoint" reachable || doctor_status WARN "models endpoint" "not reachable or API key invalid"
  else
    doctor_status WARN "models endpoint" "skipped: no API key"
  fi
}

